{% doc %}
  Rhode peptide-lip-tint shade controls. The live Isoua product currently has
  one Shopify variant (Pretzel), so missing shades are rendered faithfully but
  disabled. When matching variants are later added in Admin, their controls
  enable automatically by matching the variant title handle.

  @param {product} product - Current product.
  @param {string} mode - hero, sticky, mobile, or sheet.
{% enddoc %}

{%- liquid
  assign shade_data = 'sweet pea|sweetpea-circle_1_300x.png?v=1772556926|pearly warm pink~jelly bean|jelly-bean_1_300x.png?v=1755973352|shimmery sheer pink~ribbon|rib_1_300x.png?v=1695241157|sheer pink~pretzel|pretzel-circle_1_300x.png?v=1772556898|shimmery warm mauve~toast|taos_1_300x.png?v=1695241157|rose taupe~salty tan|swatch-saltytan_300x.png?v=1718226273|soft mauve~raspberry jelly|Rasp_1_300x.png?v=1695241157|crushed berry~pbj|PBJ-swatch_ac37044f-53db-4eef-8e12-607f00b4dc0c_300x.png?v=1741894187|warm berry brown~espresso|swatch-Espresso_1_300x.png?v=1695241157|rich brown' | split: '~'
  assign fallback_variant = product.selected_or_first_available_variant
-%}

<div class="rh-lip-shades__renderer rh-lip-shades__renderer--{{ mode }}">
  {%- if mode == 'sheet' -%}
    <div class="rh-lip-shades__sheet-group">
      <p class="rh-lip-shades__sheet-heading">Limited Edition</p>
      {%- assign limited_shade = shade_data.first | split: '|' -%}
      <button type="button" class="rh-lip-shade-option" data-lip-shade-option aria-disabled="true" disabled>
        <span class="rh-lip-shade-option__dot" style="--shade-image: url('https://www.rhodeskin.com/cdn/shop/files/{{ limited_shade[1] }}')"></span>
        <span><strong>{{ limited_shade[0] }}</strong> - {{ limited_shade[2] }}</span>
      </button>
    </div>
    <div class="rh-lip-shades__sheet-group">
      <p class="rh-lip-shades__sheet-heading">Core Shades</p>
      {%- for shade_record in shade_data offset: 1 -%}
        {%- assign shade = shade_record | split: '|' -%}
        {%- assign shade_name = shade[0] -%}
        {%- assign shade_handle = shade_name | handleize -%}
        {%- assign matching_variant = blank -%}
        {%- for variant in product.variants -%}
          {%- assign variant_handle = variant.title | handleize -%}
          {%- if variant_handle == shade_handle -%}{%- assign matching_variant = variant -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {%- if product.has_only_default_variant and shade_handle == 'pretzel' -%}{%- assign matching_variant = fallback_variant -%}{%- endif -%}
        <button type="button" class="rh-lip-shade-option{% if shade_handle == 'pretzel' %} is-selected{% endif %}" data-lip-shade-option
          data-shade-name="{{ shade_name | escape }}" data-shade-description="{{ shade[2] | escape }}"
          {% if matching_variant != blank %}data-lip-shade data-variant-id="{{ matching_variant.id }}" data-price="{{ matching_variant.price | money_without_trailing_zeros | escape }}"{% else %}aria-disabled="true" disabled{% endif %}>
          <span class="rh-lip-shade-option__dot" style="--shade-image: url('https://www.rhodeskin.com/cdn/shop/files/{{ shade[1] }}')"></span>
          <span><strong>{{ shade_name }}</strong> - {{ shade[2] }}</span>
        </button>
      {%- endfor -%}
    </div>
  {%- else -%}
  {%- if mode == 'hero' -%}
    <div class="rh-lip-shades__limited" aria-label="Limited edition shades">
      {%- assign limited_shade = shade_data.first | split: '|' -%}
      <button
        class="rh-lip-swatch"
        type="button"
        aria-label="Sweet pea — preview only"
        aria-disabled="true"
        disabled
        style="--shade-image: url('https://www.rhodeskin.com/cdn/shop/files/{{ limited_shade[1] }}')"
      ></button>
      <span>Limited Edition</span>
    </div>
    <p class="rh-lip-shades__group-label">Core Shades</p>
  {%- endif -%}

  <div class="{% if mode == 'hero' %}rh-lip-shades__core{% elsif mode == 'sticky' %}rh-lip-shades__sticky-list{% else %}rh-lip-shades__mobile-select{% endif %}"{% if mode == 'hero' %} aria-label="Core shades"{% elsif mode == 'sticky' %} aria-label="Lip tint shades"{% endif %}>
    {%- if mode == 'mobile' -%}
      <button type="button" class="rh-lip-shades__mobile-select" data-lip-shade-trigger aria-haspopup="dialog" aria-expanded="false">
      <span
        class="rh-lip-shades__mobile-dot"
        aria-hidden="true"
        style="--shade-image: url('https://www.rhodeskin.com/cdn/shop/files/pretzel-circle_1_300x.png?v=1772556898')"
      ></span>
      <span class="rh-lip-shades__mobile-label">pretzel</span>
      <svg class="rh-lip-shades__chevron" viewBox="0 0 10 6" aria-hidden="true">
        <path d="M4.29296 5.292 0.707479 1.70717C0.0774266 1.07723.523574 0 1.41452 0h7.17096c.89095 0 1.33709 1.07723.70704 1.70717L5.70704 5.292a1 1 0 0 1-1.41408 0Z" fill="currentColor"/>
      </svg>
      </button>
    {%- endif -%}

    {%- for shade_record in shade_data -%}
      {%- assign shade = shade_record | split: '|' -%}
      {%- assign shade_name = shade[0] -%}
      {%- assign shade_handle = shade_name | handleize -%}
      {%- assign matching_variant = blank -%}
      {%- for variant in product.variants -%}
        {%- assign variant_handle = variant.title | handleize -%}
        {%- if variant_handle == shade_handle -%}
          {%- assign matching_variant = variant -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if product.has_only_default_variant and shade_handle == 'pretzel' -%}
        {%- assign matching_variant = fallback_variant -%}
      {%- endif -%}

      {%- if mode == 'sticky' or forloop.first == false -%}
        <button
          class="rh-lip-swatch{% if shade_handle == 'pretzel' %} is-selected{% endif %}"
          type="button"
          title="{{ shade_name | escape }}{% if matching_variant == blank %} — preview only{% endif %}"
          aria-label="{{ shade_name | escape }}{% if matching_variant == blank %} — preview only{% endif %}"
          aria-pressed="{% if shade_handle == 'pretzel' %}true{% else %}false{% endif %}"
          {% if matching_variant == blank %}aria-disabled="true" disabled{% endif %}
          {% if matching_variant != blank %}data-lip-shade data-variant-id="{{ matching_variant.id }}"{% endif %}
          data-shade-name="{{ shade_name | escape }}"
          data-shade-description="{{ shade[2] | escape }}"
          {% if matching_variant != blank %}data-price="{{ matching_variant.price | money_without_trailing_zeros | escape }}"{% endif %}
          style="--shade-image: url('https://www.rhodeskin.com/cdn/shop/files/{{ shade[1] }}')"
        ></button>
      {%- endif -%}
    {%- endfor -%}

  </div>
  {%- endif -%}
</div>
