{%- liquid
  assign primary_media = product.featured_media
  assign secondary_media = product.media[1]
  assign hover_meta = product.metafields.custom.hover_image
  if hover_meta and hover_meta.value
    assign secondary_media = hover_meta.value
  endif
  if secondary_media == blank
    assign secondary_media = primary_media
  endif

  assign category_label = product.metafields.custom.card_category
  if category_label == blank
    assign category_label = product.type
  endif
  if category_label == blank
    assign category_label = product.vendor
  endif

  assign is_new = true

  assign price_short = product.price | money_without_trailing_zeros
  assign price_formatted = product.price | money
  assign title_up = product.title | upcase

  assign review_count_meta = product.metafields.custom.review_count
  assign review_count = 127
  if review_count_meta and review_count_meta.value
    assign review_count = review_count_meta.value | plus: 0
  endif
  assign review_stars_meta = product.metafields.custom.review_stars
  assign review_stars = 4.5
  if review_stars_meta and review_stars_meta.value
    assign review_stars = review_stars_meta.value | times: 1.0
  endif
-%}

<article class="isoa-rc-card" data-handle="{{ product.handle }}">
  <a class="isoa-rc-link" href="{{ product.url }}" aria-label="{{ product.title | escape }} {{ price_formatted | strip_html }}">
    <div class="isoa-rc-frame">
      {%- if primary_media -%}
        <img
          class="isoa-rc-img isoa-rc-img--primary"
          src="{{ primary_media | image_url: width: 800 }}"
          srcset="{{ primary_media | image_url: width: 400 }} 400w, {{ primary_media | image_url: width: 800 }} 800w, {{ primary_media | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 749px) 50vw, 33vw"
          loading="lazy"
          decoding="async"
          alt="{{ primary_media.alt | default: product.title | escape }}">
      {%- endif -%}

      {%- if secondary_media and secondary_media != primary_media -%}
        <img
          class="isoa-rc-img isoa-rc-img--secondary"
          src="{{ secondary_media | image_url: width: 800 }}"
          srcset="{{ secondary_media | image_url: width: 400 }} 400w, {{ secondary_media | image_url: width: 800 }} 800w, {{ secondary_media | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 749px) 50vw, 33vw"
          loading="lazy"
          decoding="async"
          alt="{{ secondary_media.alt | default: product.title | escape }}">
      {%- endif -%}

      {%- if category_label != blank -%}
        <span class="isoa-rc-brand">{{ category_label | downcase }}</span>
      {%- endif -%}

      {%- if is_new -%}
        <span class="isoa-rc-badge">new</span>
      {%- endif -%}
    </div>

    <div class="isoa-rc-info">
      <div class="isoa-rc-reviews" aria-label="{{ review_stars }} stars from {{ review_count }} reviews">
        <span class="isoa-rc-stars" aria-hidden="true">
          {%- assign full = review_stars | floor -%}
          {%- assign has_half = false -%}
          {%- assign fractional = review_stars | minus: full -%}
          {%- if fractional >= 0.25 and fractional < 0.75 -%}{%- assign has_half = true -%}{%- endif -%}
          {%- if fractional >= 0.75 -%}{%- assign full = full | plus: 1 -%}{%- endif -%}
          {%- for i in (1..5) -%}
            {%- if forloop.index0 < full -%}★{%- elsif has_half and forloop.index0 == full -%}⯪{%- else -%}☆{%- endif -%}
          {%- endfor -%}
        </span>
        <span class="isoa-rc-review-count">({{ review_count }})</span>
      </div>
      <p class="isoa-rc-title">{{ title_up }}</p>
      <p class="isoa-rc-price">{{ price_formatted }}</p>
    </div>

    <div class="isoa-rc-cta" aria-hidden="true">BUY — <strong>{{ price_short }}</strong></div>
  </a>
</article>
