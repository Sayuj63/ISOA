{%- comment -%}
  Six line icons on one grid: 80-unit box, 36-radius ring, every glyph drawn
  inside the central 30 units, scaled 1.3x with the stroke compensated so it
  matches the ring's 1.5, so they read as one set. The
  "free" claims (paraben, sulphate) carry the same diagonal strike.
{%- endcomment -%}
<svg class="isoa-pdp-trust__icon" viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <circle cx="40" cy="40" r="36"/>
  <g transform="translate(40 40) scale(1.3) translate(-40 -40)" stroke-width="1.15">
  {%- case icon -%}
    {%- when 'vegan' -%}
      <path d="M40 56V40"/>
      <path d="M40 46c-8 0-14-6-14-14 8 0 14 6 14 14Z"/>
      <path d="M40 40c0-9 6-15 14-15 0 8-6 15-14 15Z"/>
    {%- when 'cruelty_free' -%}
      <ellipse cx="35.5" cy="29" rx="3.5" ry="9.5" transform="rotate(-10 35.5 29)"/>
      <ellipse cx="44.5" cy="29" rx="3.5" ry="9.5" transform="rotate(10 44.5 29)"/>
      <circle cx="40" cy="47" r="10"/>
      <circle cx="36.5" cy="45" r="1" fill="currentColor" stroke="none"/>
      <circle cx="43.5" cy="45" r="1" fill="currentColor" stroke="none"/>
      <path d="M38.5 49.5 40 51l1.5-1.5"/>
    {%- when 'non_toxic' -%}
      <circle cx="40" cy="40" r="3"/>
      <ellipse cx="40" cy="40" rx="15" ry="6.5"/>
      <ellipse cx="40" cy="40" rx="15" ry="6.5" transform="rotate(60 40 40)"/>
      <ellipse cx="40" cy="40" rx="15" ry="6.5" transform="rotate(120 40 40)"/>
    {%- when 'paraben_free' -%}
      <path d="M40 24s-11 12.5-11 21a11 11 0 0 0 22 0c0-8.5-11-21-11-21Z"/>
      <path d="M27 55 53 25"/>
    {%- when 'sulphate_free' -%}
      <circle cx="35" cy="45" r="7"/>
      <circle cx="46.5" cy="35.5" r="5"/>
      <circle cx="47" cy="49" r="3.5"/>
      <path d="M27 55 53 25"/>
    {%- when 'non_comedogenic' -%}
      <circle cx="40" cy="40" r="4.5"/>
      <circle cx="40" cy="25.5" r="3"/>
      <circle cx="40" cy="54.5" r="3"/>
      <circle cx="27.5" cy="32.75" r="3"/>
      <circle cx="52.5" cy="32.75" r="3"/>
      <circle cx="27.5" cy="47.25" r="3"/>
      <circle cx="52.5" cy="47.25" r="3"/>
      <path d="M40 28.5v7M40 44.5v7M30.1 34.25l6 3.5M49.9 34.25l-6 3.5M30.1 45.75l6-3.5M49.9 45.75l-6-3.5"/>
  {%- endcase -%}
  </g>
</svg>
