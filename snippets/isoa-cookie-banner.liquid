<aside class="isoa-cookie-banner" data-isoa-cookie-banner role="region" aria-label="Cookie preferences" hidden>
  <div class="isoa-cookie-banner__copy">
    <p>We use essential cookies to run our site. Optional cookies help us understand visits and personalise your experience. Choose whether to allow them.</p>
    <a href="{{ shop.policies.privacy_policy.url | default: '/pages/privacy-policy' }}">Privacy policy</a>
  </div>
  <div class="isoa-cookie-banner__actions">
    <button type="button" class="isoa-cookie-banner__button isoa-cookie-banner__button--outline" data-isoa-cookie-reject>Reject optional</button>
    <button type="button" class="isoa-cookie-banner__button isoa-cookie-banner__button--filled" data-isoa-cookie-accept>Accept all</button>
  </div>
</aside>
