      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Where does Barrier Milk fit into my daily routine?",
            "answer": "<p>Morning and night, after cleansing. In the morning, press it onto your face and neck, then follow with moisturiser, sunscreen and makeup. At night, apply it after your acne treatment and before barrier cream.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Can I use it with my acne treatment?",
            "answer": "<p>Yes. Use your acne treatment according to its directions first, then apply Barrier Milk. Follow with barrier cream if needed and compatible with your treatment.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What does it feel like on skin?",
            "answer": "<p>A lightweight, milky serum that leaves skin feeling soft and hydrated. It is fragrance-free.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Is it dermatologist tested?",
            "answer": "<p>Yes. Barrier Milk is dermatologist-tested and non-comedogenic.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Is it vegan or cruelty-free?",
            "answer": "<p>Yes. Barrier Milk is vegan, cruelty-free and gluten-free.</p>"
          }
        }
