                },
                "accordion_row_bypDPJ": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "APPLICATION",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_bABhBY": {
                      "type": "text",
                      "settings": {
                        "text": "<p><strong>AM</strong><br/>After cleansing, gently press Barrier Milk onto your face and neck. Follow with moisturiser, sunscreen, and makeup.</p><p><strong>PM</strong><br/>After cleansing, use your acne treatment according to its directions. Apply Barrier Milk and follow with barrier cream, if needed and compatible with your treatment.</p><p><strong>ISOUA tip:</strong> For soft, hydrated skin, layer Barrier Milk under your moisturiser.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
