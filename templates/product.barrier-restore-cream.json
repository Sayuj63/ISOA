                  "blocks": {
                    "text_x6E4qX": {
                      "type": "text",
                      "settings": {
                        "text": "<ul><li>Lightweight hydration for blemish-prone skin</li><li>Helps soothe and comfort stressed skin</li><li>Supports the skin barrier and helps reduce moisture loss</li><li>Helps improve the appearance of post-acne marks and uneven skin tone</li><li>Softens rough texture for smoother, softer-feeling skin</li></ul>",
                        "width": "fit-content",
