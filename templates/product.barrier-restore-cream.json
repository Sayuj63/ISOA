                },
                "accordion_row_HfgbPj": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "KEY INGREDIENTS",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_GqXfJT": {
                      "type": "text",
                      "settings": {
                        "text": "<p><span style=\"text-decoration:underline\">4% Niacinamide</span> helps support the skin barrier and improve the appearance of uneven skin tone and post-acne marks.<br/><br/><span style=\"text-decoration:underline\">2.5% Azelaic Acid Complex </span>helps improve the appearance of uneven skin tone and post-blemish marks.</p><p><span style=\"text-decoration:underline\">2.5% Panthenol (Pro-Vitamin B5) </span>helps hydrate, soften, and condition skin.</p><p><span style=\"text-decoration:underline\">4% Glycerin</span> attracts moisture to keep skin hydrated and soft.</p><p><span style=\"text-decoration:underline\">10% Aloe Leaf Water</span> helps condition skin and maintain a comfortable, hydrated feel.</p><p><span style=\"text-decoration:underline\">Ceramide NP</span> helps support the skin’s natural moisture barrier and reduce moisture loss.</p><p><span style=\"text-decoration:underline\">0.2% Ectoin </span>helps maintain skin hydration and support skin comfort.</p><p><span style=\"text-decoration:underline\">2% Betaine </span>helps maintain moisture and leave skin feeling soft and supple.</p><p><a href=\"#full-ingredients\">See full ingredients list</a></p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
