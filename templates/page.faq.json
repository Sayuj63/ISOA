            "cat3_a10": "",
            "category_4_name": "RETURNS, EXCHANGES & REFUNDS",
            "cat4_q1": "CAN I RETURN AN ITEM?",
            "cat4_a1": "No. ISOUA items cannot be returned due to hygiene reasons. All sales are final.",
            "cat4_q2": "CAN I EXCHANGE AN ITEM?",
            "cat4_a2": "Yes, only if the item is damaged, defective, or incorrect—and it must be reported within 24–48 hours.",
            "cat4_q3": "CAN I GET A REFUND?",
            "cat4_a3": "Refunds are only offered if an exchange is not possible from our end.",
            "cat4_q4": "WHO PAYS FOR RETURN/EXCHANGE SHIPPING?",
            "cat4_a4": "Customers handle return shipping unless ISOUA specifies otherwise.",
            "cat4_q5": "HOW LONG DOES A REFUND OR REPLACEMENT TAKE?",
            "cat4_a5": "Refunds: 7–10 business days\nReplacements: 5–7 working days after approval or receipt of the returned item",
            "cat4_q6": "DOES ISOUA EVER REFUSE CLAIMS?",
            "cat4_a6": "Yes. We may request proof and verify all requests. Incomplete, fraudulent, or unverifiable claims can be declined.",
            "cat4_q7": "",
            "cat4_a7": "",
            "cat4_q8": "",
            "cat4_a8": "",
