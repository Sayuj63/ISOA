        "ai_gen_block_49d139c_TrQQgi": {
          "type": "ai_gen_block_49d139c",
          "settings": {
            "category_1_name": "PRODUCTS",
            "cat1_q1": "WHAT SKIN TYPES ARE ISOUA PRODUCTS SUITABLE FOR?",
            "cat1_a1": "ISOUA products are formulated for all skin types—including oily, dry, combination, and sensitive skin.\nFull ingredient lists are available on each product page. For specific concerns, we recommend a patch test or consulting your healthcare provider.",
            "cat1_q2": "ARE ISOUA PRODUCTS VEGAN OR CRUELTY-FREE?",
            "cat1_a2": "Yes! All ISOUA products are 100% vegan and cruelty-free. That means no animals are harmed, and we use zero animal-derived ingredients—just clean, effective skincare you can feel good about..",
            "cat1_q3": "ARE ISOUA SKINCARE PRODUCTS FRAGRANCE-FREE",
            "cat1_a3": "Yes, all isoua skincare products are available without fragrance.",
            "cat1_q4": "ARE ISOUA SKINCARE PRODUCTS PREGNANCY SAFE?",
            "cat1_a4": "Though nothing in our formula has been identified as unsafe for pregnant or breastfeeding persons, we recommend sharing our ingredient list with your healthcare providers for review before using.",
            "cat1_q5": "ARE ISOUA SKINCARE PRODUCTS CLEAN?",
            "cat1_a5": "Isoua products are formulated with high global standards. Though we are direct-to-consumer, our ingredient lists are in line with the clean standards specified by third-party retailers.",
            "cat1_q6": "WHAT IF A ISOUA  PRODUCT DOESN'T WORK FOR ME?",
            "cat1_a6": "Contact us (please include your order number) within 30 days of receiving your order, and we'll help you out ASAP with any returns and additional questions.\n\nTo return an order placed with AEQEA, please reach out to the retailer directly for further support.",
            "cat1_q7": "CAN I TRUST ISOUA  PRODUCTS FROM THIRD-PARTY WEBSITES?",
            "cat1_a7": "Our only sales channels are isoua.com, our verified Instagram Shop and TikTok Shop, as well as AEQEA ( www.aeqeaa.com). If you purchase isoua products from any other source, we cannot guarantee that you’re buying genuine products or vouch for their authenticity, quality, or condition. These products may not meet our standards—and in some cases, may be counterfeit.",
            "cat1_q8": "",
            "cat1_a8": "",
            "cat1_q9": "",
            "cat1_a9": "",
            "cat1_q10": "",
            "cat1_a10": "",
            "category_2_name": "SHIPPING",
            "cat2_q1": "HOW LONG WILL MY ORDER TAKE?",
            "cat2_a1": "Orders within India are processed in 2–3 business days and delivered in 5–7 working days.",
            "cat2_q2": "WHERE DO YOU SHIP?",
            "cat2_a2": "Currently, ISOUA ships only within India.",
            "cat2_q3": "HOW CAN I TRACK MY ORDER?",
            "cat2_a3": "You’ll get a shipping confirmation email with a tracking number once your order is dispatched. Didn’t get it? Check your spam folder or email isoua.help@gmail.com.",
            "cat2_q4": "MY ITEM ARRIVED DAMAGED. WHAT SHOULD I DO?",
            "cat2_a4": "Contact us within 24–48 hours at isoua.help@gmail.com with your order number, a photo, and a brief description. We’ll sort it out quickly.",
            "cat2_q5": "",
            "cat2_a5": "",
            "cat2_q6": "",
            "cat2_a6": "",
            "cat2_q7": "",
            "cat2_a7": "",
