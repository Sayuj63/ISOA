            "cat2_q10": "",
            "cat2_a10": "",
            "category_3_name": "ORDERS & PAYMENT",
            "cat3_q1": "WHICH PAYMENT METHODS DO YOU ACCEPT?",
            "cat3_a1": "UPI, credit/debit cards, net banking, wallets, and Cash on Delivery (where available).",
            "cat3_q2": "CAN I CANCEL OR CHANGE MY ORDER?",
            "cat3_a2": "Only before the order is fulfilled/shipped. Once dispatched, orders cannot be changed or cancelled.",
            "cat3_q3": "WHY WAS MY ORDER CANCELLED?",
            "cat3_a3": "If an order is cancelled before dispatch, a refund is issued to the original payment method within 7–10 business days.",
            "cat3_q4": "",
            "cat3_a4": "",
            "cat3_q5": "",
            "cat3_a5": "",
            "cat3_q6": "",
            "cat3_a6": "",
