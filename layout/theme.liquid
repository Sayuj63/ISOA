    {% endif %}
    {% if template == 'product.rhode-pdp-v2' %}
      {{ 'rhode-pdp-v2.css' | asset_url | stylesheet_tag }}
      <script>
        window.addEventListener('load', function() {
          var media = document.querySelector('.product-information__media');
          if (!media) return;
          var slideshow = media.querySelector('slideshow-component');
          if (!slideshow) return;
          slideshow.setAttribute('autoplay', '3');
          if (typeof slideshow.play === 'function') slideshow.play();
        });
      </script>
    {% endif %}
    {% if template == 'product.spotwear-pdp' %}
      {{ 'rhode-pdp.css' | asset_url | stylesheet_tag }}
      {{ 'rhode-collection-cards.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template contains 'collection' %}
      {{ 'isoua-collection-mobile.css' | asset_url | stylesheet_tag }}
      {{ 'rhode-collection-cards.css' | asset_url | stylesheet_tag }}
