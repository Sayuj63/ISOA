    {{ 'isoa-image-zoom.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'isoa-image-zoom.js' | asset_url }}" defer></script>

    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

