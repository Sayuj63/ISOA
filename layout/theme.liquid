    {% if template == 'cart' or settings.cart_type == 'drawer' %}
      {{ 'rhode-cart.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {{ 'rhode-drawers.css' | asset_url | stylesheet_tag }}
    {% if template == 'search' %}
      {{ 'rhode-search.css' | asset_url | stylesheet_tag }}
