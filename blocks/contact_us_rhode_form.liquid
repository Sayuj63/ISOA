</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.maxFiles = 10;
        this.maxTotalSize = 50 * 1024 * 1024;
        this.files = [];
      }

      connectedCallback() {
        this.fileUpload = this.querySelector('[data-file-upload]');
        this.fileInput = this.querySelector('[data-file-input]');
        this.fileList = this.querySelector('[data-file-list]');
        this.fileStatus = this.querySelector('[data-file-status]');
        this.fileError = this.querySelector('[data-file-error]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.fileInput.addEventListener('change', (e) => this.handleFileSelect(e));
        
        this.fileUpload.addEventListener('dragover', (e) => {
          e.preventDefault();
          this.fileUpload.classList.add('drag-over');
        });

        this.fileUpload.addEventListener('dragleave', () => {
          this.fileUpload.classList.remove('drag-over');
        });

        this.fileUpload.addEventListener('drop', (e) => {
          e.preventDefault();
          this.fileUpload.classList.remove('drag-over');
          this.handleFiles(e.dataTransfer.files);
        });

        this.addEventListener('paste', (e) => {
          const items = e.clipboardData.items;
          const files = [];
          for (let i = 0; i < items.length; i++) {
            if (items[i].kind === 'file') {
              files.push(items[i].getAsFile());
            }
          }
          if (files.length > 0) {
            e.preventDefault();
            this.handleFiles(files);
          }
        });
      }

      handleFileSelect(e) {
        this.handleFiles(e.target.files);
      }

      handleFiles(fileList) {
        const newFiles = Array.from(fileList);
        
        if (this.files.length + newFiles.length > this.maxFiles) {
          this.showError(`Maximum ${this.maxFiles} files allowed`);
          return;
        }

        const totalSize = [...this.files, ...newFiles].reduce((sum, file) => sum + file.size, 0);
        if (totalSize > this.maxTotalSize) {
          this.showError('Total file size exceeds 50MB');
          return;
        }

        this.files = [...this.files, ...newFiles];
        this.updateFileList();
        this.hideError();
      }

      updateFileList() {
        if (this.files.length === 0) {
          this.fileStatus.textContent = 'No file chosen';
          this.fileList.innerHTML = '';
          return;
        }

        this.fileStatus.textContent = `${this.files.length} file${this.files.length > 1 ? 's' : ''} selected`;
        
        this.fileList.innerHTML = this.files.map((file, index) => `
          <div class="ai-contact-form-file-item-{{ ai_gen_id }}">
            <span class="ai-contact-form-file-item-name-{{ ai_gen_id }}">${this.escapeHtml(file.name)}</span>
            <span class="ai-contact-form-file-item-size-{{ ai_gen_id }}">${this.formatFileSize(file.size)}</span>
            <button type="button" class="ai-contact-form-file-remove-{{ ai_gen_id }}" data-remove="${index}" aria-label="Remove file">&#215;</button>
          </div>
        `).join('');

        this.fileList.querySelectorAll('[data-remove]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const index = parseInt(e.target.getAttribute('data-remove'));
            this.removeFile(index);
          });
        });
      }

      removeFile(index) {
        this.files.splice(index, 1);
        this.updateFileList();
        this.hideError();
      }

      formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
      }

      showError(message) {
        this.fileError.textContent = message;
        this.fileError.style.display = 'block';
      }

      hideError() {
        this.fileError.style.display = 'none';
      }

      escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>
<style>
#shopify-section-{{ section.id }} {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

#shopify-section-{{ section.id }} > div {
  margin-top: 0 !important;
  padding-top: 0 !important;
}
</style>
