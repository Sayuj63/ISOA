{% doc %}
  @prompt
    Create a complete contact form with the following fields in this exact order: 1. First and Last Name (required text input), 2. Email (required email input), 3. Contact Reason (required dropdown with these exact options: Order status, Cancel or modify an order, Returns or exchanges, My order is missing, My order arrived damaged, Issue with my product, Shipping questions, Product questions, Partnerships/collaboration, Wholesale requests, Other/general inquiry), 4. Topic (required text input), 5. Tell us the details (required textarea), 6. Optional file upload field supporting up to 10 files max with total size less than 50MB with drag-and-drop, paste, and upload button support showing "No file chosen" by default, 7. Submit button. The form should match the existing contact page styling and be clean and minimal., make the form center aligned on the page
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

/* Rhode-clone contact page: form is a centered 640px column on white.
   Kill inherited beige card + rounding coming from main.css .custom-section-content
   .shopify-block form so this section reads like Rhode's contact page. */
#shopify-section-{{ section.id }} > div,
#shopify-section-{{ section.id }} .section-background {
  background: transparent !important;
  box-shadow: none !important;
}
#shopify-section-{{ section.id }} .custom-section-content .shopify-block form {
  background: transparent !important;
  border-radius: 0 !important;
  padding-top: 0 !important;
}

/* Match the pill rail (same edges as the header) — was 640px hardcoded which
   underfit the pill on desktop and overflowed the viewport on mobile.
   Formula pulled from --page-width / --page-margin at :root (base.css:233). */
.ai-contact-form-{{ ai_gen_id }} {
  width: 100%;
  max-width: min(
    calc(var(--page-width) - var(--page-margin) * 2),
    calc(100% - var(--page-margin) * 2)
  );
  margin: 0 auto;
  background: transparent;
  box-sizing: border-box;
}

.ai-contact-form-container-{{ ai_gen_id }} {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  background: transparent;
  padding: 0;
}

contact-form-{{ ai_gen_id }} {
  display: block;
  width: 100%;
  max-width: min(
    calc(var(--page-width) - var(--page-margin) * 2),
    calc(100% - var(--page-margin) * 2)
  );
  margin: 0 auto;
  background: transparent;
}

/* Match the FAQ heading style (assets/rhode-faq.css .rhode-faq__title) so
   Contact and FAQ read as one system: 34px/800/uppercase/-0.01em desktop,
   22px mobile. Text stays lowercase in the source — CSS uppercases it. */
.ai-contact-form-heading-{{ ai_gen_id }} {
  font-family: 'Inter', sans-serif;
  font-size: 34px;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: #4a4844;
  text-transform: uppercase;
  font-style: normal;
  margin: 0 0 28px;
}

@media (max-width: 749px) {
  .ai-contact-form-heading-{{ ai_gen_id }} {
    font-size: 22px;
    margin-bottom: 20px;
  }
}

.ai-contact-form-field-{{ ai_gen_id }} {
  margin-bottom: 14px;
}

.ai-contact-form-label-{{ ai_gen_id }} {
  display: none !important;

}

.ai-contact-form-required-{{ ai_gen_id }} {
  color: #000;
}

.ai-contact-form-input-{{ ai_gen_id }},
.ai-contact-form-select-{{ ai_gen_id }},
.ai-contact-form-textarea-{{ ai_gen_id }} {
  width: 100%;
  border: 1px solid #d8d5d1;
  background: #f8f7f5;
  color: #4f4b46;
  font-size: 12px;
  font-family: inherit;
  padding: 0 12px;
  border-radius: 6px;
  transition: all 0.2s ease;
  box-shadow: none;

}

.ai-contact-form-input-{{ ai_gen_id }},
.ai-contact-form-select-{{ ai_gen_id }} {
  height: 38px;
}

.ai-contact-form-textarea-{{ ai_gen_id }} {
  min-height: 120px;
  padding-top: 12px;
  resize: none;
}

.ai-contact-form-input-{{ ai_gen_id }}:focus,
.ai-contact-form-select-{{ ai_gen_id }}:focus,
.ai-contact-form-textarea-{{ ai_gen_id }}:focus {
  outline: none;
  border-color: #8d877f;
  background: #ffffff;
}

.ai-contact-form-input-{{ ai_gen_id }}::placeholder,
.ai-contact-form-textarea-{{ ai_gen_id }}::placeholder {
  color: #8b8680;
}

.ai-contact-form-file-upload-{{ ai_gen_id }} {
  border: 1px solid #d8d5d1;
  border-radius: 6px;
  background: #ffffff;
  padding: 14px;
  text-align: left;
  position: relative;
}

.ai-contact-form-file-upload-{{ ai_gen_id }}.drag-over {
  border-color: #8d877f;
  background: #faf9f7;
}

.ai-contact-form-file-input-{{ ai_gen_id }} {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.ai-contact-form-file-label-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  cursor: pointer;
}

.ai-contact-form-file-icon-{{ ai_gen_id }} {
  width: 16px;
  height: 16px;
  opacity: 0.6;
}

.ai-contact-form-file-text-{{ ai_gen_id }} {
  flex: 1;
  font-size: 11px;
  color: #6f6a64;
}

.ai-contact-form-file-button-{{ ai_gen_id }} {
  border: none;
  background: transparent;
  padding: 0;
  font-size: 11px;
  color: #6f6a64;
  cursor: pointer;
  font-family: inherit;
}

.ai-contact-form-file-button-{{ ai_gen_id }}:hover {
  opacity: 0.7;
}

.ai-contact-form-file-hint-{{ ai_gen_id }} {
  margin-top: 8px;
  font-size: 10px;
  color: #9a958f;
  line-height: 1.4;
}

.ai-contact-form-file-list-{{ ai_gen_id }} {
  margin-top: 10px;
}

.ai-contact-form-file-item-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  padding: 6px 0;
  border-bottom: 1px solid #ece9e4;
}

.ai-contact-form-file-remove-{{ ai_gen_id }} {
  border: none;
  background: transparent;
  cursor: pointer;
  font-size: 16px;
  color: #777;
}

.ai-contact-form-submit-{{ ai_gen_id }} {
  /* 2026-08-12: was 100% wide × 46 tall — much bigger than the site's
     standard long-thin pill. Aligned with the isoua-button-overrides.css
     spec so the SEND button reads at the same footprint as GET SPOTWEAR /
     SHOP ALL / OUR VALUES etc. (min-width 200 mobile / 240 desktop, ~28px
     tall from padding). */
  width: auto;
  min-width: 240px;
  height: auto;
  padding: 10px 36px;
  border-radius: 999px;
  border: 1px solid #67645e;
  background: #ffffff;
  color: #67645e;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.25s ease;
  margin-top: 8px;
  align-self: center;
}

.ai-contact-form-submit-{{ ai_gen_id }}:hover {
  background: #5e5a55;
  color: #fff;
}

.ai-contact-form-success-{{ ai_gen_id }},
.ai-contact-form-error-{{ ai_gen_id }} {
  font-size: 12px;
  border-radius: 6px;
  margin-bottom: 20px;
}

/* MOBILE (<=1023px): pill-header offset + bottom corner rounding + top clearance
   NOTE: the section margin-top override was removed 2026-07-29 — now handled
   by isoua-button-overrides.css `body.page-contact-us ... :first-child`
   which pulls the disabled main-page above section_LaJ7Ma up by -12px.
   With main at Y=56 and no margin on this section, it flows to Y=56 too. */
@media screen and (max-width: 1023px) {

  /* Square the top corners where the pill rests on the section */
  #shopify-section-{{ section.id }} .border-style.custom-section-content {
    border-radius: 0 0 10px 10px !important;
  }

  /* Form is a pass-through wrapper on mobile — no padding, so the grey pill
     child fills the section width (16→359) matching the SS-Header-1 pill.
     Header clearance is handled by the section-level margin-top rule below. */
  contact-form-{{ ai_gen_id }} form {
    padding: 0 !important;
    box-sizing: border-box !important;
  }

  /* Mobile heading: bigger and bolder to match reference */
  contact-form-{{ ai_gen_id }} h1 {
    font-size: 38px !important;
    font-weight: 600 !important;
    letter-spacing: -0.01em !important;
  }
}

/* MOBILE (<=768px): larger touch targets, overflow guard */
@media screen and (max-width: 768px) {

  .ai-contact-form-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    overflow-x: hidden;
  }

  .ai-contact-form-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 20px 0 0;
    box-sizing: border-box;
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 14px;
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-select-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }},
  .ai-contact-form-file-upload-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* SEND button: shrunk to the site-standard long-thin pill footprint,
     centered on its row (2026-08-12). `display: block; margin: 0 auto`
     is the only reliable way to horizontally centre a <button> — inline
     margin-auto doesn't work because <button> is inline-block by default. */
  .ai-contact-form-submit-{{ ai_gen_id }} {
    display: block !important;
    width: auto;
    min-width: 200px;
    padding: 7px 24px;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.04em;
    margin: 8px auto 0 !important;
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-select-{{ ai_gen_id }} {
    height: 46px;
    font-size: 16px;
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    font-size: 16px;
  }

  .ai-contact-form-file-label-{{ ai_gen_id }} {
    gap: 8px;
  }

  .ai-contact-form-file-button-{{ ai_gen_id }} {
    white-space: nowrap;
  }

  body {
    overflow-x: hidden;
  }
}
.ai-section-padding-{{ ai_gen_id }} {
  padding-top: {{ block.settings.section_padding_top }}px;
  padding-bottom: {{ block.settings.section_padding_bottom }}px;
  padding-left: {{ block.settings.section_padding_left }}px;
  padding-right: {{ block.settings.section_padding_right }}px;
  box-sizing: border-box;
  max-width: 640px;
  margin: 0 auto;
}

/* 2026-08-12: was full-width 48px pill — client asked for the site's
   standard long-thin pill on Contact SEND. Sizing now delegated to the
   isoua-button-overrides.css spec applied to `[class*="ai-contact-form-submit-"]`;
   this block only carries the shared visual style. */
.ai-contact-form-submit-{{ ai_gen_id }} {
  border-radius: 999px;
  border: 1px solid #67645e;
  background: #ffffff;
  color: #67645e;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.25s ease;
  margin-top: 16px;
}
.ai-contact-form-submit-{{ ai_gen_id }}:hover {
  background: #67645e;
  color: #ffffff;
}

/* DESKTOP (>=1024px): ss-header-1.liquid handles offset via
   .content-for-layout > .shopify-section:first-child { margin-top: var(--header-group-height) }
   No override needed. */

/* Grey pill card = full section pill width (matches SS-Header-1 pill: 40→1400 at 1440vw).
   ID-prefixed selector needed to beat main.css's
   `.custom-section-content .shopify-block form > div { max-width: 50% !important }`
   which has specificity (0,3,1) — an ID lifts us to (1,1,0). */
#shopify-section-{{ section.id }} .ai-section-padding-{{ ai_gen_id }} {
  background: #f1f0ed !important;
  border-radius: 10px !important;
  max-width: 100% !important;
  width: 100% !important;
  /* padding-top matches Terms page (.policy-pages .rte in main.css) so the
     "CONTACT US" heading sits at the same Y as "TERMS OF SERVICE". Sayuj
     asked for identical vertical rhythm between the two pages. */
  padding-top: 152px !important;
  padding-bottom: 64px !important;
  padding-left: 24px !important;
  padding-right: 24px !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  box-sizing: border-box !important;
}

/* Outer wrappers fill the pill's section width. */
.ai-contact-form-{{ ai_gen_id }},
contact-form-{{ ai_gen_id }} {
  max-width: 100% !important;
  width: 100% !important;
  display: block !important;
}

/* Heading + intro AND form fields column stay centered at 600px inside the
   wide grey pill — matches Rhode's contact form width. */
.ai-contact-form-container-{{ ai_gen_id }},
.ai-contact-form-intro-{{ ai_gen_id }} {
  max-width: 600px !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

/* Force inputs/select/textarea/file-upload/button to fill the pill's inner
   width. A Horizon baseline rule on .contact-form input caps controls at
   ~272px — force override via !important. Height bumped to 48 to feel
   less cramped now that they're wider. */
.ai-contact-form-input-{{ ai_gen_id }},
.ai-contact-form-select-{{ ai_gen_id }},
.ai-contact-form-textarea-{{ ai_gen_id }},
.ai-contact-form-file-upload-{{ ai_gen_id }} {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
}
.ai-contact-form-input-{{ ai_gen_id }},
.ai-contact-form-select-{{ ai_gen_id }} {
  height: 48px !important;
  background: #ffffff !important;
  font-size: 13px !important;
}
.ai-contact-form-textarea-{{ ai_gen_id }} {
  background: #ffffff !important;
  min-height: 140px !important;
  font-size: 13px !important;
}
.ai-contact-form-file-upload-{{ ai_gen_id }} {
  background: #ffffff !important;
}

/* Mobile: heading + form styling (section margin-top handled globally now,
   see isoua-button-overrides.css body.page-contact-us :first-child rule). */
@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .ai-section-padding-{{ ai_gen_id }} {
    max-width: 100% !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
    /* 152px matches desktop AND matches Terms mobile (main.css .policy-pages
       .rte @media 749px was also bumped to 152). With section now moved up
       to Y=56 via the -12px margin-top override in isoua-button-overrides.css,
       h1 lands at Y=208 on every viewport — well below the pill bottoms
       (154 desktop / 138 mobile) so the heading is always visible. */
    padding-top: 152px !important;
    padding-bottom: 40px !important;
    border-radius: 10px !important;
  }
  .ai-contact-form-{{ ai_gen_id }},
  contact-form-{{ ai_gen_id }} {
    max-width: 100% !important;
  }
}

{% endstyle %}

