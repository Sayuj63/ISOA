{% doc %}
  Direct-buy pill for the PDP: one button carrying the product and its price,
  "BUY SPOTWEAR — RS. 1,999", which goes straight to checkout with only this
  item. Rhode's PDP button, styled like the homepage product-card BUY pill
  (assets/rhode-collection-cards.css .isoa-rc-cta): solid white, no outline.

  It replaces Shopify's accelerated "Buy it now" button, whose label is drawn
  by Shopify and can't carry the product name or price. The link is a cart
  permalink (/cart/<variant>:<qty>), which opens checkout with just that
  line — no JavaScript, and it doesn't touch the shopper's existing cart.

  Rendered from the selected variant; Horizon's variant picker re-renders the
  product section on change, so the label and link follow the selection.

  @example
  {% content_for 'block', type: 'isoa-direct-buy', id: 'direct-buy' %}
{% enddoc %}

{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign name = product.metafields.custom.card_short_name | default: product.title
-%}

<div class="isoa-direct-buy" {{ block.shopify_attributes }}>
  {%- if variant.available -%}
    <a class="isoa-direct-buy__button" href="{{ routes.cart_url }}/{{ variant.id }}:1">
      {{- 'BUY ' | append: name | upcase }} — <strong>{{ variant.price | money_without_trailing_zeros }}</strong>
    </a>
  {%- else -%}
    <span class="isoa-direct-buy__button isoa-direct-buy__button--sold-out" aria-disabled="true">
      {{- 'products.product.sold_out' | t -}}
    </span>
  {%- endif -%}
</div>

{% stylesheet %}
  .isoa-direct-buy {
    width: 100%;
  }

  /* Desktop: 48px / 17px, Rhode's PDP button measured at 1440. */
  .isoa-direct-buy__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3em;
    box-sizing: border-box;
    width: 100%;
    height: 48px;
    padding: 0 20px;
    border-radius: 999px;
    background-color: #ffffff;
    color: #67645e;
    font-family: var(--font-body--family);
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .isoa-direct-buy__button strong {
    font-weight: 700;
  }

  .isoa-direct-buy__button:hover {
    background-color: #67645e;
    color: #ffffff;
  }

  .isoa-direct-buy__button:focus-visible {
    outline: 2px solid #67645e;
    outline-offset: 2px;
  }

  .isoa-direct-buy__button--sold-out {
    color: #b0aeab;
    cursor: not-allowed;
  }

  .isoa-direct-buy__button--sold-out:hover {
    background-color: #ffffff;
    color: #b0aeab;
  }

  /* Mobile: 40px / 14px, Rhode's mobile PDP button. */
  @media screen and (max-width: 749px) {
    .isoa-direct-buy__button {
      height: 40px;
      padding: 0 16px;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Direct buy button",
  "settings": [],
  "presets": [
    {
      "name": "Direct buy button"
    }
  ]
}
{% endschema %}
