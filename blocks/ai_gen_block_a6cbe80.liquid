{% doc %}
  @prompt
    generat an announcement bar with round edges and al these features {
      margin-top: 10px;
      margin-bottom: 10px;
      margin-left: 40px;
      margin-right: 40px;
    }
    .announcement-bar {
      border-radius: 10px;
    }
    .h5 {
      font-size: 12px;
      text-transform: uppercase;
      min-height: 0px;
    }
    @media screen and (max-width: 768px) {
       {
        margin-bottom: -10px;
        margin-left: 20px;
        margin-right: 20px;
      }
    } and make it dynamic and responsive, KEEP ANNOUNCEMENT TEXT CENTRE ALIGNED 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-announcement-bar-container-{{ ai_gen_id }} {
    margin-top: {{ block.settings.margin_top_desktop }}px;
    margin-bottom: {{ block.settings.margin_bottom_desktop }}px;
    margin-left: {{ block.settings.margin_left_desktop }}px;
    margin-right: {{ block.settings.margin_right_desktop }}px;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .ai-announcement-bar-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    text-transform: {{ block.settings.text_transform }};
    margin: 0;
    min-height: 0;
    line-height: 1.4;
    text-align: center;
  }

  .ai-announcement-bar-text-{{ ai_gen_id }} p {
    margin: 0;
    text-align: center;
  }

  .ai-announcement-bar-text-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_decoration }};
  }

  .ai-announcement-bar-text-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-announcement-bar-container-{{ ai_gen_id }} {
      margin-top: {{ block.settings.margin_top_mobile }}px;
      margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
      margin-left: {{ block.settings.margin_left_mobile }}px;
      margin-right: {{ block.settings.margin_right_mobile }}px;
      padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-announcement-bar-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-announcement-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-bar-container-{{ ai_gen_id }}">
    {% if block.settings.announcement_text != blank %}
      <div class="ai-announcement-bar-text-{{ ai_gen_id }}">
        {{ block.settings.announcement_text }}
      </div>
    {% else %}
      <div class="ai-announcement-bar-text-{{ ai_gen_id }}">
        Add your announcement text here
      </div>
    {% endif %}
  </div>
</div>

