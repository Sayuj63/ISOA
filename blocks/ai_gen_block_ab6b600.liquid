        </li>
      {% endif %}

      {% if block.settings.pill_5_label != blank %}
        <li class="ai-pill-nav-item-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.pill_5_link }}"
            class="ai-pill-nav-link-{{ ai_gen_id }}"
            data-pill-link
          >
            {{ block.settings.pill_5_label }}
          </a>
        </li>
      {% endif %}

      {% if block.settings.pill_6_label != blank %}
