{% doc %}
  @prompt
    Create a dynamic horizontal pill-style navigation/filter bar section for a collections page. Design specs: horizontally scrollable row of pill-shaped buttons with border-radius ~50px; default pill style: white/transparent background, thin dark border (1px solid #222), dark text; active pill: dark filled background (#222), white text; compact size with 20-28px horizontal padding, 8-10px vertical padding; uppercase font, letter-spacing, font-size 11-13px; 8px gap between pills; no bar background. Functionality: fully dynamic blocks in theme editor - each pill block has Label (text) and Link (URL) settings; active state auto-detected via current URL match using JS; section settings for alignment (left/center/right), active pill color, inactive border color, inactive text color; horizontal scroll on mobile without wrapping; hover tint on inactive pills; accessible with aria-label on nav and aria-current on active pill. Use Liquid, scoped CSS, and small JS for URL-based active detection.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pill-nav-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-pill-nav-container-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-pill-nav-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-pill-nav-list-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    {% if block.settings.alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    min-width: min-content;
  }

  .ai-pill-nav-item-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-pill-nav-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    background-color: {{ block.settings.inactive_background }};
    color: {{ block.settings.inactive_text_color }};
    border: 1px solid {{ block.settings.inactive_border_color }};
    border-radius: 50px;
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .ai-pill-nav-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.inactive_hover_background }};
  }

  .ai-pill-nav-link-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.active_background }};
    color: {{ block.settings.active_text_color }};
    border-color: {{ block.settings.active_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-pill-nav-list-{{ ai_gen_id }} {
      justify-content: flex-start;
    }
  }
{% endstyle %}

<pill-nav-{{ ai_gen_id }}
  class="ai-pill-nav-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <nav
    class="ai-pill-nav-container-{{ ai_gen_id }}"
    aria-label="Filter navigation"
  >
    <ul class="ai-pill-nav-list-{{ ai_gen_id }}">
      {% if block.settings.pill_1_label != blank %}
        <li class="ai-pill-nav-item-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.pill_1_link }}"
            class="ai-pill-nav-link-{{ ai_gen_id }}"
            data-pill-link
