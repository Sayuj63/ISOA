    { "type": "text", "id": "cat2_q3", "label": "Question 3" }, { "type": "textarea", "id": "cat2_a3", "label": "Answer 3" },
    { "type": "text", "id": "cat2_q4", "label": "Question 4" }, { "type": "textarea", "id": "cat2_a4", "label": "Answer 4" },
    { "type": "text", "id": "cat2_q5", "label": "Question 5" }, { "type": "textarea", "id": "cat2_a5", "label": "Answer 5" },
    { "type": "text", "id": "cat2_q6", "label": "Question 6" }, { "type": "textarea", "id": "cat2_a6", "label": "Answer 6" },
    { "type": "text", "id": "cat2_q7", "label": "Question 7" }, { "type": "textarea", "id": "cat2_a7", "label": "Answer 7" },
    { "type": "text", "id": "cat2_q8", "label": "Question 8" }, { "type": "textarea", "id": "cat2_a8", "label": "Answer 8" },
    { "type": "text", "id": "cat2_q9", "label": "Question 9" }, { "type": "textarea", "id": "cat2_a9", "label": "Answer 9" },
    { "type": "text", "id": "cat2_q10", "label": "Question 10" }, { "type": "textarea", "id": "cat2_a10", "label": "Answer 10" },

    { "type": "header", "content": "Category 3" },
    { "type": "text", "id": "category_3_name", "label": "Category name", "default": "Returns" },
    { "type": "text", "id": "cat3_q1", "label": "Question 1", "default": "How do I start a return?" },
    { "type": "textarea", "id": "cat3_a1", "label": "Answer 1", "default": "Contact our support team to initiate a return." },
    { "type": "text", "id": "cat3_q2", "label": "Question 2" }, { "type": "textarea", "id": "cat3_a2", "label": "Answer 2" },
