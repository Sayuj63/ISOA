    { "type": "text", "id": "cat1_q7", "label": "Question 7" }, { "type": "textarea", "id": "cat1_a7", "label": "Answer 7" },
    { "type": "text", "id": "cat1_q8", "label": "Question 8" }, { "type": "textarea", "id": "cat1_a8", "label": "Answer 8" },
