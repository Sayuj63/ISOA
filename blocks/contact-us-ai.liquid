{% doc %}
  @prompt
    Create a complete contact form with the following fields in this exact order: 1. First and Last Name (required text input), 2. Email (required email input), 3. Contact Reason (required dropdown with these exact options: Order status, Cancel or modify an order, Returns or exchanges, My order is missing, My order arrived damaged, Issue with my product, Shipping questions, Product questions, Partnerships/collaboration, Wholesale requests, Other/general inquiry), 4. Topic (required text input), 5. Tell us the details (required textarea), 6. Optional file upload field supporting up to 10 files max with total size less than 50MB with drag-and-drop, paste, and upload button support showing "No file chosen" by default, 7. Submit button. The form should match the existing contact page styling and be clean and minimal., make the form center aligned on the page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-contact-form__wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-contact-form__fields-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.field_spacing }}px;
  }

  .ai-contact-form__field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 500;
    color: {{ block.settings.label_color }};
  }

  .ai-contact-form__required-{{ ai_gen_id }} {
    color: {{ block.settings.required_color }};
    margin-left: 4px;
  }

  .ai-contact-form__input-{{ ai_gen_id }},
  .ai-contact-form__select-{{ ai_gen_id }},
  .ai-contact-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    font-size: {{ block.settings.input_size }}px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_background }};
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    transition: all 0.2s ease;
  }

  .ai-contact-form__input-{{ ai_gen_id }}:hover,
  .ai-contact-form__select-{{ ai_gen_id }}:hover,
  .ai-contact-form__textarea-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.input_hover_background }};
  }

  .ai-contact-form__input-{{ ai_gen_id }}:focus,
  .ai-contact-form__select-{{ ai_gen_id }}:focus,
  .ai-contact-form__textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
    border-color: {{ block.settings.input_focus_color }};
  }

  .ai-contact-form__textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
    font-family: inherit;
  }

  .ai-contact-form__file-upload-{{ ai_gen_id }} {
    position: relative;
    border: 2px dashed {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    padding: 24px;
    text-align: center;
    background-color: {{ block.settings.input_background }};
    transition: all 0.2s ease;
  }

  .ai-contact-form__file-upload-{{ ai_gen_id }}.drag-over {
    border-color: {{ block.settings.input_focus_color }};
    background-color: {{ block.settings.input_hover_background }};
  }

  .ai-contact-form__file-input-{{ ai_gen_id }} {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .ai-contact-form__file-label-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    cursor: pointer;
  }

  .ai-contact-form__file-icon-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    color: {{ block.settings.label_color }};
  }

  .ai-contact-form__file-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.input_size }}px;
    color: {{ block.settings.label_color }};
  }

  .ai-contact-form__file-hint-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.input_text_color }};
    opacity: 0.7;
    margin-top: 4px;
  }

  .ai-contact-form__file-list-{{ ai_gen_id }} {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form__file-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background-color: {{ block.settings.input_hover_background }};
    border-radius: 4px;
    font-size: 14px;
  }

  .ai-contact-form__file-remove-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.required_color }};
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
  }

  .ai-contact-form__file-remove-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-contact-form__error-{{ ai_gen_id }} {
    color: {{ block.settings.required_color }};
    font-size: 12px;
    margin-top: 4px;
  }

  .ai-contact-form__submit-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 24px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    text-transform: {{ block.settings.button_text_transform }};
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_background }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ai-contact-form__submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-contact-form__submit-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-contact-form__success-{{ ai_gen_id }} {
    padding: 16px;
    background-color: #d4edda;
    color: #155724;
    border-radius: {{ block.settings.border_radius }}px;
    margin-bottom: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form__wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }} class="ai-contact-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {%- form 'contact' -%}
    <div class="ai-contact-form__wrapper-{{ ai_gen_id }}">
      {%- if form.posted_successfully? -%}
        <div class="ai-contact-form__success-{{ ai_gen_id }}">
          {{ block.settings.success_message }}
        </div>
      {%- endif -%}

      <div class="ai-contact-form__fields-{{ ai_gen_id }}">
        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="contact-name-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.name_label }}
            <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <input
            type="text"
            id="contact-name-{{ ai_gen_id }}"
            name="contact[name]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.name_placeholder }}"
            required
            aria-required="true"
          >
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="contact-email-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.email_label }}
            <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <input
            type="email"
            id="contact-email-{{ ai_gen_id }}"
            name="contact[email]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.email_placeholder }}"
            required
            aria-required="true"
            autocomplete="email"
          >
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="contact-reason-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.reason_label }}
            <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <select
            id="contact-reason-{{ ai_gen_id }}"
            name="contact[reason]"
            class="ai-contact-form__select-{{ ai_gen_id }}"
            required
            aria-required="true"
          >
            <option value="">Select a reason</option>
            <option value="Order status">Order status</option>
            <option value="Cancel or modify an order">Cancel or modify an order</option>
            <option value="Returns or exchanges">Returns or exchanges</option>
            <option value="My order is missing">My order is missing</option>
            <option value="My order arrived damaged">My order arrived damaged</option>
            <option value="Issue with my product">Issue with my product</option>
            <option value="Shipping questions">Shipping questions</option>
            <option value="Product questions">Product questions</option>
            <option value="Partnerships/collaboration">Partnerships/collaboration</option>
            <option value="Wholesale requests">Wholesale requests</option>
            <option value="Other/general inquiry">Other/general inquiry</option>
          </select>
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="contact-topic-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.topic_label }}
            <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <input
            type="text"
            id="contact-topic-{{ ai_gen_id }}"
            name="contact[topic]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.topic_placeholder }}"
            required
            aria-required="true"
          >
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="contact-message-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.message_label }}
            <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <textarea
            id="contact-message-{{ ai_gen_id }}"
            name="contact[body]"
            class="ai-contact-form__textarea-{{ ai_gen_id }}"
            placeholder="{{ block.settings.message_placeholder }}"
            required
            aria-required="true"
          ></textarea>
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.file_label }}
          </label>
          <div class="ai-contact-form__file-upload-{{ ai_gen_id }}" data-file-upload>
            <input
              type="file"
              id="contact-files-{{ ai_gen_id }}"
              class="ai-contact-form__file-input-{{ ai_gen_id }}"
              multiple
              accept="image/*,.pdf,.doc,.docx"
              data-file-input
            >
            <label for="contact-files-{{ ai_gen_id }}" class="ai-contact-form__file-label-{{ ai_gen_id }}">
              <svg class="ai-contact-form__file-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
              <div>
                <div class="ai-contact-form__file-text-{{ ai_gen_id }}" data-file-status>
                  No file chosen
                </div>
                <div class="ai-contact-form__file-hint-{{ ai_gen_id }}">
                  Drag & drop, paste, or click to upload (max 10 files, 50MB total)
                </div>
              </div>
            </label>
            <div class="ai-contact-form__file-list-{{ ai_gen_id }}" data-file-list></div>
          </div>
          <div class="ai-contact-form__error-{{ ai_gen_id }}" data-file-error></div>
        </div>

        <button type="submit" class="ai-contact-form__submit-{{ ai_gen_id }}">
          {{ block.settings.submit_label }}
        </button>
      </div>
    </div>
  {%- endform -%}
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.maxFiles = 10;
        this.maxTotalSize = 50 * 1024 * 1024;
        this.files = [];
      }

      connectedCallback() {
        this.fileUpload = this.querySelector('[data-file-upload]');
        this.fileInput = this.querySelector('[data-file-input]');
        this.fileStatus = this.querySelector('[data-file-status]');
        this.fileList = this.querySelector('[data-file-list]');
        this.fileError = this.querySelector('[data-file-error]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.fileInput.addEventListener('change', (e) => this.handleFileSelect(e));
        
        this.fileUpload.addEventListener('dragover', (e) => {
          e.preventDefault();
          this.fileUpload.classList.add('drag-over');
        });

        this.fileUpload.addEventListener('dragleave', () => {
          this.fileUpload.classList.remove('drag-over');
        });

        this.fileUpload.addEventListener('drop', (e) => {
          e.preventDefault();
          this.fileUpload.classList.remove('drag-over');
          this.handleFiles(e.dataTransfer.files);
        });

        document.addEventListener('paste', (e) => {
          if (e.clipboardData.files.length > 0) {
            e.preventDefault();
            this.handleFiles(e.clipboardData.files);
          }
        });
      }

      handleFileSelect(e) {
        this.handleFiles(e.target.files);
      }

      handleFiles(newFiles) {
        this.fileError.textContent = '';
        
        const filesArray = Array.from(newFiles);
        
        if (this.files.length + filesArray.length > this.maxFiles) {
          this.fileError.textContent = `Maximum ${this.maxFiles} files allowed`;
          return;
        }

        const totalSize = this.files.reduce((sum, f) => sum + f.size, 0) + 
                         filesArray.reduce((sum, f) => sum + f.size, 0);

        if (totalSize > this.maxTotalSize) {
          this.fileError.textContent = 'Total file size exceeds 50MB';
          return;
        }

        this.files = this.files.concat(filesArray);
        this.updateFileList();
      }

      updateFileList() {
        if (this.files.length === 0) {
          this.fileStatus.textContent = 'No file chosen';
          this.fileList.innerHTML = '';
          return;
        }

        this.fileStatus.textContent = `${this.files.length} file${this.files.length > 1 ? 's' : ''} selected`;
        
        this.fileList.innerHTML = this.files.map((file, index) => `
          <div class="ai-contact-form__file-item-{{ ai_gen_id }}">
            <span>${file.name} (${this.formatFileSize(file.size)})</span>
            <button type="button" class="ai-contact-form__file-remove-{{ ai_gen_id }}" data-remove="${index}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        `).join('');

        this.fileList.querySelectorAll('[data-remove]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const index = parseInt(e.currentTarget.getAttribute('data-remove'));
            this.files.splice(index, 1);
            this.updateFileList();
          });
        });
      }

      formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "header",
      "content": "Form fields"
    },
    {
      "type": "text",
      "id": "name_label",
