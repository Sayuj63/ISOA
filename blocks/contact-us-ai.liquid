      "label": "Name placeholder",
      "default": "Enter your full name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "reason_label",
      "label": "Contact reason label",
      "default": "Contact Reason"
    },
    {
      "type": "text",
      "id": "topic_label",
      "label": "Topic label",
      "default": "Topic"
    },
    {
      "type": "text",
      "id": "topic_placeholder",
      "label": "Topic placeholder",
      "default": "Brief subject line"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Tell us the details"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Please provide as much detail as possible..."
    },
    {
      "type": "text",
      "id": "file_label",
      "label": "File upload label",
