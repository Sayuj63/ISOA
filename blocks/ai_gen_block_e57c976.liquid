{% doc %}
  @prompt
    Create a horizontal navigation bar with rounded pill-shaped category buttons. Each button should have a thin border, light background, and uppercase text. Spacing between buttons should be consistent. The last button ("Shop All") should be filled with a dark background and white text to act as a primary CTA. Use a clean, minimal, premium aesthetic similar to modern skincare brands., he layout must support adding or removing pills without breaking. Keep all pills in a single row with horizontal scrolling if needed. Each pill should have rounded edges, a thin border, uppercase text, and consistent spacing. Prevent pills from wrapping or shrinking.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-nav-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.vertical_padding }}px 0;
    overflow: hidden;
  }

  .ai-category-nav-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;
    gap: {{ block.settings.button_spacing }}px;
    align-items: center;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
    padding-bottom: 4px;
  }

  .ai-category-nav-container-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 6px;
  }

  .ai-category-nav-container-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-category-nav-container-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 3px;
  }

  .ai-category-nav-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    text-transform: uppercase;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-category-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-category-nav-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_background }};
    color: {{ block.settings.primary_button_text_color }};
    border-color: {{ block.settings.primary_button_border_color }};
  }

  .ai-category-nav-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_background }};
    color: {{ block.settings.primary_button_hover_text_color }};
    border-color: {{ block.settings.primary_button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-category-nav-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.85 }}px {{ block.settings.button_padding_horizontal | times: 0.85 }}px;
    }
  }
{% endstyle %}

<category-navigation-{{ ai_gen_id }}
  class="ai-category-nav-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-category-nav-container-{{ ai_gen_id }}">
    {% if block.settings.category_1_text != blank %}
      <a
        href="{{ block.settings.category_1_link }}"
        class="ai-category-nav-button-{{ ai_gen_id }}"
      >
        {{ block.settings.category_1_text }}
      </a>
