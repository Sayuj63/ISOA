      >
        {{ block.settings.category_3_text }}
      </a>
    {% endif %}

    {% if block.settings.category_4_text != blank %}
      <a
        href="{{ block.settings.category_4_link }}"
        class="ai-category-nav-button-{{ ai_gen_id }}"
      >
        {{ block.settings.category_4_text }}
      </a>
    {% endif %}

    {% if block.settings.category_5_text != blank %}
