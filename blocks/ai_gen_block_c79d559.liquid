{% doc %}
  @prompt
    Create a horizontal navigation bar with rounded pill-shaped category buttons. Each button should have a thin border, light background, and uppercase text. Spacing between buttons should be consistent. The last button ("Shop All") should be filled with a dark background and white text to act as a primary CTA. Use a clean, minimal, premium aesthetic similar to modern skincare brands., he layout must support adding or removing pills without breaking. Keep all pills in a single row with horizontal scrolling if needed. Each pill should have rounded edges, a thin border, uppercase text, and consistent spacing. Prevent pills from wrapping or shrinking. and keep the pills centred aligned
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-nav-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-category-nav-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .ai-category-nav-scroll-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    max-width: 100%;
  }

  .ai-category-nav-scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-category-nav-list-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.pill_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
    width: max-content;
  }

  .ai-category-nav-item-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-category-nav-pill-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.pill_padding_vertical }}px {{ block.settings.pill_padding_horizontal }}px;
    background-color: {{ block.settings.pill_background }};
    color: {{ block.settings.pill_text_color }};
    border: {{ block.settings.pill_border_width }}px solid {{ block.settings.pill_border_color }};
    border-radius: {{ block.settings.pill_border_radius }}px;
    text-decoration: none;
    text-transform: uppercase;
    font-size: {{ block.settings.pill_font_size }}px;
    font-weight: {{ block.settings.pill_font_weight }};
    letter-spacing: {{ block.settings.pill_letter_spacing }}px;
    white-space: nowrap;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-category-nav-pill-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.pill_hover_background }};
    color: {{ block.settings.pill_hover_text_color }};
    border-color: {{ block.settings.pill_hover_border_color }};
  }

  .ai-category-nav-pill-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_pill_background }};
    color: {{ block.settings.primary_pill_text_color }};
    border-color: {{ block.settings.primary_pill_border_color }};
  }

  .ai-category-nav-pill-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_pill_hover_background }};
    color: {{ block.settings.primary_pill_hover_text_color }};
    border-color: {{ block.settings.primary_pill_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-category-nav-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-category-nav-pill-{{ ai_gen_id }} {
      font-size: {{ block.settings.pill_font_size | times: 0.9 }}px;
      padding: {{ block.settings.pill_padding_vertical | times: 0.9 }}px {{ block.settings.pill_padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

<category-nav-{{ ai_gen_id }} class="ai-category-nav-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-nav-wrapper-{{ ai_gen_id }}">
    <div class="ai-category-nav-scroll-{{ ai_gen_id }}">
      <ul class="ai-category-nav-list-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% liquid
            assign pill_enabled_key = 'pill_' | append: i | append: '_enabled'
            assign pill_text_key = 'pill_' | append: i | append: '_text'
            assign pill_link_key = 'pill_' | append: i | append: '_link'
            assign is_primary_key = 'pill_' | append: i | append: '_is_primary'

            assign pill_enabled = block.settings[pill_enabled_key]
            assign pill_text = block.settings[pill_text_key]
            assign pill_link = block.settings[pill_link_key]
            assign is_primary = block.settings[is_primary_key]
          %}

          {% if pill_enabled and pill_text != blank %}
            <li class="ai-category-nav-item-{{ ai_gen_id }}">
              <a
                href="{{ pill_link }}"
                class="ai-category-nav-pill-{{ ai_gen_id }} {% if is_primary %}ai-category-nav-pill-primary-{{ ai_gen_id }}{% endif %}"
              >
                {{ pill_text }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</category-nav-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryNav{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.scrollContainer = this.querySelector('.ai-category-nav-scroll-{{ ai_gen_id }}');
        this.setupScrollBehavior();
      }

      setupScrollBehavior() {
        if (!this.scrollContainer) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.scrollContainer.addEventListener('mousedown', (e) => {
          isDown = true;
          this.scrollContainer.style.cursor = 'grabbing';
          startX = e.pageX - this.scrollContainer.offsetLeft;
          scrollLeft = this.scrollContainer.scrollLeft;
        });

        this.scrollContainer.addEventListener('mouseleave', () => {
          isDown = false;
          this.scrollContainer.style.cursor = 'grab';
        });

        this.scrollContainer.addEventListener('mouseup', () => {
          isDown = false;
          this.scrollContainer.style.cursor = 'grab';
        });

        this.scrollContainer.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.scrollContainer.offsetLeft;
          const walk = (x - startX) * 2;
          this.scrollContainer.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('category-nav-{{ ai_gen_id }}', CategoryNav{{ ai_gen_id }});
  })();
</script>

