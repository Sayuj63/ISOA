{% liquid
  assign section_id = 'pill-navigation-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="pill-navigation"
  style="
    --pill-bg: {{ section.settings.background_color }};
    --pill-text: {{ section.settings.text_color }};
    --pill-border: {{ section.settings.border_color }};
    --pill-active-bg: {{ section.settings.active_background_color }};
    --pill-active-text: {{ section.settings.active_text_color }};
    --pill-active-border: {{ section.settings.active_border_color }};
    --pill-font-size: {{ section.settings.font_size }}px;
    --pill-border-width: {{ section.settings.border_width }}px;
    --pill-radius: {{ section.settings.border_radius }}px;
    --pill-padding-x: {{ section.settings.padding_horizontal }}px;
    --pill-padding-y: {{ section.settings.padding_vertical }}px;
    --pill-gap: {{ section.settings.gap }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="pill-navigation__wrapper">
    <div class="pill-navigation__scroll">

      {% for block in section.blocks %}
        {% assign is_active = false %}

        {% if block.settings.active %}
          {% assign is_active = true %}
        {% endif %}

        <a
          href="{{ block.settings.link | default: '#' }}"
          class="
            pill-navigation__item
            {% if is_active %}pill-navigation__item--active{% endif %}
          "
          {% if block.settings.open_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </a>
      {% endfor %}

    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    width: 100%;
    background: var(--pill-bg);
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    box-sizing: border-box;
  }

  #{{ section_id }} .pill-navigation__wrapper {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  #{{ section_id }} .pill-navigation__scroll {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--pill-gap);
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 20px;
    box-sizing: border-box;

    /* Hide scrollbar */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #{{ section_id }} .pill-navigation__scroll::-webkit-scrollbar {
    display: none;
  }

  #{{ section_id }} .pill-navigation__item {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 0;

    padding: var(--pill-padding-y) var(--pill-padding-x);

    border: var(--pill-border-width) solid var(--pill-border);
    border-radius: var(--pill-radius);

    background: var(--pill-bg);
    color: var(--pill-text);

    font-size: var(--pill-font-size);
    font-weight: 400;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;

    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;

    box-sizing: border-box;
  }

  #{{ section_id }} .pill-navigation__item:hover {
    background: var(--pill-active-bg);
    color: var(--pill-active-text);
    border-color: var(--pill-active-border);
  }

  #{{ section_id }} .pill-navigation__item--active {
    background: var(--pill-active-bg);
    color: var(--pill-active-text);
    border-color: var(--pill-active-border);
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .pill-navigation__scroll {
      justify-content: flex-start;
      padding-left: 16px;
      padding-right: 16px;
    }

    #{{ section_id }} .pill-navigation__item {
      font-size: max(13px, calc(var(--pill-font-size) - 1px));
    }
  }
</style>

{% schema %}
{
  "name": "Pill navigation",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between buttons",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Button horizontal padding",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Button vertical padding",
      "min": 3,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border thickness",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#686762"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#686762"
    },
    {
      "type": "color",
      "id": "active_background_color",
      "label": "Active / hover background",
      "default": "#686762"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Active / hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Active / hover border",
      "default": "#686762"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Navigation button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button text",
          "default": "Shop All"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "active",
          "label": "Active button",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pill navigation",
      "blocks": [
        {
          "type": "pill",
          "settings": {
            "label": "Featured"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Skin"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Lip + Cheek"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Sets"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "On The Go"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Award Winners"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Shop All",
            "active": true
          }
        }
      ]
    }
  ]
}
{% endschema %}