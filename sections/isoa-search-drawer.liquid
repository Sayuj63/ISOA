{% doc %}
  Rhode-style right-side search drawer.

  Opens from the header search icon instead of navigating to /search. The form
  is a plain GET to routes.search_url, so pressing Enter still runs a search —
  the drawer only replaces the landing page, not the search itself.

  Reference: rhodeskin.com `.Offcanvas--right .SearchMini`, measured 2026-09-17.
  Rhode also renders a "suggestions:" list of text links above the products;
  that block is deliberately omitted here (the product recommendations are the
  part that was asked for).

  @example
  {% section 'isoa-search-drawer' %}
{% enddoc %}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

{%- liquid
  assign rec_collection = section.settings.collection
  assign rec_limit = section.settings.products_limit
-%}

<dialog-component
  id="isoa-search-drawer"
  class="isoa-sd"
  {{ section.shopify_attributes }}
>
  <dialog
    ref="dialog"
    class="isoa-sd__panel isoa-drawer dialog-modal dialog-drawer"
    scroll-lock
    aria-labelledby="isoa-search-drawer-title"
    on:click="/closeDialogOnClickOutside"
    on:keydown="/closeDialogOnEscapePress"
  >
    <div class="isoa-sd__head">
      <h2
        id="isoa-search-drawer-title"
        class="isoa-sd__title"
      >
        {{ 'content.search' | t }}
      </h2>
      <button
        type="button"
        class="isoa-sd__close"
        aria-label="{{ 'accessibility.close' | t }}"
        on:click="/closeDialog"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>

    <form
      class="isoa-sd__form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
    >
      <label
        for="isoa-search-drawer-input"
        class="visually-hidden"
      >
        {{ 'content.search_input_label' | t }}
      </label>
      <input
        id="isoa-search-drawer-input"
        class="isoa-sd__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Type here"
        autocomplete="off"
      >
    </form>

    {%- if rec_collection != blank and rec_collection.products_count > 0 -%}
      <div class="isoa-sd__rule"></div>

      <ul class="isoa-sd__products" role="list">
        {%- for product in rec_collection.products limit: rec_limit -%}
          <li>
            <a class="isoa-sd__product" href="{{ product.url }}">
              {%- if product.featured_image != blank -%}
                <span class="isoa-sd__product-image">
                  <img
                    src="{{ product.featured_image | image_url: width: 246 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="123"
                    height="123"
                    loading="lazy"
                  >
                </span>
              {%- endif -%}
              <span class="isoa-sd__product-title">{{ product.title }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </dialog>
</dialog-component>

{% schema %}
{
  "name": "Search drawer",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Recommended products"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
