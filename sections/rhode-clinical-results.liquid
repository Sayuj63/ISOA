{%- assign image_size_desktop = '' -%}
{%- if section.settings.image_size != blank and section.settings.image_size != 'fill' -%}
  {%- capture image_size_desktop -%}{%- render 'isoa-image-ratio', ratio: section.settings.image_size, image: section.settings.portrait, custom_width: section.settings.image_size_w, custom_height: section.settings.image_size_h, fallback: '220 / 240' -%}{%- endcapture -%}
{%- endif -%}
{%- capture image_size_mobile -%}{%- render 'isoa-image-ratio', ratio: section.settings.image_size_mobile, image: section.settings.portrait, custom_width: section.settings.image_size_mobile_w, custom_height: section.settings.image_size_mobile_h, fallback: '220 / 240' -%}{%- endcapture -%}
<style>
  .section-{{ section.id }} {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .section-{{ section.id }}-inner {
    max-width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .rh-clin-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--rhode-pdp-gap, 16px);
  }

  .rh-clin-card-{{ section.id }},
  .rh-clin-image-{{ section.id }} {
    min-height: 480px;
    border-radius: 10px;
    overflow: hidden;
  }

  .rh-clin-card-{{ section.id }} {
    background: #f1f0ed;
    padding: 32px 40px;
    display: flex;
    flex-direction: column;
    color: #67645e;
  }

  .rh-clin-heading-{{ section.id }} {
    font-family: var(--font-heading--family);
    font-style: normal;
    font-weight: 500;
    font-size: var(--isoa-display-lg);
    line-height: 1.05;
    letter-spacing: 0;
    text-transform: lowercase;
    margin: 0 0 32px 0;
    color: transparent;
    -webkit-text-stroke: 1px #e29fc8;
  }

  .rh-clin-bullets-{{ section.id }} {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .rh-clin-bullets-{{ section.id }} li {
    font-size: var(--isoa-body-md);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #67645e;
    line-height: 1.35;
    padding-left: 18px;
    position: relative;
  }

  .rh-clin-bullets-{{ section.id }} li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #67645e;
  }

  .rh-clin-footnote-{{ section.id }} {
    margin-top: 24px;
    font-size: 13px;
    color: #67645e;
    line-height: 1.5;
  }

  .rh-clin-footnote-{{ section.id }} p {
    margin: 0;
  }

  .rh-clin-tabs-{{ section.id }} {
    margin-top: auto;
    padding-top: 24px;
    border-top: 1px solid rgba(103, 100, 94, 0.2);
  }

  .rh-clin-row-{{ section.id }} {
    border-bottom: 1px solid rgba(103, 100, 94, 0.2);
  }

  .rh-clin-row-{{ section.id }}:last-child {
    border-bottom: 0;
  }

  .rh-clin-row-head-{{ section.id }} {
    width: 100%;
    background: transparent;
    border: 0;
    padding: 14px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--isoa-body-md);
    font-weight: 500;
    color: #67645e;
    text-transform: lowercase;
    text-align: left;
  }

  .rh-clin-row-chevron-{{ section.id }} {
    transition: transform 0.25s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
  }

  .rh-clin-row-{{ section.id }}.is-open .rh-clin-row-chevron-{{ section.id }} {
    transform: rotate(180deg);
  }

  .rh-clin-row-body-{{ section.id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease, padding 0.25s ease;
    color: #67645e;
    font-size: var(--isoa-body-md);
    line-height: 1.5;
  }

  .rh-clin-row-{{ section.id }}.is-open .rh-clin-row-body-{{ section.id }} {
    max-height: 600px;
    padding: 0 0 20px 0;
  }

  .rh-clin-image-{{ section.id }} {
    background: #e5e3df;
    position: relative;
  }

  .rh-clin-image-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  {%- if image_size_desktop != blank %}
  /* "Image size (desktop)" picked: those proportions instead of the text
     card's height. */
  @media (min-width: 750px) {
    .rh-clin-image-{{ section.id }} {
      align-self: center;
      min-height: 0;
      width: 100%;
      aspect-ratio: {{ image_size_desktop | strip }};
      /* Never taller than the hero, whatever proportions are picked. */
      max-height: var(--rhode-pdp-h, 720px);
    }
  }
  {%- endif %}


  .rh-clin-panel-{{ section.id }} { display: none; }
  .rh-clin-panel-{{ section.id }}.is-active { display: flex; flex: 1; flex-direction: column; }
  /* Sizes below follow rhodeskin.com's spotwear PDP at 1440. */
  .rh-clin-consumer-label-{{ section.id }} {
    width: fit-content;
    margin: 0 0 36px;
    padding-bottom: 8px;
    border-bottom: 1px solid #67645e;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .rh-clin-stats-{{ section.id }} { display: grid; gap: 34px; }
  .rh-clin-stat-{{ section.id }} { margin: 0; }
  /* Percentage — pink fill with a thin dark outline, as on Rhode. The
     stroke is painted under the fill (paint-order) so it stays 1px thin. */
  .rh-clin-stat-{{ section.id }} strong {
    display: block;
    font-family: var(--font-heading--family);
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    color: #e29fc8;
    -webkit-text-stroke: 1px #67645e;
    paint-order: stroke fill;
    letter-spacing: -0.01em;
  }
  .rh-clin-stat-{{ section.id }} span {
    display: block;
    margin-top: 6px;
    font-size: 1rem;              /* 16px, up from 12px */
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
    color: #67645e;
    letter-spacing: 0.02em;
  }
  .rh-clin-panel-{{ section.id }} .rh-clin-footnote-{{ section.id }} { margin-top: auto; padding-top: 32px; }
  /* Community tab: one customer's words, large, as on Rhode. */
  .rh-clin-quote-{{ section.id }} { margin: 0; }
  .rh-clin-quote-{{ section.id }} p {
    margin: 0;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .rh-clin-quote-{{ section.id }} cite {
    display: block;
    margin-top: 20px;
    font-size: 16px;
    font-style: normal;
  }
  @media (max-width: 749px) {
    .rh-clin-quote-{{ section.id }} p { font-size: 22px; }
    .rh-clin-quote-{{ section.id }} cite { margin-top: 14px; font-size: 14px; }
  }
  .rh-clin-tablist-{{ section.id }} {
    display: grid;
    margin-top: 22px;
    border-top: 1px solid rgba(103, 100, 94, .25);
  }
  .rh-clin-tab-{{ section.id }} {
    border: 0;
    border-bottom: 1px solid rgba(103, 100, 94, .25);
    background: transparent;
    padding: 20px 0;
    color: #67645e;
    opacity: 0.55;
    cursor: pointer;
    font: 600 26px/1 var(--font-heading--family);
    text-align: left;
    text-transform: lowercase;
    transition: opacity 0.25s ease;
  }
  /* The tab you're on is full strength; the other reads lighter. */
  .rh-clin-tab-{{ section.id }}[aria-selected='true'],
  .rh-clin-tab-{{ section.id }}:hover { opacity: 1; }
  .rh-clin-tab-{{ section.id }}:last-child { border-bottom: 0; }

  @media (max-width: 749px) {
    /* Mobile: image first (top), content card below, gap: 0 so they read as
       one continuous pill. Only outer corners rounded — image top, card
       bottom. Mirrors ss-image-with-text-15's mobile pattern. */
    .rh-clin-grid-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .rh-clin-card-{{ section.id }},
    .rh-clin-image-{{ section.id }} {
      min-height: 0;
    }
    .rh-clin-card-{{ section.id }} {
      padding: 20px 20px 24px;
      order: 2;
      border-radius: 0 0 10px 10px;
    }
    .rh-clin-image-{{ section.id }} {
      order: 1;
      width: 100%;
      aspect-ratio: {{ image_size_mobile | strip }};
      /* A tall pick crops rather than filling more than the screen. */
      max-height: 75vh;
      max-height: 75svh;
      border-radius: 10px 10px 0 0;
    }
    .rh-clin-heading-{{ section.id }} {
      font-size: var(--isoa-display-lg-m);
      margin-bottom: 16px;
    }
    .rh-clin-stats-{{ section.id }} { gap: 22px; }
    .rh-clin-stat-{{ section.id }} strong { font-size: 32px; }
    .rh-clin-stat-{{ section.id }} span { font-size: 0.9375rem; }   /* 15px on mobile */
    .rh-clin-bullets-{{ section.id }} { gap: 12px; }
    .rh-clin-panel-{{ section.id }} .rh-clin-footnote-{{ section.id }} { margin-top: 14px; padding-top: 12px; }
    .rh-clin-tab-{{ section.id }} { padding: 14px 0; font-size: 20px; }
    .rh-clin-stats-{{ section.id }} { gap: 26px; }
    .rh-clin-tablist-{{ section.id }} { margin-top: 14px; }
    .rh-clin-consumer-label-{{ section.id }} { margin: 0 0 22px; font-size: 14px; }
  }
</style>

<section class="section-{{ section.id }}" aria-label="{{ section.settings.heading | default: 'clinical results' }}">
  <div class="section-{{ section.id }}-inner">
    <div class="rh-clin-grid-{{ section.id }}">
      <div class="rh-clin-card-{{ section.id }}">
        {%- liquid
          assign bullet_blocks = section.blocks | where: 'type', 'bullet'
          assign consumer_stats = section.blocks | where: 'type', 'consumer_stat'
          assign community_stats = section.blocks | where: 'type', 'community_stat'
          assign show_community = false
          if section.settings.tab3_label != blank
            if community_stats.size > 0 or section.settings.community_quote != blank
              assign show_community = true
            endif
          endif
        -%}
        <div class="rh-clin-panel-{{ section.id }} is-active" data-rh-clin-panel="consumer" role="tabpanel">
          {%- comment -%}
            Without consumer_stat blocks the section keeps the copy it shipped
            with (the Spotwear patch study), so existing pages don't change.
            Add blocks to give each product its own figures.
          {%- endcomment -%}
          {%- if consumer_stats.size > 0 -%}
            {%- if section.settings.consumer_label != blank -%}
              <p class="rh-clin-consumer-label-{{ section.id }}">{{ section.settings.consumer_label }}</p>
            {%- endif -%}
            <div class="rh-clin-stats-{{ section.id }}">
              {%- for block in consumer_stats -%}
                <p class="rh-clin-stat-{{ section.id }}" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.text }}</span></p>
              {%- endfor -%}
            </div>
            {%- if section.settings.consumer_footnote != blank -%}
              <div class="rh-clin-footnote-{{ section.id }}">{{ section.settings.consumer_footnote }}</div>
            {%- endif -%}
          {%- else -%}
            <p class="rh-clin-consumer-label-{{ section.id }}">After 8 hours</p>
            <div class="rh-clin-stats-{{ section.id }}">
              <p class="rh-clin-stat-{{ section.id }}"><strong>100%</strong><span>Agreed the patch stayed on all day and felt comfortable to wear</span></p>
              <p class="rh-clin-stat-{{ section.id }}"><strong>100%</strong><span>Agreed the patch helped absorb excess oil</span></p>
              <p class="rh-clin-stat-{{ section.id }}"><strong>94%</strong><span>Agreed the patch helped minimize the look of their spot</span></p>
              <p class="rh-clin-stat-{{ section.id }}"><strong>90%</strong><span>Agreed their spot looked smaller, flatter, and less red</span></p>
            </div>
            <div class="rh-clin-footnote-{{ section.id }}"><p>*Based on a 31-subject consumer perception study after 8 hours of use.</p></div>
          {%- endif -%}
        </div>
        <div class="rh-clin-panel-{{ section.id }}" data-rh-clin-panel="clinical" role="tabpanel" hidden>
          <h2 class="rh-clin-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
          <ul class="rh-clin-bullets-{{ section.id }}">
            {%- for block in bullet_blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
          </ul>
          <div class="rh-clin-footnote-{{ section.id }}">{{ section.settings.footnote }}</div>
        </div>
        {%- if show_community -%}
          <div class="rh-clin-panel-{{ section.id }}" data-rh-clin-panel="community" role="tabpanel" hidden>
            {%- if section.settings.community_label != blank -%}
              <p class="rh-clin-consumer-label-{{ section.id }}">{{ section.settings.community_label }}</p>
            {%- endif -%}
            {%- if section.settings.community_quote != blank -%}
              <blockquote class="rh-clin-quote-{{ section.id }}">
                <p>“{{ section.settings.community_quote }}”</p>
                {%- if section.settings.community_author != blank -%}
                  <cite>- {{ section.settings.community_author }}</cite>
                {%- endif -%}
              </blockquote>
            {%- endif -%}
            {%- if community_stats.size > 0 -%}
              <div class="rh-clin-stats-{{ section.id }}">
                {%- for block in community_stats -%}
                  <p class="rh-clin-stat-{{ section.id }}" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.text }}</span></p>
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if section.settings.community_footnote != blank -%}
              <div class="rh-clin-footnote-{{ section.id }}">{{ section.settings.community_footnote }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="rh-clin-tablist-{{ section.id }}" role="tablist" aria-label="Study result type">
          <button class="rh-clin-tab-{{ section.id }}" type="button" role="tab" aria-selected="true" data-rh-clin-tab="consumer">{{ section.settings.tab1_label }}</button>
          <button class="rh-clin-tab-{{ section.id }}" type="button" role="tab" aria-selected="false" data-rh-clin-tab="clinical">{{ section.settings.tab2_label }}</button>
          {%- if show_community -%}
            <button class="rh-clin-tab-{{ section.id }}" type="button" role="tab" aria-selected="false" data-rh-clin-tab="community">{{ section.settings.tab3_label }}</button>
          {%- endif -%}
        </div>
      </div>

      <div class="rh-clin-image-{{ section.id }}">
        {%- if section.settings.portrait != blank -%}
          {{ section.settings.portrait | image_url: width: 1400 | image_tag:
            loading: 'lazy',
            widths: '400,600,900,1200,1400',
            sizes: '(max-width: 749px) 100vw, 50vw',
            alt: section.settings.portrait.alt | default: 'clinical results portrait'
          }}
        {%- else -%}
          <img src="{{ 'spotwear-claims.jpg' | asset_url }}" alt="Person applying a Spotwear sticker" loading="lazy" width="220" height="240">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var scope = document.currentScript.previousElementSibling;
    if (!scope) return;
    var tabs = scope.querySelectorAll('[data-rh-clin-tab]');
    var panels = scope.querySelectorAll('[data-rh-clin-panel]');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var target = tab.getAttribute('data-rh-clin-tab');
        tabs.forEach(function (item) { item.setAttribute('aria-selected', item === tab ? 'true' : 'false'); });
        panels.forEach(function (panel) {
          var active = panel.getAttribute('data-rh-clin-panel') === target;
          panel.classList.toggle('is-active', active);
          panel.hidden = !active;
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Rhode Clinical Results",
  "tag": "section",
  "class": "rhode-clinical-results",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "clinical results"
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Portrait image (right column)"
    },
    { "type": "header", "content": "Image size" },
    { "type": "select", "id": "image_size", "label": "Image size (desktop)", "options": [
      { "value": "fill", "label": "Match text card" },
      { "value": "original", "label": "Original" },
      { "value": "square", "label": "Square" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" },
      { "value": "custom", "label": "Custom" }
    ], "default": "fill", "info": "Match text card keeps the image as tall as the text beside it." },
    { "type": "range", "id": "image_size_w", "label": "Custom width (desktop)", "min": 1, "max": 40, "step": 1, "default": 4, "visible_if": "{{ section.settings.image_size == 'custom' }}" },
    { "type": "range", "id": "image_size_h", "label": "Custom height (desktop)", "min": 1, "max": 40, "step": 1, "default": 5, "visible_if": "{{ section.settings.image_size == 'custom' }}" },
    { "type": "select", "id": "image_size_mobile", "label": "Image size (mobile)", "options": [
      { "value": "original", "label": "Original" },
      { "value": "square", "label": "Square" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" },
      { "value": "custom", "label": "Custom" }
    ], "default": "original" },
    { "type": "range", "id": "image_size_mobile_w", "label": "Custom width (mobile)", "min": 1, "max": 40, "step": 1, "default": 3, "visible_if": "{{ section.settings.image_size_mobile == 'custom' }}" },
    { "type": "range", "id": "image_size_mobile_h", "label": "Custom height (mobile)", "min": 1, "max": 40, "step": 1, "default": 2, "visible_if": "{{ section.settings.image_size_mobile == 'custom' }}" },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote (small italic line)",
      "default": "<p>*Based on a 53-subject clinical study after immediate and 12 hours of use.</p>"
    },
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab1_label",
      "label": "Tab 1 label",
      "default": "consumer study results"
    },
    {
      "type": "richtext",
      "id": "tab1_content",
      "label": "Tab 1 content",
      "default": "<p>Consumer study details go here.</p>"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab2_label",
      "label": "Tab 2 label",
      "default": "clinical results"
    },
    {
      "type": "richtext",
      "id": "tab2_content",
      "label": "Tab 2 content",
      "default": "<p>Clinical study details go here.</p>"
    },
    {
      "type": "header",
      "content": "Consumer study (tab 1)",
      "info": "Add 'Consumer study stat' blocks to replace the default Spotwear figures."
    },
    {
      "type": "text",
      "id": "consumer_label",
      "label": "Label above the figures",
      "default": "After 8 hours"
    },
    {
      "type": "richtext",
      "id": "consumer_footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "Community results (tab 3)",
      "info": "The tab shows once it has a label and a customer quote or at least one 'Community result' block."
    },
    {
      "type": "text",
      "id": "tab3_label",
      "label": "Tab 3 label",
      "default": "community results"
    },
    {
      "type": "textarea",
      "id": "community_quote",
      "label": "Customer quote",
      "info": "A real customer's words, without quotation marks."
    },
    {
      "type": "text",
      "id": "community_author",
      "label": "Customer name"
    },
    {
      "type": "text",
      "id": "community_label",
      "label": "Label above the figures"
    },
    {
      "type": "richtext",
      "id": "community_footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "consumer_stat",
      "name": "Consumer study stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Figure", "default": "100%" },
        { "type": "text", "id": "text", "label": "Statement", "default": "Agreed skin felt hydrated" }
      ]
    },
    {
      "type": "community_stat",
      "name": "Community result",
      "settings": [
        { "type": "text", "id": "value", "label": "Figure", "default": "100%" },
        { "type": "text", "id": "text", "label": "Statement", "default": "Said they would recommend it" }
      ]
    },
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "PROVIDES ALL-DAY HYDRATION"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rhode Clinical Results",
      "blocks": [
        { "type": "bullet", "settings": { "text": "PROVIDES ALL-DAY HYDRATION" } },
        { "type": "bullet", "settings": { "text": "REDUCES THE APPEARANCE OF REDNESS OVER TIME" } }
      ]
    }
  ]
}
{% endschema %}
