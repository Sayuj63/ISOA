<style>
  .section-{{ section.id }} {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .section-{{ section.id }}-inner {
    max-width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  /* Outer wrapper — bare (no bg). Image and card are separate visual units
     laid out in a 2-column grid on desktop, stacked on mobile. */
  .rh-prep-{{ section.id }} {
    color: #67645e;
  }

  .rh-prep-layout-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  /* Image column: own viewport + track, slides in sync with the card via a
     shared `--rh-prep-active` custom property on the section root. */
  .rh-prep-image-viewport-{{ section.id }} {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    background: #eceae7;
    aspect-ratio: 1 / 1;
  }
  .rh-prep-image-track-{{ section.id }} {
    display: flex;
    width: calc(var(--rh-prep-n, 1) * 100%);
    height: 100%;
    transform: translateX(calc(var(--rh-prep-active, 0) * -100% / var(--rh-prep-n, 1)));
    transition: transform 1s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }
  .rh-prep-image-slide-{{ section.id }} {
    flex: 0 0 calc(100% / var(--rh-prep-n, 1));
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .rh-prep-image-slide-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Card column — the grey text card. */
  .rh-prep-card-{{ section.id }} {
    min-width: 0;
    background: #f1f0ed;
    border-radius: 10px;
    padding: 28px 40px;
  }

  .rh-prep-circles-{{ section.id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-bottom: 20px;
  }

  .rh-prep-circle-{{ section.id }} {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: transparent;
    color: #67645e;
    border: 1px solid #67645e;
    font-family: var(--font-body--family);
    font-size: var(--isoa-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    line-height: 1.1;
    opacity: 0.5;
    transition: background 0.7s cubic-bezier(0.76, 0, 0.24, 1), color 0.7s cubic-bezier(0.76, 0, 0.24, 1), opacity 0.7s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .rh-prep-circle-{{ section.id }}[aria-pressed='true'] {
    opacity: 1;
    background: #67645e;
    color: #fff;
    border-color: #67645e;
  }

  /* Panels sit in a horizontal flex track that translates by one panel-
     width per step. Container clips overflow so only the active panel is
     visible; hover (desktop) or click (mobile) drives the swap. */
  .rh-prep-viewport-{{ section.id }} {
    position: relative;
    overflow: hidden;
  }
  .rh-prep-track-{{ section.id }} {
    display: flex;
    width: calc(var(--rh-prep-n, 1) * 100%);
    transform: translateX(calc(var(--rh-prep-active, 0) * -100% / var(--rh-prep-n, 1)));
    transition: transform 1s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
    align-items: flex-start;
  }
  .rh-prep-panel-{{ section.id }} {
    flex: 0 0 calc(100% / var(--rh-prep-n, 1));
    min-width: 0;
  }

  .rh-prep-title-{{ section.id }} {
    font-family: var(--font-heading--family);
    font-style: normal;
    font-weight: 800;
    /* Match the compact PDP feature-heading tier (On the Go / Packaging). */
    font-size: 28px;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: lowercase;
    margin: 0 0 8px 0;
    color: #67645e;
  }

  .rh-prep-subtitle-{{ section.id }} {
    font-family: var(--font-body--family);
    font-size: var(--isoa-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #67645e;
    margin: 0 0 20px 0;
  }

  .rh-prep-divider-{{ section.id }} {
    height: 1px;
    background: rgba(103, 100, 94, 0.15);
    margin: 0;
    border: 0;
  }

  .rh-prep-rows-{{ section.id }} {
    display: flex;
    flex-direction: column;
  }

  .rh-prep-row-{{ section.id }} {
    padding: 12px 0;
    border-bottom: 1px solid rgba(103, 100, 94, 0.15);
  }

  .rh-prep-row-{{ section.id }}:last-child {
    border-bottom: 0;
  }

  .rh-prep-row-label-{{ section.id }} {
    font-family: var(--font-body--family);
    font-size: var(--isoa-eyebrow);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #67645e;
    margin: 0 0 8px 0;
  }

  .rh-prep-row-content-{{ section.id }} {
    font-family: var(--font-body--family);
    font-size: var(--isoa-body-md);
    line-height: 1.5;
    color: #67645e;
    margin: 0;
  }

  /* Per-step BUY pill (Rhode's glazing milk routine): adds that step's
     product to the cart without leaving the page. */
  .rh-prep-title-row-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .rh-prep-buy-wrap--mobile {
    display: none;
  }
  .rh-prep-buy-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: 33px;
    padding: 4px 28px;
    white-space: nowrap;
    border: 1px solid #67645e;
    border-radius: 999px;
    background: transparent;
    color: #67645e;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .rh-prep-buy-{{ section.id }}:hover,
  .rh-prep-buy-{{ section.id }}.is-added {
    background: #67645e;
    color: #f1f0ed;
  }
  .rh-prep-buy-{{ section.id }}[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  @media (min-width: 750px) {
    /* Desktop: image left, card right — 2-col grid. Aspect keeps the image
       tall enough to feel like a hero product shot next to the card. */
    .rh-prep-layout-{{ section.id }} {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .rh-prep-image-viewport-{{ section.id }} {
      aspect-ratio: auto;
      align-self: stretch;
    }
  }

  @media (max-width: 749px) {
    /* Mobile merge: image on top (round top only) + card below (round bottom
       only), zero gap between them — same pattern as the other split
       sections on the PDP. */
    .rh-prep-layout-{{ section.id }} {
      gap: 0;
    }
    .rh-prep-image-viewport-{{ section.id }} {
      border-radius: 10px 10px 0 0;
      aspect-ratio: var(--rh-prep-ratio-mobile, 2 / 1);
    }
    .rh-prep-card-{{ section.id }} {
      border-radius: 0 0 10px 10px;
      padding: 14px 18px 16px;
    }
    .rh-prep-buy-wrap--desktop {
      display: none;
    }
    .rh-prep-buy-wrap--mobile {
      display: block;
      margin-top: 12px;
    }
    .rh-prep-buy-{{ section.id }} {
      min-height: 30px;
      font-size: 12px;
    }
    .rh-prep-circle-{{ section.id }} {
      width: 60px;
      height: 60px;
      /* 2026-08-12: was --isoa-eyebrow-m (11px) → long labels like
         "HIGHLIGHT" (9 chars @ 0.06em letter-spacing) overflowed the 60px
         circle boundary. 9px font + tighter letter-spacing 0.02em keeps
         the widest label ("HIGHLIGHT" ~48px) comfortably inside the circle. */
      font-size: 9px;
      letter-spacing: 0.02em;
      padding: 0 6px;
    }
    .rh-prep-circles-{{ section.id }} {
      margin-bottom: 12px;
      gap: 16px;
    }
    .rh-prep-title-{{ section.id }} {
      font-size: var(--isoa-display-md-m);
    }
    .rh-prep-subtitle-{{ section.id }} {
      margin: 0 0 12px 0;
    }
    .rh-prep-row-{{ section.id }} {
      padding: 8px 0;
    }
    .rh-prep-row-label-{{ section.id }} {
      margin: 0 0 4px 0;
    }
    .rh-prep-row-content-{{ section.id }} {
      font-size: var(--isoa-body-sm-m);
    }
  }
</style>

{%- assign step_blocks = section.blocks | where: 'type', 'step' | sort: 'settings.index' -%}
{%- capture ratio_mobile -%}
  {%- render 'isoa-image-ratio', ratio: section.settings.image_ratio_mobile, image: step_blocks.first.settings.image, custom_width: section.settings.image_ratio_mobile_w, custom_height: section.settings.image_ratio_mobile_h, fallback: '2 / 1' -%}
{%- endcapture -%}

<section class="section-{{ section.id }}" aria-label="prep toggle">
  <div class="section-{{ section.id }}-inner">
    <div class="rh-prep-{{ section.id }}" data-rh-prep-root style="--rh-prep-n: {{ step_blocks.size }}; --rh-prep-active: 0; --rh-prep-ratio-mobile: {{ ratio_mobile | strip }};">
      <div class="rh-prep-layout-{{ section.id }}">

        <!-- Image column: own track, slides in sync with the content track. -->
        <div class="rh-prep-image-viewport-{{ section.id }}">
          <div class="rh-prep-image-track-{{ section.id }}">
            {%- for step in step_blocks -%}
              <div class="rh-prep-image-slide-{{ section.id }}" data-rh-prep-image="{{ step.settings.index }}">
                {%- if step.settings.image != blank -%}
                  {{ step.settings.image | image_url: width: 1600 | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800,1000,1200,1400,1600',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    alt: step.settings.image.alt | default: step.settings.title
                  }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <!-- Card column: circles + sliding content track. -->
        <div class="rh-prep-card-{{ section.id }}">
          <div class="rh-prep-circles-{{ section.id }}">
            {%- for step in step_blocks -%}
              <button
                type="button"
                class="rh-prep-circle-{{ section.id }}"
                data-rh-prep-step="{{ step.settings.index }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                {{ step.shopify_attributes }}
              >{{ step.settings.label }}</button>
            {%- endfor -%}
          </div>

          <div class="rh-prep-viewport-{{ section.id }}">
            <div class="rh-prep-track-{{ section.id }}" data-rh-prep-track>
              {%- for step in step_blocks -%}
                {%- assign sidx = step.settings.index -%}
                <div class="rh-prep-panel-{{ section.id }}" data-rh-prep-panel="{{ sidx }}">
                  {%- liquid
                    assign step_product = step.settings.product
                    assign show_buy = false
                    if step_product != blank and step_product.id != product.id
                      assign show_buy = true
                      assign step_variant = step_product.selected_or_first_available_variant
                      assign step_name = step_product.metafields.custom.card_short_name | default: step_product.title
                    endif
                  -%}
                  {%- capture buy_button -%}
                    {%- if show_buy -%}
                      <button
                        type="button"
                        class="rh-prep-buy-{{ section.id }}"
                        data-rh-prep-buy="{{ step_variant.id }}"
                        {% unless step_variant.available %}disabled{% endunless %}
                        aria-label="Add {{ step_product.title | escape }} to cart"
                      >
                        {%- if step_variant.available -%}
                          {{ 'BUY ' | append: step_name | upcase }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </button>
                    {%- endif -%}
                  {%- endcapture -%}
                  <div class="rh-prep-title-row-{{ section.id }}">
                    <h2 class="rh-prep-title-{{ section.id }}">{{ step.settings.title }}</h2>
                    {%- if show_buy -%}<div class="rh-prep-buy-wrap-{{ section.id }} rh-prep-buy-wrap--desktop">{{ buy_button }}</div>{%- endif -%}
                  </div>
                  <p class="rh-prep-subtitle-{{ section.id }}">{{ step.settings.subtitle }}</p>
                  <hr class="rh-prep-divider-{{ section.id }}" />

                  <div class="rh-prep-rows-{{ section.id }}">
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'row' and block.settings.step_index == sidx -%}
                        <div class="rh-prep-row-{{ section.id }}" {{ block.shopify_attributes }}>
                          <p class="rh-prep-row-label-{{ section.id }}">{{ block.settings.label }}</p>
                          <p class="rh-prep-row-content-{{ section.id }}">{{ block.settings.content }}</p>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>

                  {%- if show_buy -%}<div class="rh-prep-buy-wrap-{{ section.id }} rh-prep-buy-wrap--mobile">{{ buy_button }}</div>{%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var scope = document.currentScript.previousElementSibling;
    if (!scope) return;
    var root = scope.querySelector('[data-rh-prep-root]');
    if (!root) return;
    var buttons = Array.from(root.querySelectorAll('[data-rh-prep-step]'));
    var isDesktop = window.matchMedia('(min-width: 750px)');

    // Circles, image slides and panels are rendered in the same order, so a
    // circle's position is its slide's position in both tracks.
    function setActive(position) {
      root.style.setProperty('--rh-prep-active', String(position));
      buttons.forEach(function (b, i) {
        b.setAttribute('aria-pressed', i === position ? 'true' : 'false');
      });
    }

    buttons.forEach(function (btn, position) {
      // Desktop: hover activates + slides. Mobile: tap fires click.
      btn.addEventListener('mouseenter', function () {
        if (isDesktop.matches) setActive(position);
      });
      btn.addEventListener('click', function () { setActive(position); });
      btn.addEventListener('focus', function () { setActive(position); });
    });

    // BUY pills: add the step's product, refresh the header count and open
    // the cart drawer, the same way the Complete Your Routine block does.
    root.querySelectorAll('[data-rh-prep-buy]').forEach(function (buy) {
      buy.addEventListener('click', function () {
        var label = buy.innerHTML;
        buy.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(buy.dataset.rhPrepBuy), quantity: 1 }] })
        })
          .then(function (res) { if (!res.ok) throw new Error(res.status); return fetch('/cart.js'); })
          .then(function (res) { return res.json(); })
          .then(function (cart) {
            var drawerItems = document.querySelector('#isoa-cart-drawer cart-items-component') || document.querySelector('cart-items-component');
            document.dispatchEvent(new CustomEvent('cart:update', {
              bubbles: true,
              detail: {
                resource: cart,
                sourceId: (drawerItems && drawerItems.dataset.sectionId) || 'rhode-prep',
                data: { itemCount: cart.item_count, source: 'rhode-prep' }
              }
            }));
            var drawer = document.querySelector('#isoa-cart-drawer');
            if (drawer) {
              drawer.classList.add('is-open');
              document.body.classList.add('isoa-cd-open');
            }
            buy.classList.add('is-added');
            buy.textContent = 'ADDED';
          })
          .catch(function () { buy.textContent = 'TRY AGAIN'; })
          .finally(function () {
            setTimeout(function () {
              buy.classList.remove('is-added');
              buy.innerHTML = label;
              buy.disabled = false;
            }, 1600);
          });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Rhode Prep Toggle",
  "tag": "section",
  "class": "rhode-prep-toggle",
  "settings": [
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Image size on mobile",
      "options": [
        { "value": "original", "label": "Original" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom",
      "info": "Desktop images fill the column beside the text card. Original follows the first step's image."
    },
    { "type": "range", "id": "image_ratio_mobile_w", "label": "Custom width on mobile", "min": 1, "max": 40, "step": 1, "default": 2, "visible_if": "{{ section.settings.image_ratio_mobile == 'custom' }}" },
    { "type": "range", "id": "image_ratio_mobile_h", "label": "Custom height on mobile", "min": 1, "max": 40, "step": 1, "default": 1, "visible_if": "{{ section.settings.image_ratio_mobile == 'custom' }}" },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "index",
          "label": "Step index",
          "options": [
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" },
            { "value": "5", "label": "5" }
          ],
          "default": "1"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Circle label",
          "default": "HIGHLIGHT"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "highlight milk"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "MULTIPURPOSE LUMINIZER"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image (slides in when active)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product to buy",
          "info": "Shows a BUY button with this product's price under the step."
        }
      ]
    },
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "select",
          "id": "step_index",
          "label": "Belongs to step",
          "options": [
            { "value": "1", "label": "Step 1" },
            { "value": "2", "label": "Step 2" },
            { "value": "3", "label": "Step 3" },
            { "value": "4", "label": "Step 4" },
            { "value": "5", "label": "Step 5" }
          ],
          "default": "1"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "WHAT IT IS"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Row content",
          "default": "A hybrid luminizer that enhances bare skin and makeup with a shimmery, naturally luminous finish."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rhode Prep Toggle",
      "blocks": [
        { "type": "step", "settings": { "index": "1", "label": "HIGHLIGHT", "title": "highlight milk", "subtitle": "MULTIPURPOSE LUMINIZER" } },
        { "type": "step", "settings": { "index": "2", "label": "PREP", "title": "prep hydrator", "subtitle": "HYDRATING SKIN PRIMER" } },
        { "type": "row", "settings": { "step_index": "1", "label": "WHAT IT IS", "content": "A hybrid luminizer that enhances bare skin and makeup with a shimmery, naturally luminous finish." } },
        { "type": "row", "settings": { "step_index": "1", "label": "BENEFITS", "content": "• Provides all-day hydration • Leaves skin looking luminous with a soft, pearly finish" } },
        { "type": "row", "settings": { "step_index": "1", "label": "WHERE IT FITS IN YOUR ROUTINE", "content": "On its own on bare skin, mixed into makeup, or layered with skincare and SPF." } },
        { "type": "row", "settings": { "step_index": "1", "label": "THE EFFECT", "content": "Hydrated, glowy skin with a pearly finish" } },
        { "type": "row", "settings": { "step_index": "1", "label": "KEY INGREDIENTS", "content": "Ceramide Trio • Mineral Complex • Vitamin E • Glycerin" } },
        { "type": "row", "settings": { "step_index": "2", "label": "WHAT IT IS", "content": "A hydrating primer that preps skin with a smooth, dewy base for makeup or skincare." } },
        { "type": "row", "settings": { "step_index": "2", "label": "BENEFITS", "content": "• Deeply hydrates and plumps • Creates a smooth base that helps makeup wear better" } },
        { "type": "row", "settings": { "step_index": "2", "label": "WHERE IT FITS IN YOUR ROUTINE", "content": "After cleansing and serums, before SPF and makeup." } },
        { "type": "row", "settings": { "step_index": "2", "label": "THE EFFECT", "content": "Soft, dewy, primed skin" } },
        { "type": "row", "settings": { "step_index": "2", "label": "KEY INGREDIENTS", "content": "Hyaluronic Acid • Peptides • Niacinamide • Squalane" } }
      ]
    }
  ]
}
{% endschema %}
