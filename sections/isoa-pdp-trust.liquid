{% comment %}
  PDP reassurance, placed directly after the buy area: one grey panel with the
  claim badges on top and the delivery facts underneath. Only substantiated
  ISOUA claims should be added as badge blocks. Shipping copy comes from
  ISOUA's site policy.
{% endcomment %}

{%- liquid
  # Expected delivery is printed as real dates. Liquid computes them at render
  # time (in the shop's timezone) so crawlers and no-JS visitors see dates; the
  # script below recomputes on the visitor's clock because Shopify caches pages.
  assign min_days = section.settings.delivery_min
  assign max_days = section.settings.delivery_max
  if max_days < min_days
    assign max_days = min_days
  endif
  assign skip_days = ''
  if section.settings.skip_sundays
    assign skip_days = skip_days | append: '0'
  endif
  if section.settings.skip_saturdays
    assign skip_days = skip_days | append: '6'
  endif

  assign ts = 'now' | date: '%s' | plus: 0
  assign counted = 0
  assign min_ts = ts
  assign max_ts = ts
  for i in (1..30)
    assign ts = ts | plus: 86400
    assign weekday = ts | date: '%w'
    unless skip_days contains weekday
      assign counted = counted | plus: 1
      if counted == min_days
        assign min_ts = ts
      endif
      if counted == max_days
        assign max_ts = ts
        break
      endif
    endunless
  endfor

  assign min_label = min_ts | date: '%a, %-d %b'
  assign max_label = max_ts | date: '%a, %-d %b'
  if min_label == max_label
    assign delivery_label = max_label
  else
    assign delivery_label = min_label | append: ' – ' | append: max_label
  endif

  # The offer card only earns its place when it says something the shipping
  # line does not.
  assign shipping_key = section.settings.shipping_text | downcase | remove: ' ' | remove: '.'
  assign offer_key = section.settings.offer_text | downcase | remove: ' ' | remove: '.' | remove: 'panindia'
  assign show_offer = false
  if section.settings.offer_text != blank and offer_key != shipping_key
    assign show_offer = true
  endif
-%}

{% style %}
  .isoa-pdp-trust-{{ section.id }} {
    color: #67645e;
    font-family: var(--font-body--family);
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__inner {
    max-width: min(calc(var(--page-width) - var(--page-margin) * 2), calc(100% - var(--page-margin) * 2));
    margin: 16px auto 0;
    padding: 28px 32px 0;
    border-radius: 10px;
    background: #f1f0ed;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badges {
    display: grid;
    grid-template-columns: repeat(var(--badge-count), minmax(0, 1fr));
    gap: 16px;
    padding-bottom: 26px;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-align: center;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__icon {
    display: block;
    width: 64px;
    height: 64px;
    flex: 0 0 auto;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badge-label {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__bottom {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    border-top: 1px solid #dad8d4;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 0;
    padding: 20px 16px;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__item + .isoa-pdp-trust__item {
    border-left: 1px solid #dad8d4;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__item-icon {
    display: grid;
    flex: 0 0 34px;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #67645e;
    color: #f1f0ed;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__item-icon svg {
    width: 18px;
    height: 18px;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__eyebrow {
    display: block;
    margin-bottom: 3px;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__value {
    display: block;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__value--caps {
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  @media (max-width: 749px) {
    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__inner {
      margin-top: 12px;
      padding: 20px 16px 0;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badges {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px 4px;
      padding-bottom: 20px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__icon {
      width: 52px;
      height: 52px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badge-label {
      font-size: 9px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__bottom {
      grid-auto-flow: row;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__item {
      justify-content: flex-start;
      padding: 14px 4px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__item + .isoa-pdp-trust__item {
      border-top: 1px solid #dad8d4;
      border-left: 0;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__item-icon {
      flex-basis: 30px;
      width: 30px;
      height: 30px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__item-icon svg {
      width: 16px;
      height: 16px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__value {
      font-size: 12px;
    }
  }
{% endstyle %}

{%- assign badge_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.settings.label != blank -%}{%- assign badge_count = badge_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}

<section class="isoa-pdp-trust-{{ section.id }}" aria-label="Product assurances">
  <div class="isoa-pdp-trust__inner">
    {%- if badge_count > 0 -%}
      <div class="isoa-pdp-trust__badges" style="--badge-count: {{ badge_count }};">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <div class="isoa-pdp-trust__badge" {{ block.shopify_attributes }}>
              {% render 'isoa-pdp-trust-icon', icon: block.settings.icon %}
              <span class="isoa-pdp-trust__badge-label">{{ block.settings.label | escape }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="isoa-pdp-trust__bottom">
      {%- if section.settings.shipping_text != blank -%}
        <div class="isoa-pdp-trust__item">
          <span class="isoa-pdp-trust__item-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 5h12v11H2zM14 9h4l3 3v4h-7z"/>
              <circle cx="6" cy="18" r="2"/>
              <circle cx="17" cy="18" r="2"/>
            </svg>
          </span>
          <div>
            <span class="isoa-pdp-trust__eyebrow">Delivery</span>
            <strong class="isoa-pdp-trust__value isoa-pdp-trust__value--caps">{{ section.settings.shipping_text | escape }}</strong>
          </div>
        </div>
      {%- endif -%}

      <div class="isoa-pdp-trust__item">
        <span class="isoa-pdp-trust__item-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="4" width="18" height="17" rx="2"/>
            <path d="M3 9h18M8 2v4M16 2v4"/>
          </svg>
        </span>
        <div>
          <span class="isoa-pdp-trust__eyebrow">Expected delivery</span>
          <strong
            class="isoa-pdp-trust__value"
            data-isoa-delivery
            data-min="{{ min_days }}"
            data-max="{{ max_days }}"
            data-skip="{{ skip_days }}"
          >{{ delivery_label }}</strong>
        </div>
      </div>

      {%- if show_offer -%}
        <div class="isoa-pdp-trust__item">
          <span class="isoa-pdp-trust__item-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 12V4h8l10 10-8 8L3 12Z"/>
              <circle cx="7.5" cy="8.5" r="1.2"/>
            </svg>
          </span>
          <div>
            <span class="isoa-pdp-trust__eyebrow">{{ section.settings.offer_tag | default: 'Offer' | escape }}</span>
            <strong class="isoa-pdp-trust__value">{{ section.settings.offer_text | escape }}</strong>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var el = document.querySelector('.isoa-pdp-trust-{{ section.id }} [data-isoa-delivery]');
    if (!el) return;
    var min = +el.dataset.min, max = +el.dataset.max, skip = el.dataset.skip;
    var d = new Date(), counted = 0, from = null, to = null;
    for (var i = 0; i < 30 && !to; i++) {
      d.setDate(d.getDate() + 1);
      if (skip.indexOf(String(d.getDay())) !== -1) continue;
      counted++;
      if (counted === min) from = new Date(d);
      if (counted === max) to = new Date(d);
    }
    if (!from || !to) return;
    var fmt = function (x) {
      return x.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
    };
    el.textContent = min === max ? fmt(to) : fmt(from) + ' – ' + fmt(to);
  })();
</script>

{% schema %}
{
  "name": "ISOUA PDP trust",
  "settings": [
    { "type": "text", "id": "shipping_text", "label": "Shipping message", "default": "Free shipping on prepaid orders" },
    { "type": "header", "content": "Expected delivery" },
    { "type": "range", "id": "delivery_min", "label": "Earliest delivery (working days)", "min": 1, "max": 14, "step": 1, "default": 5 },
    { "type": "range", "id": "delivery_max", "label": "Latest delivery (working days)", "min": 1, "max": 14, "step": 1, "default": 7 },
    { "type": "checkbox", "id": "skip_sundays", "label": "Sundays are not working days", "default": true },
    { "type": "checkbox", "id": "skip_saturdays", "label": "Saturdays are not working days", "default": false },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "offer_tag", "label": "Offer label", "default": "Offer" },
    { "type": "text", "id": "offer_text", "label": "Offer message", "info": "Hidden when empty or when it repeats the shipping message." }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Claim badge",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "vegan", "label": "Vegan" },
          { "value": "cruelty_free", "label": "Cruelty free" },
          { "value": "non_toxic", "label": "Non toxic" },
          { "value": "paraben_free", "label": "Paraben free" },
          { "value": "sulphate_free", "label": "Sulphate free" },
          { "value": "non_comedogenic", "label": "Non comedogenic" }
        ], "default": "vegan" },
        { "type": "text", "id": "label", "label": "Claim (publish only when verified)", "default": "Vegan" }
      ]
    }
  ],
  "presets": [
    { "name": "ISOUA PDP trust", "blocks": [
      { "type": "badge", "settings": { "icon": "vegan", "label": "Vegan" } },
      { "type": "badge", "settings": { "icon": "cruelty_free", "label": "Cruelty Free" } },
      { "type": "badge", "settings": { "icon": "non_comedogenic", "label": "Non Comedogenic" } }
    ] }
  ]
}
{% endschema %}
