{% comment %}
  PDP reassurance, placed directly after the buy area. The icon shapes follow
  the supplied reference; only substantiated ISOUA claims should be added as
  blocks in the product template. Shipping copy comes from ISOUA's site policy.
{% endcomment %}

{% style %}
  .isoa-pdp-trust-{{ section.id }} {
    color: #67645e;
    font-family: var(--font-body--family);
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__inner {
    max-width: min(calc(var(--page-width) - var(--page-margin) * 2), calc(100% - var(--page-margin) * 2));
    margin: 16px auto 0;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badges {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(28px, 5vw, 72px);
    padding: 26px 20px;
    border-radius: 10px;
    background: #f1f0ed;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badge {
    display: flex;
    flex: 0 1 150px;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    min-width: 0;
    text-align: center;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__icon {
    display: block;
    width: 76px;
    height: 76px;
    flex: 0 0 auto;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badge-label {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 16px;
    margin-top: 16px;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery,
  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__offer {
    min-width: 0;
    border: 1px solid #dad8d4;
    border-radius: 10px;
    background: #fff;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 16px 0;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 0;
    padding: 0 16px;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-item + .isoa-pdp-trust__delivery-item {
    border-left: 1px solid #dad8d4;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-icon {
    display: grid;
    flex: 0 0 34px;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #67645e;
    color: #fff;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-icon svg {
    width: 19px;
    height: 19px;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__eyebrow {
    display: block;
    margin-bottom: 3px;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-value {
    display: block;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__offer {
    padding: 16px 20px;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__offer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__offer h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__offer-tag {
    padding: 4px 9px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__offer p {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.4;
  }

  @media (max-width: 749px) {
    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__inner {
      margin-top: 12px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badges {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px 4px;
      padding: 18px 10px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__icon {
      width: 58px;
      height: 58px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__badge-label {
      font-size: 10px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__bottom {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 12px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery {
      padding: 14px 0;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-item {
      justify-content: flex-start;
      gap: 8px;
      padding: 0 12px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-icon {
      flex-basis: 30px;
      width: 30px;
      height: 30px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-icon svg {
      width: 17px;
      height: 17px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__eyebrow {
      font-size: 9px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-value {
      font-size: 11px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__offer {
      padding: 14px 16px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__offer h2 {
      font-size: 13px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__offer p {
      font-size: 12px;
    }
  }

  @media (max-width: 360px) {
    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .isoa-pdp-trust-{{ section.id }} .isoa-pdp-trust__delivery-item + .isoa-pdp-trust__delivery-item {
      padding-top: 12px;
      border-top: 1px solid #dad8d4;
      border-left: 0;
    }
  }
{% endstyle %}

<section class="isoa-pdp-trust-{{ section.id }}" aria-label="Product assurances">
  <div class="isoa-pdp-trust__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="isoa-pdp-trust__badges">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <div class="isoa-pdp-trust__badge" {{ block.shopify_attributes }}>
              {% render 'isoa-pdp-trust-icon', icon: block.settings.icon %}
              <span class="isoa-pdp-trust__badge-label">{{ block.settings.label | escape }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="isoa-pdp-trust__bottom">
      <div class="isoa-pdp-trust__delivery" aria-label="Shipping and delivery">
        <div class="isoa-pdp-trust__delivery-item">
          <span class="isoa-pdp-trust__delivery-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 3h13v13H1V3zM14 8h4l3 3v5h-7V8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <circle cx="5.5" cy="18.5" r="2" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="18.5" cy="18.5" r="2" stroke="currentColor" stroke-width="1.8"/>
              <path d="M3.5 18.5H1v-2.5M16.5 18.5H14V16M21 18.5h-.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </span>
          <div>
            <span class="isoa-pdp-trust__eyebrow">Delivery</span>
            <strong class="isoa-pdp-trust__delivery-value">{{ section.settings.shipping_text | escape }}</strong>
          </div>
        </div>
        <div class="isoa-pdp-trust__delivery-item">
          <span class="isoa-pdp-trust__delivery-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="4" width="18" height="17" rx="2" stroke="currentColor" stroke-width="1.8"/>
              <path d="M3 9h18M8 2v4M16 2v4M7 13h2M11 13h2M15 13h2M7 17h2M11 17h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </span>
          <div>
            <span class="isoa-pdp-trust__eyebrow">Expected delivery</span>
            <strong class="isoa-pdp-trust__delivery-value">{{ section.settings.delivery_text | escape }}</strong>
          </div>
        </div>
      </div>
      {%- if section.settings.offer_text != blank -%}
        <div class="isoa-pdp-trust__offer">
          <div class="isoa-pdp-trust__offer-head">
            <h2>Available offers</h2>
            <span class="isoa-pdp-trust__offer-tag">{{ section.settings.offer_tag | escape }}</span>
          </div>
          <p>{{ section.settings.offer_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ISOUA PDP trust",
  "settings": [
    { "type": "text", "id": "shipping_text", "label": "Shipping message", "default": "Free shipping on prepaid orders" },
    { "type": "text", "id": "delivery_text", "label": "Delivery window", "default": "5–7 working days" },
    { "type": "text", "id": "offer_tag", "label": "Offer tag", "default": "Sitewide" },
    { "type": "text", "id": "offer_text", "label": "Offer message", "default": "Free shipping pan India on prepaid orders." }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Claim badge",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "vegan", "label": "Vegan" },
          { "value": "cruelty_free", "label": "Cruelty free" },
          { "value": "non_toxic", "label": "Non toxic" },
          { "value": "paraben_free", "label": "Paraben free" },
          { "value": "sulphate_free", "label": "Sulphate free" },
          { "value": "non_comedogenic", "label": "Non comedogenic" }
        ], "default": "vegan" },
        { "type": "text", "id": "label", "label": "Claim (publish only when verified)", "default": "Vegan" }
      ]
    }
  ],
  "presets": [
    { "name": "ISOUA PDP trust", "blocks": [
      { "type": "badge", "settings": { "icon": "vegan", "label": "Vegan" } },
      { "type": "badge", "settings": { "icon": "cruelty_free", "label": "Cruelty Free" } },
      { "type": "badge", "settings": { "icon": "non_comedogenic", "label": "Non Comedogenic" } }
    ] }
  ]
}
{% endschema %}
