{% comment %}
=============================================================================
INTERACTIVE BENEFITS SECTION
FULLY FIXED + SHOPIFY 2.0
=============================================================================
{% endcomment %}

{%- assign first_image = section.blocks.first.settings.image -%}
{%- capture ratio_mobile -%}
  {%- render 'isoa-image-ratio', ratio: section.settings.image_ratio_mobile, image: first_image, custom_width: section.settings.image_ratio_mobile_w, custom_height: section.settings.image_ratio_mobile_h, fallback: '1 / 1' -%}
{%- endcapture -%}
{%- assign image_size_desktop = '' -%}
{%- if section.settings.image_size != blank and section.settings.image_size != 'fill' -%}
  {%- capture image_size_desktop -%}{%- render 'isoa-image-ratio', ratio: section.settings.image_size, image: first_image, custom_width: section.settings.image_size_w, custom_height: section.settings.image_size_h, fallback: '4 / 5' -%}{%- endcapture -%}
{%- endif -%}

<section id="benefits-{{ section.id }}" class="rh-benefits" style="--rh-ratio-mobile: {{ ratio_mobile | strip }};">

  <div class="rh-benefits__container">

    <div class="rh-benefits__grid">

      <!-- IMAGE -->
      <div class="rh-media">

        {% for block in section.blocks %}
          {% assign image = block.settings.image %}

          <div
            class="rh-media__item {% if forloop.first %}is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            style="--rh-i: {{ forloop.index0 }};"
            {{ block.shopify_attributes }}
          >

            {% if image != blank %}
              <img
                src="{{ image | image_url: width: 2200 }}"
                srcset="
                  {{ image | image_url: width: 500 }} 500w,
                  {{ image | image_url: width: 800 }} 800w,
                  {{ image | image_url: width: 1200 }} 1200w,
                  {{ image | image_url: width: 1600 }} 1600w,
                  {{ image | image_url: width: 2200 }} 2200w
                "
                sizes="(max-width: 768px) 100vw, 50vw"
                width="{{ image.width }}"
                height="{{ image.height }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
              >
            {% endif %}

          </div>

        {% endfor %}

      </div>

      <!-- CONTENT -->
      <div class="rh-content">

        <div class="rh-top-heading">
          {{ section.settings.top_heading }}
        </div>

        <div class="rh-text-list">

          {% for block in section.blocks %}

            <button
              class="rh-text-item {% if forloop.first %}is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              type="button"
            >
              <span class="rh-text-inner rh-text-inner--primary">
                {{ block.settings.heading }}
              </span>
              <span class="rh-text-inner rh-text-inner--secondary" aria-hidden="true">
                {{ block.settings.heading }}
              </span>
            </button>

          {% endfor %}

        </div>

      </div>

    </div>

  </div>

</section>

<style>

#benefits-{{ section.id }}{

  --bg: {{ section.settings.section_bg }};
  --container: {{ section.settings.container_width }}px;

  --desktop-gap: {{ section.settings.desktop_gap }}px;
  --mobile-gap: {{ section.settings.mobile_gap }}px;

  --image-radius-desktop: {{ section.settings.image_radius_desktop }}px;
  --image-radius-mobile: {{ section.settings.image_radius_mobile }}px;

  --image-height-desktop: {{ section.settings.image_height_desktop }}px;
  --image-height-mobile: {{ section.settings.image_height_mobile }}px;

  --heading-color: {{ section.settings.heading_color }};

  --text-color: {{ section.settings.text_color }};
  --active-color: {{ section.settings.active_text_color }};

  --anim-speed: {{ section.settings.animation_speed }}ms;

  --text-scale: {{ section.settings.active_scale }};

  background: var(--bg);

  padding:
    {{ section.settings.padding_top_desktop }}px
    {{ section.settings.padding_side_desktop }}px
    {{ section.settings.padding_bottom_desktop }}px;

  overflow:hidden;
  position:relative;
}

#benefits-{{ section.id }} *{
  box-sizing:border-box;
}

#benefits-{{ section.id }} .rh-benefits__container{
  max-width:var(--container);
  margin:auto;
}

#benefits-{{ section.id }} .rh-benefits__grid{

  display:grid;

  grid-template-columns:
    minmax(0, {{ section.settings.desktop_image_width }}fr)
    minmax(0, {{ section.settings.desktop_content_width }}fr);

  gap:var(--desktop-gap);

  align-items:center;
}

#benefits-{{ section.id }} .rh-media{

  position:relative;

  height:var(--image-height-desktop);

  min-height:500px;

  border-radius:var(--image-radius-desktop);

  overflow:hidden;

  background:#ddd;
}

#benefits-{{ section.id }} .rh-media__item{

  position:absolute;

  inset:0;

  opacity:0;

  visibility:hidden;

  transform:scale(1.04);

  will-change:transform, opacity;

  transition:
    opacity var(--anim-speed) cubic-bezier(.22,.61,.36,1),
    transform var(--anim-speed) cubic-bezier(.22,.61,.36,1),
    visibility .3s;
}

#benefits-{{ section.id }} .rh-media__item.is-active{

  opacity:1;

  visibility:visible;

  transform:scale(1);

  z-index:2;
}

#benefits-{{ section.id }} .rh-media img{

  width:100%;

  height:100%;

  object-fit:cover;

  display:block;
}

#benefits-{{ section.id }} .rh-content{
  position:relative;
  z-index:5;
}

#benefits-{{ section.id }} .rh-top-heading{

  font-size:{{ section.settings.top_heading_size_desktop }}px;

  font-weight:700;

  letter-spacing:1px;

  text-transform:uppercase;

  color:var(--heading-color);

  margin-bottom:32px;
}

#benefits-{{ section.id }} .rh-text-list{

  display:flex;

  flex-direction:column;

  gap:{{ section.settings.text_gap_desktop }}px;
}

#benefits-{{ section.id }} .rh-text-item{

  border:none;

  background:none;

  padding:0;

  cursor:pointer;

  width:fit-content;

  text-align:center;

  position:relative;
}

#benefits-{{ section.id }} .rh-text-inner{

  display:inline-block;

  font-family:{{ section.settings.text_font.family }}, sans-serif;

  font-size:{{ section.settings.text_size_desktop }}px;

  line-height:{{ section.settings.text_line_height }};

  letter-spacing:{{ section.settings.text_letter_spacing }}px;

  font-weight:{{ section.settings.text_weight }};

  color:var(--text-color);

  opacity:.35;

  transform:
    translateX(0px)
    scale(1);

  transition:
    transform var(--anim-speed) cubic-bezier(.22,.61,.36,1),
    color var(--anim-speed) ease,
    opacity var(--anim-speed) ease;
}

#benefits-{{ section.id }} .rh-text-item.is-active .rh-text-inner{

  color:var(--active-color);

  opacity:1;

  transform:
    translateX(10px)
scale(calc(var(--text-scale) / 100));}

#benefits-{{ section.id }} .rh-text-item::before{

  content:'';

  position:center;

  
  width:0;

  height:0;

  border-radius:50%;

  background:{{ section.settings.active_dot_color }};

  transform:translateY(-50%);

  transition:all .45s cubic-bezier(.22,.61,.36,1);
}

#benefits-{{ section.id }} .rh-text-item.is-active::before{

  width:8px;

  height:8px;
}

@media screen and (max-width:768px){

  #benefits-{{ section.id }}{

    padding:
      {{ section.settings.padding_top_mobile }}px
      {{ section.settings.padding_side_mobile }}px
      {{ section.settings.padding_bottom_mobile }}px;
  }

  #benefits-{{ section.id }} .rh-benefits__grid{

    grid-template-columns:1fr;

    gap:var(--mobile-gap);
  }

  #benefits-{{ section.id }} .rh-media{

    height:var(--image-height-mobile);

    min-height:300px;

    border-radius:var(--image-radius-mobile);
  }

  #benefits-{{ section.id }} .rh-top-heading{

    font-size:{{ section.settings.top_heading_size_mobile }}px;

    text-align:center;

    margin-bottom:24px;
  }

  #benefits-{{ section.id }} .rh-text-list{

    gap:{{ section.settings.text_gap_mobile }}px;

    align-items:center;
  }

  #benefits-{{ section.id }} .rh-text-item{

    width:100%;

    text-align:center;
  }

  #benefits-{{ section.id }} .rh-text-inner{

    font-size:{{ section.settings.text_size_mobile }}px;
  }

  #benefits-{{ section.id }} .rh-text-item::before{
    display:none;
  }

}

/* Secondary pink layer — hidden by default so no visual change on other templates. -vamshi */
#benefits-{{ section.id }} .rh-text-inner--secondary{
  display:none;
}

{% if template.name == 'product' and template.suffix != blank %}
  /* --- PDP override: grey pill container at header-pill width, centered text block,
     outlined pink secondary layer with clip-path slide reveal. -vamshi */

  #benefits-{{ section.id }}{
    background: transparent !important;
    padding: 0 !important;
    overflow: visible !important;
    /* One clock for the word fill and the image slide, so they move as a
       pair (Rhode's easing). The image starts a beat after the colour. */
    --rh-dur: 1.2s;
    --rh-ease: cubic-bezier(.76,0,.24,1);
    --rh-img-delay: 0.12s;
  }

  /* Grey pill wrapper matches SS-header-1 pill edges. No inner padding: as on
     Rhode, the image runs flush to the pill's edges and the pill's own radius
     + overflow: hidden rounds its outer corners. */
  #benefits-{{ section.id }} .rh-benefits__container{
    max-width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    ) !important;
    margin-inline: auto !important;
    background: #f1f0ed !important;
    border-radius: 10px !important;
    overflow: hidden !important;
    padding: 0 !important;
    box-sizing: border-box;
  }

  #benefits-{{ section.id }} .rh-benefits__grid{
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
    align-items: stretch !important;
    gap: 0 !important;
    /* Same height as the PDP hero and the split section above it
       (--rhode-pdp-h, rhode-pdp.css). */
    min-height: var(--rhode-pdp-h, 720px);
  }

  #benefits-{{ section.id }} .rh-media{
    border-radius: 0 !important;
    background: #e5e3df !important;
    height: 100% !important;
    min-height: 0 !important;
    align-self: stretch !important;
    overflow: hidden !important;
  }

  /* Images form one vertical strip in word order; the script sets
     --rh-active on .rh-media and every image sits (its index - active) frames
     away. Picking a word further down slides the strip up, back up slides it
     down. Because each image transitions from wherever it currently is, a new
     hover mid-slide just retargets the motion — no jumps when someone runs
     the mouse quickly across the words. */
  #benefits-{{ section.id }} .rh-media__item{
    opacity: 1;
    visibility: visible;
    transform: translateY(calc((var(--rh-i, 0) - var(--rh-active, 0)) * 100%));
    transition: transform var(--rh-dur) var(--rh-ease) var(--rh-img-delay);
  }
  #benefits-{{ section.id }} .rh-media__item.is-active{
    z-index: 2;
  }
  @media (prefers-reduced-motion: reduce){
    #benefits-{{ section.id }}{
      --rh-dur: 0.01s;
      --rh-img-delay: 0s;
    }
  }

  /* Center the text block horizontally + vertically in its column. */
  #benefits-{{ section.id }} .rh-content{
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    padding: 0 !important;
    text-align: center !important;
  }

  #benefits-{{ section.id }} .rh-top-heading{
    margin-bottom: 20px !important;
    color: #67645e !important;
    letter-spacing: 0.02em !important;
    text-align: center !important;
  }

  #benefits-{{ section.id }} .rh-text-list{
    gap: 24px !important;
    align-items: center !important;
  }

  #benefits-{{ section.id }} .rh-text-item{
    position: relative !important;
    display: inline-block;
    width: fit-content;
    text-align: center !important;
    overflow: visible;
    line-height: 1 !important;
  }

  /* Same display face as the PDP product name (rhode-pdp.css 5.7): DM Sans
     800, Rhode's heavy wordmark stand-in. Applies to both layers so the pink
     overlay stays registered over the grey word. */
  #benefits-{{ section.id }} .rh-text-inner{
    display: inline-block;
    font-family: 'DM Sans', var(--font-heading--family) !important;
    color: #7d7a74 !important;
    opacity: 1 !important;
    transform: none !important;
    font-weight: 800 !important;
    letter-spacing: -0.03em;
    text-transform: lowercase;
    line-height: 1 !important;
  }
  /* Kill the base theme's transform/color transitions ONLY on the primary
     layer — the secondary layer needs its clip-path transition intact. */
  #benefits-{{ section.id }} .rh-text-inner--primary{
    transition: none !important;
  }

  /* Pink secondary layer — "strong font" look via 1.5px text-stroke; slides in L→R
     via clip-path, slides out R→L (right-clip grows) — both simultaneously, on
     the shared --rh-dur / --rh-ease clock. */
  #benefits-{{ section.id }} .rh-text-inner--secondary{
    display: inline-block;
    position: absolute;
    inset: 0;
    color: #e29fc8 !important;
    -webkit-text-stroke: 1.5px #67645e;
    text-stroke: 1.5px #67645e;
    paint-order: stroke fill;
    font-weight: 800 !important;
    clip-path: inset(0 100% 0 0);
    -webkit-clip-path: inset(0 100% 0 0);
    transition:
      clip-path var(--rh-dur) var(--rh-ease),
      -webkit-clip-path var(--rh-dur) var(--rh-ease);
    pointer-events: none;
    white-space: nowrap;
  }

  #benefits-{{ section.id }} .rh-text-item.is-active .rh-text-inner--secondary{
    clip-path: inset(0 0 0 0);
    -webkit-clip-path: inset(0 0 0 0);
  }

  #benefits-{{ section.id }} .rh-text-item.is-active .rh-text-inner--primary{
    color: #7d7a74 !important;
  }

  /* Kill leftover dot indicator on PDP. */
  #benefits-{{ section.id }} .rh-text-item::before,
  #benefits-{{ section.id }} .rh-text-item.is-active::before{
    display: none !important;
  }

  {%- if image_size_desktop != blank %}
  /* "Image size (desktop)" picked: the image box takes those proportions
     (from an in-flow spacer, as on mobile) instead of the text card's height. */
  @media screen and (min-width: 769px){
    #benefits-{{ section.id }} .rh-media{
      height: auto !important;
      align-self: center !important;
    }
    #benefits-{{ section.id }} .rh-media::before{
      content: '';
      display: block;
      aspect-ratio: {{ image_size_desktop | strip }};
    }
  }
  {%- endif %}

  /* Mobile: image flush across the top of the pill as a square (same as the
     split section above), copy below with its own padding. */
  @media screen and (max-width: 768px){
    #benefits-{{ section.id }} .rh-benefits__grid{
      grid-template-columns: 1fr !important;
      min-height: 0;
    }
    /* The images are absolutely positioned, so the box needs its height from
       something in flow. aspect-ratio on the box itself collapsed to 0 on
       some iOS Safari versions (stretched grid item, nothing in flow); an
       in-flow spacer with the ratio sizes it the same in every browser. */
    #benefits-{{ section.id }} .rh-media{
      height: auto !important;
    }
    #benefits-{{ section.id }} .rh-media::before{
      content: '';
      display: block;
      aspect-ratio: var(--rh-ratio-mobile, 1 / 1);
    }
    #benefits-{{ section.id }} .rh-content{
      padding: 32px 20px 40px !important;
    }
    #benefits-{{ section.id }} .rh-top-heading{
      margin-bottom: 16px !important;
    }
    #benefits-{{ section.id }} .rh-text-list{
      gap: 14px !important;
    }
  }
{% endif %}

</style>

<script>

document.addEventListener('DOMContentLoaded', function(){

  const section = document.querySelector('#benefits-{{ section.id }}');

  if(!section) return;

  const textItems = section.querySelectorAll('.rh-text-item');

  const imageItems = section.querySelectorAll('.rh-media__item');

  let activeIndex = 0;

  const media = section.querySelector('.rh-media');
  // How long one slide lasts (transition + delay); read from the CSS so the
  // two never drift apart. Falls back to 1.32s.
  const slideMs = (() => {
    const cs = getComputedStyle(section);
    const dur = parseFloat(cs.getPropertyValue('--rh-dur')) || 1.2;
    const delay = parseFloat(cs.getPropertyValue('--rh-img-delay')) || 0.12;
    return (dur + delay) * 1000;
  })();
  let lastChange = 0;

  /* Rhode-style hover: swap classes immediately on every hover — no
     `isAnimating` guard, no setTimeout between text and image. The CSS
     clip-path transition on `.rh-text-inner--secondary` handles the
     L→R fill (incoming) and R→L unfill (outgoing) in parallel. The image
     strip moves on the same tick; its small lag from rest comes from the CSS
     transition-delay, not from script timers. */

  function activateSlide(index){
    index = Number(index);
    if(index === activeIndex) return;

    // Move the image strip. The colour fill leads by --rh-img-delay from
    // rest; if the strip is already moving, retarget it straight away so a
    // fast run across the words never pauses mid-slide.
    if(media){
      const now = performance.now();
      media.style.setProperty('--rh-img-delay', now - lastChange < slideMs ? '0s' : '');
      media.style.setProperty('--rh-active', index);
      lastChange = now;
    }

    textItems.forEach((el, i) => el.classList.toggle('is-active', i === index));
    imageItems.forEach((el, i) => el.classList.toggle('is-active', i === index));

    activeIndex = index;
  }

  textItems.forEach((item)=>{

    item.addEventListener('mouseenter', ()=>{

      if(window.innerWidth > 768){

        activateSlide(item.dataset.index);

      }

    });

    item.addEventListener('click', ()=>{

      activateSlide(item.dataset.index);

    });

  });

  {% if section.settings.enable_autoplay %}

  let autoplay = setInterval(()=>{

    let next = activeIndex + 1;

    if(next >= textItems.length){

      next = 0;

    }

    activateSlide(next);

  }, {{ section.settings.autoplay_speed }});

  section.addEventListener('mouseenter', ()=>{

    clearInterval(autoplay);

  });

  section.addEventListener('mouseleave', ()=>{

    autoplay = setInterval(()=>{

      let next = activeIndex + 1;

      if(next >= textItems.length){

        next = 0;

      }

      activateSlide(next);

    }, {{ section.settings.autoplay_speed }});

  });

  {% endif %}

});

</script>

{% schema %}
{
  "name":"Interactive Benefits",

  "settings":[

    {
      "type":"text",
      "id":"top_heading",
      "label":"Top Heading",
      "default":"LEAVES SPOTS LOOKING"
    },

    {
      "type":"color",
      "id":"section_bg",
      "label":"Background",
      "default":"#efefeb"
    },

    {
      "type":"range",
      "id":"container_width",
      "label":"Container Width",
      "min":900,
      "max":1800,
      "step":20,
      "default":1400
    },

    {
      "type":"range",
      "id":"desktop_image_width",
      "label":"Desktop Image Width",
      "min":1,
      "max":5,
      "step":1,
      "default":3
    },

    {
      "type":"range",
      "id":"desktop_content_width",
      "label":"Desktop Content Width",
      "min":1,
      "max":5,
      "step":1,
      "default":2
    },

    {
      "type":"range",
      "id":"desktop_gap",
      "label":"Desktop Gap",
      "min":0,
      "max":120,
      "step":2,
      "default":10
    },

    {
      "type":"range",
      "id":"mobile_gap",
      "label":"Mobile Gap",
      "min":0,
      "max":80,
      "step":2,
      "default":10
    },

    {
      "type":"range",
      "id":"padding_top_desktop",
      "label":"Padding Top Desktop",
      "min":0,
      "max":200,
      "step":4,
      "default":80
    },

    {
      "type":"range",
      "id":"padding_bottom_desktop",
      "label":"Padding Bottom Desktop",
      "min":0,
      "max":200,
      "step":4,
      "default":80
    },

    {
      "type":"range",
      "id":"padding_side_desktop",
      "label":"Padding Side Desktop",
      "min":0,
      "max":100,
      "step":2,
      "default":40
    },

    {
      "type":"range",
      "id":"padding_top_mobile",
      "label":"Padding Top Mobile",
      "min":0,
      "max":120,
      "step":2,
      "default":40
    },

    {
      "type":"range",
      "id":"padding_bottom_mobile",
      "label":"Padding Bottom Mobile",
      "min":0,
      "max":120,
      "step":2,
      "default":40
    },

    {
      "type":"range",
      "id":"padding_side_mobile",
      "label":"Padding Side Mobile",
      "min":0,
      "max":40,
      "step":2,
      "default":16
    },

    {
      "type":"range",
      "id":"image_height_desktop",
      "label":"Image Height Desktop",
      "min":300,
      "max":1000,
      "step":10,
      "default":700
    },

    {
      "type":"range",
      "id":"image_height_mobile",
      "label":"Image Height Mobile",
      "min":250,
      "max":700,
      "step":10,
      "default":420
    },

    { "type": "header", "content": "Image size on product pages" },
    { "type": "select", "id": "image_size", "label": "Image size (desktop)", "options": [
      { "value": "fill", "label": "Match text card" },
      { "value": "original", "label": "Original" },
      { "value": "square", "label": "Square" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" },
      { "value": "custom", "label": "Custom" }
    ], "default": "fill", "info": "Match text card keeps the image as tall as the text beside it." },
    { "type": "range", "id": "image_size_w", "label": "Custom width (desktop)", "min": 1, "max": 40, "step": 1, "default": 4, "visible_if": "{{ section.settings.image_size == 'custom' }}" },
    { "type": "range", "id": "image_size_h", "label": "Custom height (desktop)", "min": 1, "max": 40, "step": 1, "default": 5, "visible_if": "{{ section.settings.image_size == 'custom' }}" },
    {
      "type":"select",
      "id":"image_ratio_mobile",
      "label":"Image size on mobile (product pages)",
      "options":[
        { "value":"original", "label":"Original" },
        { "value":"square", "label":"Square" },
        { "value":"portrait", "label":"Portrait" },
        { "value":"landscape", "label":"Landscape" },
        { "value":"custom", "label":"Custom" }
      ],
      "default":"square",
      "info":"Original follows the first image."
    },
    { "type":"range", "id":"image_ratio_mobile_w", "label":"Custom width on mobile", "min":1, "max":40, "step":1, "default":1, "visible_if":"{{ section.settings.image_ratio_mobile == 'custom' }}" },
    { "type":"range", "id":"image_ratio_mobile_h", "label":"Custom height on mobile", "min":1, "max":40, "step":1, "default":1, "visible_if":"{{ section.settings.image_ratio_mobile == 'custom' }}" },

    {
      "type":"range",
      "id":"image_radius_desktop",
      "label":"Image Radius Desktop",
      "min":0,
      "max":60,
      "step":1,
      "default":20
    },

    {
      "type":"range",
      "id":"image_radius_mobile",
      "label":"Image Radius Mobile",
      "min":0,
      "max":60,
      "step":1,
      "default":16
    },

    {
