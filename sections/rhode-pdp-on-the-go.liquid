{%- comment -%}
  Rhode PDP — "Take your rhode ON THE GO" 5-tab slider, cloned from
  rhodeskin.com's spotwear PDP (Slider-with-navigation), measured at 1440:
  photo left | card right, same 720px row as the other PDP splits.

  Card: title (36px) + subtitle (16px), then a 384px "stage" where each
  slide shows its product swatch art (whole square fitted in, centred) with the product
  name, a rule ending in a dot, and the description at 38% down / 50% wide.
  Five 79px circles below; the active one fills pink and its label rises
  in underneath.

  Motion — no fades anywhere:
  - photo and stage are vertical strips: each slide sits (index - active)
    frames away, so picking a later circle slides everything up and an
    earlier one slides down; a hover mid-slide just retargets the motion;
  - the rule draws left-to-right once its slide lands;
  - the label slides up out of a mask under its circle.
  Hover activates on desktop; tap on touch. Blocks without their own
  images fall back to the bundled isoa-otg-* assets for slides 1-4.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign card_bg = section.settings.card_bg_color | default: '#f1f0ed'
  assign image_bg = section.settings.image_bg_color | default: '#e5e3df'
  assign active_color = section.settings.active_circle_color | default: '#e29fc8'
  assign first_image = section.blocks.first.settings.image
-%}
{%- comment -%} Without block images the built-in 1320×1440 photos show, so "Original" uses their proportions. {%- endcomment -%}
{%- assign image_size_desktop = '' -%}
{%- if section.settings.image_size != blank and section.settings.image_size != 'fill' -%}
  {%- capture image_size_desktop -%}{%- render 'isoa-image-ratio', ratio: section.settings.image_size, image: first_image, custom_width: section.settings.image_size_w, custom_height: section.settings.image_size_h, fallback: '1320 / 1440' -%}{%- endcapture -%}
{%- endif -%}
{%- capture image_size_mobile -%}{%- render 'isoa-image-ratio', ratio: section.settings.image_size_mobile, image: first_image, custom_width: section.settings.image_size_mobile_w, custom_height: section.settings.image_size_mobile_h, fallback: '1320 / 1440' -%}{%- endcapture -%}

<section class="rh-otg" id="rh-otg-{{ sid }}" data-rh-otg style="--rh-otg-active: 0;">
  <div class="rh-otg__grid">
    <div class="rh-otg__media">
      {%- for block in section.blocks -%}
        <div class="rh-otg__slide" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400,600,800,1000,1200,1400,1600',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: block.settings.image.alt
            }}
          {%- elsif forloop.index <= 4 -%}
            {%- assign fallback = 'isoa-otg-photo-' | append: forloop.index | append: '.jpg' -%}
            <img
              src="{{ fallback | asset_img_url: '1320x' }}"
              srcset="{{ fallback | asset_img_url: '660x' }} 660w, {{ fallback | asset_img_url: '1000x' }} 1000w, {{ fallback | asset_img_url: '1320x' }} 1320w"
              sizes="(min-width: 750px) 50vw, 100vw"
              width="1320" height="1440" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              alt="{{ block.settings.product_name | escape }}"
            >
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="rh-otg__card">
      <div class="rh-otg__head">
        <h2 class="rh-otg__title">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="rh-otg__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="rh-otg__stage">
        {%- for block in section.blocks -%}
          <div class="rh-otg__item{% if forloop.first %} is-active{% endif %}" style="--i: {{ forloop.index0 }};">
            {%- if block.settings.graphic != blank -%}
              {{
                block.settings.graphic
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '600,900,1200',
                  sizes: '(min-width: 750px) 45vw, 100vw',
                  class: 'rh-otg__swatch',
                  alt: ''
              }}
            {%- elsif forloop.index <= 4 -%}
              {%- assign swatch = 'isoa-otg-swatch-' | append: forloop.index | append: '.png' -%}
              <img class="rh-otg__swatch" src="{{ swatch | asset_img_url: '1200x' }}" width="1200" height="1200" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" alt="">
            {%- endif -%}
            <div class="rh-otg__copy">
              <p class="rh-otg__product">{{ block.settings.product_name }}</p>
              <span class="rh-otg__rule" aria-hidden="true"></span>
              {%- if block.settings.description != blank -%}
                <p class="rh-otg__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="rh-otg__nav">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="rh-otg__circle{% if forloop.first %} is-active{% endif %}"
            data-slide="{{ forloop.index0 }}"
            aria-label="{{ block.settings.product_name | escape }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="rh-otg__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if block.settings.label != blank -%}
              <span class="rh-otg__label-mask" aria-hidden="true"><span class="rh-otg__label">{{ block.settings.label }}</span></span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  #rh-otg-{{ sid }} {
    --rh-otg-ease: cubic-bezier(.76, 0, .24, 1);
    --rh-otg-dur: 0.9s;
    --rh-otg-ink: #67645e;
    --rh-otg-ring: #84827e;
    padding: 0;
  }

  #rh-otg-{{ sid }} .rh-otg__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* ── Photo strip ── */
  /* The slides are absolutely positioned, so an in-flow spacer gives the box
     its "Image size (mobile)" proportions (aspect-ratio on the box itself can
     collapse to 0 on older iPhone Safari). */
  #rh-otg-{{ sid }} .rh-otg__media {
    position: relative;
    overflow: hidden;
    border-radius: 10px 10px 0 0;
    background: {{ image_bg }};
  }
  #rh-otg-{{ sid }} .rh-otg__media::before {
    content: '';
    display: block;
    aspect-ratio: {{ image_size_mobile | strip }};
    /* A tall pick crops rather than filling more than the screen. */
    max-height: 75vh;
    max-height: 75svh;
  }
  #rh-otg-{{ sid }} .rh-otg__slide {
    position: absolute;
    inset: 0;
    transform: translateY(calc((var(--i) - var(--rh-otg-active)) * 100%));
    transition: transform var(--rh-otg-dur) var(--rh-otg-ease);
  }
  #rh-otg-{{ sid }} .rh-otg__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Card ── */
  #rh-otg-{{ sid }} .rh-otg__card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border-radius: 0 0 10px 10px;
    background: {{ card_bg }};
    color: var(--rh-otg-ink);
  }
  #rh-otg-{{ sid }} .rh-otg__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--rh-otg-ink);
  }
  #rh-otg-{{ sid }} .rh-otg__subtitle {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  /* ── Stage: swatch art + copy, also a vertical strip ── */
  #rh-otg-{{ sid }} .rh-otg__stage {
    position: relative;
    overflow: hidden;
    height: 220px;
    margin: 16px 0;
  }
  #rh-otg-{{ sid }} .rh-otg__item {
    position: absolute;
    inset: 0;
    transform: translateY(calc((var(--i) - var(--rh-otg-active)) * 100%));
    transition: transform var(--rh-otg-dur) var(--rh-otg-ease);
  }
  #rh-otg-{{ sid }} .rh-otg__swatch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }
  #rh-otg-{{ sid }} .rh-otg__copy {
    position: absolute;
    top: 50%;
    left: 0;
    width: 50%;
    transform: translateY(-38%);
  }
  #rh-otg-{{ sid }} .rh-otg__product {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }
  /* The rule + its end dot draw left-to-right once the slide has landed;
     on the way out it simply rides off with its slide. */
  #rh-otg-{{ sid }} .rh-otg__rule {
    position: relative;
    display: block;
    height: 8px;
    margin: 0 0 2px;
    clip-path: inset(0 100% 0 0);
  }
  #rh-otg-{{ sid }} .rh-otg__rule::before {
    content: '';
    position: absolute;
    left: 0;
    right: 4px;
    top: 50%;
    height: 1px;
    background: var(--rh-otg-ink);
  }
  #rh-otg-{{ sid }} .rh-otg__rule::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rh-otg-ink);
  }
  #rh-otg-{{ sid }} .rh-otg__item.is-active .rh-otg__rule {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.8s var(--rh-otg-ease) 0.45s;
  }
  #rh-otg-{{ sid }} .rh-otg__desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  /* ── Circles ── */
  #rh-otg-{{ sid }} .rh-otg__nav {
    display: flex;
    justify-content: space-between;
    padding-bottom: 28px;
  }
  #rh-otg-{{ sid }} .rh-otg__circle {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 1px solid var(--rh-otg-ring);
    border-radius: 50%;
    background: transparent;
    color: var(--rh-otg-ink);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.7s var(--rh-otg-ease), color 0.7s var(--rh-otg-ease);
  }
  #rh-otg-{{ sid }} .rh-otg__circle.is-active {
    background: {{ active_color }};
    color: #ffffff;
  }
  #rh-otg-{{ sid }} .rh-otg__circle:focus-visible {
    outline: 2px solid var(--rh-otg-ink);
    outline-offset: 3px;
  }
  /* Label: rises out of a mask under its circle — a slide, not a fade. */
  #rh-otg-{{ sid }} .rh-otg__label-mask {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    overflow: hidden;
    pointer-events: none;
  }
  #rh-otg-{{ sid }} .rh-otg__label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--rh-otg-ring);
    white-space: nowrap;
    transform: translateY(105%);
    transition: transform 0.7s var(--rh-otg-ease);
  }
  #rh-otg-{{ sid }} .rh-otg__circle.is-active .rh-otg__label {
    transform: translateY(0);
  }

  @media (min-width: 750px) {
    #rh-otg-{{ sid }} .rh-otg__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--rhode-pdp-gap, 32px);
      height: var(--rhode-pdp-h, 720px);
    }
    #rh-otg-{{ sid }} .rh-otg__media {
      height: 100%;
      border-radius: 10px;
    }
    #rh-otg-{{ sid }} .rh-otg__media::before {
      {%- if image_size_desktop != blank %}
      aspect-ratio: {{ image_size_desktop | strip }};
      /* The row is the hero's height; a taller pick spilled out of it. */
      max-height: var(--rhode-pdp-h, 720px);
      {%- else %}
      display: none;
      {%- endif %}
    }
    {%- if image_size_desktop != blank %}
    #rh-otg-{{ sid }} .rh-otg__media {
      height: auto;
      align-self: center;
    }
    {%- endif %}
    #rh-otg-{{ sid }} .rh-otg__card {
      padding: 32px;
      border-radius: 10px;
    }
    #rh-otg-{{ sid }} .rh-otg__title {
      font-size: 36px;
    }
    #rh-otg-{{ sid }} .rh-otg__subtitle {
      font-size: 16px;
    }
    #rh-otg-{{ sid }} .rh-otg__stage {
      flex: 1 1 auto;
      height: auto;
      max-height: 384px;
      margin: 16px 0 auto;
    }
    #rh-otg-{{ sid }} .rh-otg__copy {
      top: 38%;
    }
    #rh-otg-{{ sid }} .rh-otg__desc {
      font-size: 15px;
    }
    #rh-otg-{{ sid }} .rh-otg__nav {
      justify-content: space-around;
      padding-bottom: 40px;
    }
    #rh-otg-{{ sid }} .rh-otg__circle {
      width: 79px;
      height: 79px;
      font-size: 16px;
    }
    #rh-otg-{{ sid }} .rh-otg__label {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #rh-otg-{{ sid }} {
      --rh-otg-dur: 0.01s;
    }
    #rh-otg-{{ sid }} .rh-otg__item.is-active .rh-otg__rule,
    #rh-otg-{{ sid }} .rh-otg__label,
    #rh-otg-{{ sid }} .rh-otg__circle {
      transition-duration: 0.01s;
      transition-delay: 0s;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('rh-otg-{{ sid }}');
    if (!root) return;
    var circles = root.querySelectorAll('.rh-otg__circle');
    var items = root.querySelectorAll('.rh-otg__item');
    var active = 0;

    function activate(index) {
      if (index === active) return;
      active = index;
      root.style.setProperty('--rh-otg-active', index);
      circles.forEach(function (el, i) {
        el.classList.toggle('is-active', i === index);
        el.setAttribute('aria-pressed', i === index ? 'true' : 'false');
      });
      items.forEach(function (el, i) { el.classList.toggle('is-active', i === index); });
    }

    var canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    circles.forEach(function (el, i) {
      el.addEventListener('mouseenter', function () { if (canHover.matches) activate(i); });
      el.addEventListener('click', function () { activate(i); });
    });
  })();
</script>

{% schema %}
{
  "name": "Rhode PDP · On the go",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Image size" },
    { "type": "select", "id": "image_size", "label": "Image size (desktop)", "options": [
      { "value": "fill", "label": "Match text card" },
      { "value": "original", "label": "Original" },
      { "value": "square", "label": "Square" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" },
      { "value": "custom", "label": "Custom" }
    ], "default": "fill", "info": "Match text card keeps the image as tall as the text beside it." },
    { "type": "range", "id": "image_size_w", "label": "Custom width (desktop)", "min": 1, "max": 40, "step": 1, "default": 4, "visible_if": "{{ section.settings.image_size == 'custom' }}" },
    { "type": "range", "id": "image_size_h", "label": "Custom height (desktop)", "min": 1, "max": 40, "step": 1, "default": 5, "visible_if": "{{ section.settings.image_size == 'custom' }}" },
    { "type": "select", "id": "image_size_mobile", "label": "Image size (mobile)", "options": [
      { "value": "original", "label": "Original" },
      { "value": "square", "label": "Square" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" },
      { "value": "custom", "label": "Custom" }
    ], "default": "custom" },
    { "type": "range", "id": "image_size_mobile_w", "label": "Custom width (mobile)", "min": 1, "max": 40, "step": 1, "default": 4, "visible_if": "{{ section.settings.image_size_mobile == 'custom' }}" },
    { "type": "range", "id": "image_size_mobile_h", "label": "Custom height (mobile)", "min": 1, "max": 40, "step": 1, "default": 3, "visible_if": "{{ section.settings.image_size_mobile == 'custom' }}" },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Take your rhode ON THE GO."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Essentials to throw in your purse or pocket."
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#f1f0ed"
    },
    {
      "type": "color",
      "id": "image_bg_color",
      "label": "Image placeholder background",
      "default": "#e5e3df"
    },
    {
      "type": "color",
      "id": "active_circle_color",
      "label": "Active circle color",
      "default": "#e29fc8"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Model / lifestyle image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Short label (under active circle)",
          "default": "SPOT"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name",
          "default": "spotwear"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "create a comfy, protective bubble to leave spots looking smaller, flatter, and less red"
        },
        {
          "type": "image_picker",
          "id": "graphic",
          "label": "Product graphic (small illustration on the right)"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Rhode PDP · On the go",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
