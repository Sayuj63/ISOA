        {% elsif content_align_mobile == 'right' %}
          @media(max-width: 1024px) {
            .featured-button-{{ block.id }}{
              margin-left: auto;
              margin-right: 0;
            }
          }
        {% endif %}

        .featured-button-inner-{{ block.id }} {
          margin: 0px;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          text-decoration: none;
