<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
>

{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
  assign margin_horizontal = section.settings.margin_horizontal
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign width = section.settings.width
  assign content_width = section.settings.content_width
  assign lazy = section.settings.lazy
  assign section_radius = section.settings.section_radius
  assign background_style = section.settings.background_style

  assign layout = section.settings.layout
  assign layout_mobile = section.settings.layout_mobile
  assign layout_gap = section.settings.layout_gap
  assign layout_gap_mobile = section.settings.layout_gap_mobile

  assign content_bg_color = section.settings.content_bg_color
  assign content_align = section.settings.content_align
  assign content_align_mobile = section.settings.content_align_mobile
  assign content_radius = section.settings.content_radius
  assign content_border_thickness = section.settings.content_border_thickness
  assign content_border_color = section.settings.content_border_color

  assign content_horizontal_align = ''
  if content_align == 'center'
    assign content_horizontal_align = 'center'
  elsif content_align == 'right'
    assign content_horizontal_align = 'end'
  else
    assign content_horizontal_align = 'start'
  endif

  assign content_horizontal_align_mobile = ''
  if content_align_mobile == 'center'
    assign content_horizontal_align_mobile = 'center'
  elsif content_align_mobile == 'right'
    assign content_horizontal_align_mobile = 'end'
  else
    assign content_horizontal_align_mobile = 'start'
  endif

  assign thumbnail_width = section.settings.thumbnail_width
  assign thumbnail_gap = section.settings.thumbnail_gap
  assign thumbnail_ratio = section.settings.thumbnail_ratio
  assign thumbnail_radius = section.settings.thumbnail_radius
  assign thumbnail_border_thickness = section.settings.thumbnail_border_thickness
  assign thumbnail_active_border_color = section.settings.thumbnail_active_border_color

  assign image_width = section.settings.image_width
  assign image_radius = section.settings.image_radius
  assign image_border_thickness = section.settings.image_border_thickness
  assign image_border_color = section.settings.image_border_color

  assign title_custom = section.settings.title_custom
  assign title_font = section.settings.title_font
  assign title_size = section.settings.title_size
  assign title_size_mobile = section.settings.title_size_mobile
  assign title_height = section.settings.title_height
  assign title_color = section.settings.title_color
  assign title_active_color = section.settings.title_active_color
  assign title_mt = section.settings.title_mt
  assign title_mt_mobile = section.settings.title_mt_mobile

  assign description_custom = section.settings.description_custom
  assign description_font = section.settings.description_font
  assign description_size = section.settings.description_size
  assign description_size_mobile = section.settings.description_size_mobile
  assign description_height = section.settings.description_height
  assign description_color = section.settings.description_color

  assign shop_button = section.settings.shop_button
  assign shop_button_style = section.settings.shop_button_style
  assign shop_button_custom = section.settings.shop_button_custom
  assign shop_button_font = section.settings.shop_button_font
  assign shop_button_size = section.settings.shop_button_size
  assign shop_button_size_mobile = section.settings.shop_button_size_mobile
  assign shop_button_height = section.settings.shop_button_height
  assign shop_button_padding_horizontal = section.settings.shop_button_padding_horizontal
  assign shop_button_padding_horizontal_mobile = section.settings.shop_button_padding_horizontal_mobile
  assign shop_button_padding_vertical = section.settings.shop_button_padding_vertical
  assign shop_button_padding_vertical_mobile = section.settings.shop_button_padding_vertical_mobile
  assign shop_button_radius = section.settings.shop_button_radius
  assign shop_button_border_thickness = section.settings.shop_button_border_thickness
  assign buttons_mt = section.settings.buttons_mt
  assign buttons_mt_mobile = section.settings.buttons_mt_mobile
  assign shop_button_color = section.settings.shop_button_color
  assign shop_button_hover_color = section.settings.shop_button_hover_color
  assign shop_button_bg_color = section.settings.shop_button_bg_color
  assign shop_button_bg_hover_color = section.settings.shop_button_bg_hover_color
  assign shop_button_border_color = section.settings.shop_button_border_color
  assign shop_button_border_hover_color = section.settings.shop_button_border_hover_color
  assign shop_button_full_width_mobile = section.settings.shop_button_full_width_mobile
  assign open_in_new_tab = section.settings.open_in_new_tab

  assign arrow_show_desktop = section.settings.arrow_show_desktop
  assign arrow_show_mobile = section.settings.arrow_show_mobile
  assign arrow_size = section.settings.arrow_size
  assign arrow_size_mobile = section.settings.arrow_size_mobile
  assign arrow_icon_size = section.settings.arrow_icon_size
  assign arrow_icon_size_mobile = section.settings.arrow_icon_size_mobile
  assign arrow_radius = section.settings.arrow_radius
  assign arrow_border_thickness = section.settings.arrow_border_thickness
  assign arrow_hover_effect = section.settings.arrow_hover_effect
  assign arrow_color = section.settings.arrow_color
  assign arrow_hover_color = section.settings.arrow_hover_color
  assign arrow_bg_color = section.settings.arrow_bg_color
  assign arrow_bg_hover_color = section.settings.arrow_bg_hover_color
  assign arrow_border_color = section.settings.arrow_border_color
  assign arrow_border_hover_color = section.settings.arrow_border_hover_color

  assign pagination_custom = section.settings.pagination_custom
  assign pagination_font = section.settings.pagination_font
  assign pagination_size = section.settings.pagination_size
  assign pagination_size_mobile = section.settings.pagination_size_mobile
  assign pagination_height = section.settings.pagination_height
  assign pagination_color = section.settings.pagination_color

  assign loading_attribute = 'eager'
  if lazy
    assign loading_attribute = 'lazy'
  endif
-%}

{%- style -%}
  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
    height: 100%;
  }

  .featured-body-{{ section.id }} {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: {{ layout_gap_mobile }}px;
    height: 100%;
  }

  .featured-content-{{ section.id }} {
    grid-area: content;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: {{ content_horizontal_align_mobile }};
    text-align: {{ content_align_mobile }};
    background-color: {{ content_bg_color }};
    padding: 24px;
    border: {{ content_border_thickness }}px solid {{ content_border_color }};
    border-radius: {{ content_radius }}px;
    overflow: hidden;
    height: 100%;
  }

  .featured-bottom-content-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ content_horizontal_align_mobile }};
    text-align: {{ content_align_mobile }};
  }

  .featured-image-wrap-{{ section.id }} {
    grid-area: image;
    height: 100%;
    position: relative;
    display: grid;
  }

  .featured-thumbnails-{{ section.id }} {
    display: none;
    flex-wrap: wrap;
    justify-content: {{ content_horizontal_align_mobile }};
    margin-bottom: 20px;
  }

  .featured-thumbnail-{{ section.id }} {
    cursor: pointer;
    border-radius: {{ thumbnail_radius }}px;
    overflow: hidden;
    transition: all 0.25s ease 0s;
    border: 0px solid transparent;
  }

  .featured-thumbnail-{{ section.id }}.active {
    border: {{ thumbnail_border_thickness }}px solid {{ thumbnail_active_border_color }};
  }

  .featured-thumbnail-{{ section.id }} img,
  .featured-thumbnail-{{ section.id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-thumbnail-{{ section.id }} svg {
    background-color: #AFAFAF;
  }

  .featured-titles-{{ section.id }} {
    display: none;
    flex-direction: column;
    gap: 0px;
  }

  .featured-title-desktop-{{ section.id }} {
    display: none;
  }

  .featured-title-mobile-{{ section.id }} {
    display: block;
    text-align: {{ content_align_mobile }};
  }

  .featured-title-{{ section.id }} {
    cursor: pointer;
    transition: all 0.25s ease 0s;
    margin: 0;
    font-weight: 700;
    margin-top: {{ title_mt_mobile }}px;
    font-size: {{ title_size_mobile }}px;
    color: {{ title_active_color }};
    line-height: {{ title_height }}%;
  }

  .featured-title-{{ section.id }}.active {
    color: {{ title_active_color }};
    transition: all 0.25s ease 0s;
  }

  .featured-buttons-{{ section.id }} {
    display: none;
    gap: 12px;
    justify-content: {{ content_horizontal_align_mobile }};
    flex-wrap: wrap;
    align-items: end;
    margin-top: {{ buttons_mt_mobile }}px;
  }

  .featured-shop-button-{{ section.id }} {
    display: none;
    align-items: center;
    justify-content: center;
    {% if shop_button_full_width_mobile %}
      max-width: 100%;
    {% else %}
      max-width: fit-content;
    {% endif %}
    gap: 10px;
    width: 100%;
    margin: 0;
    margin-top: {{ buttons_mt_mobile }}px;
    font-size: {{ shop_button_size_mobile }}px;
    color: {{ shop_button_color }};
    line-height: {{ shop_button_height }}%;
    text-align: center;
    text-transform: unset;
    text-decoration: none;
    padding: {{ shop_button_padding_vertical_mobile }}px {{ shop_button_padding_horizontal_mobile }}px;
    border-radius: {{ shop_button_radius }}px;
    transition: all 0.25s ease 0s;
    background-color: transparent;
    border: 0px;
    word-break: break-word;
    cursor: pointer;
    font-weight: 700;
    position: relative;
    z-index: 1;
  }

  .featured-shop-button-mobile-{{ section.id }} {
    display: flex;
  }

  {% if content_align_mobile == 'center' %}
    @media(max-width: 1024px) {
      .featured-shop-button-mobile-{{ section.id }} {
        margin-left: auto;
        margin-right: auto;
      }
    }
  {% elsif content_align_mobile == 'right' %}
    @media(max-width: 1024px) {
      .featured-shop-button-mobile-{{ section.id }} {
        margin-left: auto;
        margin-right: 0;
      }
    }
  {% endif %}

  .featured-shop-button-desktop-{{ section.id }} {
    display: none;
  }

  .featured-shop-button-{{ section.id }}:hover {
    color: {{ shop_button_hover_color }};
    transition: all 0.25s ease 0s;
  }

  .featured-shop-button-{{ section.id }} svg {
    width: 14px;
    height: 14px;
  }

  .featured-shop-button-{{ section.id }} svg path {
    fill: {{ shop_button_color }};
    transition: all 0.25s ease 0s;
  }

  .featured-shop-button-{{ section.id }}:hover svg path {
    fill: {{ shop_button_hover_color }};
    transition: all 0.25s ease 0s;
  }

  .featured-slider-{{ section.id }} {
    min-width: 0 !important;
    height: 100%;
    width: 100% !important;
    position: relative;
  }

  .featured-slide-{{ section.id }} {
    position: relative !important;
    box-sizing: border-box !important;
    display: flex !important;
    flex-direction: column !important;
  }

  .featured-slide-image-{{ section.id }} {
    display: block;
    height: 100%;
    border: {{ image_border_thickness }}px solid {{ image_border_color }};
    border-radius: {{ image_radius }}px;
    overflow: hidden;
  }

  .featured-slide-image-{{ section.id }} img,
  .featured-slide-image-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-slide-image-{{ section.id }} svg {
    background-color: #AFAFAF;
  }

  .featured-slide-description-{{ section.id }} {
    margin-top: 10px;
  }

  @media(max-width: 1024px) {
    .featured-slide-description-{{ section.id }} {
      text-align: {{ content_align_mobile }};
    }
  }

  .featured-slide-description-{{ section.id }} * {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: {{ description_size_mobile }}px;
    color: {{ description_color }};
    line-height: {{ description_height }}%;
  }

  .featured-slider-controls-{{ section.id }} {
    position: absolute;
    top: 20px;
    bottom: inherit;
    right: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 3;
  }

  .featured-btn-prev-{{ section.id }},
  .featured-btn-next-{{ section.id }} {
    display: flex;
    position: static !important;
    width: {{ arrow_size_mobile }}px;
    height: {{ arrow_size_mobile }}px;
    border: 0px;
    border: {{ arrow_border_thickness }}px solid {{ arrow_border_color }};
    border-radius: {{ arrow_radius }}px;
    background: transparent;
    background: {{ arrow_bg_color }};
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease 0s;
    cursor: pointer;
    -webkit-appearance: none;
  }

  .featured-btn-prev-{{ section.id }} .animate-icon,
  .featured-btn-next-{{ section.id }} .animate-icon {
    pointer-events: none;
    place-items: center;
    display: grid;
  }

  .featured-btn-prev-{{ section.id }} .animate-icon:before,
  .featured-btn-next-{{ section.id }} .animate-icon:before {
    content: "";
    grid-area: 1 / -1;
    transition: all .2s ease;
    width: {{ arrow_icon_size_mobile }}px;
    height: {{ arrow_icon_size_mobile }}px;
    transform: rotate(calc(1 * 45deg));
    box-sizing: border-box;
    border-style: solid;
    border: 0px;
    border-right: 2px solid currentColor;
    border-top: 2px solid currentColor;
    position: relative;
    left: -1px;
  }

  .featured-btn-prev-{{ section.id }} .animate-icon:before {
    left: unset;
    right: -1px;
    border-right: 0px;
    border-top: 0px;
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
  }

  .featured-btn-prev-{{ section.id }} .animate-icon:after,
  .featured-btn-next-{{ section.id }} .animate-icon:after {
    content: "";
    grid-area: 1 / -1;
    transition: all .2s ease;
    width: {{ arrow_icon_size_mobile | minus: 0.3 }}px;
    height: 1.6px;
    transform-origin: center;
    opacity: 0;
    background: currentColor;
    transform: scaleX(.5);
  }

  .featured-btn-prev-{{ section.id }} span,
  .featured-btn-next-{{ section.id }} span {
    color: {{ arrow_color }};
  }

  .featured-btn-prev-{{ section.id }}.swiper-button-disabled,
  .featured-btn-next-{{ section.id }}.swiper-button-disabled {
    opacity: 0;
  }

  .featured-pagination-{{ section.id }} {
    font-size: {{ pagination_size_mobile }}px;
    color: {{ pagination_color }};
    line-height: {{ pagination_height }}%;
    font-weight: 600;
  }

  @media(min-width: 1024px) {

    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-left: {{ margin_horizontal }}rem;
      margin-right: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
    }

    .section-{{ section.id }}-settings {
      padding: 0 5rem;
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .featured-content-{{ section.id }} {
      align-items: {{ content_horizontal_align }};
      text-align: {{ content_align }};
      padding: 32px;
    }

    .featured-bottom-content-{{ section.id }} {
      align-items: {{ content_horizontal_align }};
      text-align: {{ content_align }};
    }

    .featured-body-{{ section.id }} {
      gap: {{ layout_gap }}px;
    }

    .featured-title-desktop-{{ section.id }} {
      display: block;
    }

    .featured-title-mobile-{{ section.id }} {
      display: none;
    }

    .featured-shop-button-mobile-{{ section.id }} {
      display: none;
    }

    .featured-shop-button-desktop-{{ section.id }} {
      display: flex;
    }

    .featured-thumbnails-{{ section.id }} {
      display: flex;
      gap: {{ thumbnail_gap }}px;
      justify-content: {{ content_horizontal_align }};
    }

    .featured-thumbnail-{{ section.id }} {
      width: {{ thumbnail_width }}px;
    }

    .featured-titles-{{ section.id }} {
      display: flex;
    }

    .featured-slide-description-{{ section.id }} {
      position: absolute;
      bottom: 32px;
      left: 32px;
      right: 80px;
      z-index: 2;
      width: 60%;
    }

    .featured-title-{{ section.id }} {
      margin-top: {{ title_mt }}px;
      font-size: {{ title_size }}px;
      color: {{ title_color }};
    }

    .featured-buttons-{{ section.id }} {
      display: flex;
      justify-content: {{ content_horizontal_align }};
      margin-top: {{ buttons_mt }}px;
    }

    .featured-shop-button-{{ section.id }} {
      max-width: fit-content;
      margin-top: 0;
      padding: {{ shop_button_padding_vertical }}px {{ shop_button_padding_horizontal }}px;
      font-size: {{ shop_button_size }}px;
    }

    .featured-slide-description-{{ section.id }} * {
      font-size: {{ description_size }}px;
    }

    .featured-btn-prev-{{ section.id }},
    .featured-btn-next-{{ section.id }} {
      width: {{ arrow_size }}px;
      height: {{ arrow_size }}px;
      transition: all 0.25s ease 0s;
    }

    .featured-btn-prev-{{ section.id }} .animate-icon:before,
    .featured-btn-next-{{ section.id }} .animate-icon:before {
      width: {{ arrow_icon_size }}px;
      height: {{ arrow_icon_size }}px;
    }

    .featured-btn-prev-{{ section.id }} .animate-icon:after,
    .featured-btn-next-{{ section.id }} .animate-icon:after {
      width: {{ arrow_icon_size | minus: 0.3 }}px;
    }

    .featured-pagination-{{ section.id }} {
      font-size: {{ pagination_size }}px;
    }

    .featured-slider-controls-{{ section.id }} {
      bottom: 32px;
      top: inherit;
    }
  }
{%- endstyle -%}

{% if width == 'custom' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}px;
    }
  </style>
{% elsif width == 'page' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: clamp(100px, var(--page-content-width, var(--page-width)), 100%);
    }
  </style>
{% endif %}

{% if margin_horizontal_mobile > 0 %}
  <style>
    .section-{{ section.id }} {
      border-left: solid {{ border_color }} {{ border_thickness }}px;
      border-right: solid {{ border_color }} {{ border_thickness }}px;
    }

    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: 0px;
        border-right: 0px;
      }
    }
  </style>
{% endif %}

{% if margin_horizontal > 0 %}
  <style>
    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: solid {{ border_color }} {{ border_thickness }}px;
        border-right: solid {{ border_color }} {{ border_thickness }}px;
      }
    }
  </style>
{% endif %}

{% if layout_mobile == 'content_image' %}
  <style>
    .featured-body-{{ section.id }} {
      grid-template-areas:
        "content"
        "image";
    }
  </style>
{% elsif layout_mobile == 'image_content' %}
  <style>
    .featured-body-{{ section.id }} {
      grid-template-areas:
        "image"
        "content";
    }
  </style>
{% endif %}

{% if layout == 'content_image' %}
  <style>
    @media(min-width: 1024px) {
      .featured-body-{{ section.id }} {
        grid-template-columns: auto {{ image_width }}%;
        grid-template-areas: "content image";
      }
    }
  </style>
{% elsif layout == 'image_content' %}
  <style>
    @media(min-width: 1024px) {
      .featured-body-{{ section.id }} {
        grid-template-columns: {{ image_width }}% auto;
        grid-template-areas: "image content";
      }
    }
  </style>
{% endif %}

{% if thumbnail_ratio == 'portrait' %}
  <style>
    .featured-thumbnail-{{ section.id }} {
      aspect-ratio: 2/3;
    }
  </style>
{% elsif thumbnail_ratio == 'square' %}
  <style>
    .featured-thumbnail-{{ section.id }} {
      aspect-ratio: 1/1;
    }
  </style>
{% elsif thumbnail_ratio == 'landscape' %}
  <style>
    .featured-thumbnail-{{ section.id }} {
      aspect-ratio: 3/2;
    }
  </style>
{% else %}
  <style>
    .featured-thumbnail-{{ section.id }} {
      aspect-ratio: auto;
    }
  </style>
{% endif %}

{% if title_custom %}
  <style>
    {{ title_font | font_face: font_display: 'swap' }}

    .featured-title-{{ section.id }} {
      font-family: {{ title_font.family }}, {{ title_font.fallback_families }};
      font-weight: {{ title_font.weight }};
      font-style: {{ title_font.style }};
    }
  </style>
{% endif %}

{% if description_custom %}
  <style>
    {{ description_font | font_face: font_display: 'swap' }}

    .featured-slide-description-{{ section.id }} * {
      font-family: {{ description_font.family }}, {{ description_font.fallback_families }};
      font-weight: {{ description_font.weight }};
      font-style: {{ description_font.style }};
    }
  </style>
{% endif %}

{% if shop_button_custom %}
  <style>
    {{ shop_button_font | font_face: font_display: 'swap' }}

    .featured-shop-button-{{ section.id }} {
      font-family: {{ shop_button_font.family }}, {{ shop_button_font.fallback_families }};
      font-weight: {{ shop_button_font.weight }};
      font-style: {{ shop_button_font.style }};
    }
  </style>
{% endif %}

{% if shop_button_style == 'non_outline' or shop_button_style == 'non_outline_arrow' %}
  <style>
    .featured-shop-button-{{ section.id }} {
      transition: all 0.25s ease 0s;
      background-color: {{ shop_button_bg_color }};
    }

    .featured-shop-button-{{ section.id }}:hover {
      transition: all 0.25s ease 0s;
      background-color: {{ shop_button_bg_hover_color }};
    }
  </style>
{% elsif shop_button_style == 'outline' or shop_button_style == 'outline_arrow' %}
  <style>
    .featured-shop-button-{{ section.id }} {
      transition: all 0.25s ease 0s;
      background-color: {{ shop_button_bg_color }};
      border: {{ shop_button_border_thickness }}px solid {{ shop_button_border_color }};
    }

    .featured-shop-button-{{ section.id }}:hover {
      transition: all 0.25s ease 0s;
      background-color: {{ shop_button_bg_hover_color }};
      border: {{ shop_button_border_thickness }}px solid {{ shop_button_border_hover_color }};
    }
  </style>
{% elsif shop_button_style == 'link' %}
  <style>
    .featured-shop-button-{{ section.id }} {
      padding: 0px !important;
    }
  </style>
{% endif %}

{% if pagination_custom %}
  <style>
    {{ pagination_font | font_face: font_display: 'swap' }}

    .featured-pagination-{{ section.id }} {
      font-family: {{ pagination_font.family }}, {{ pagination_font.fallback_families }};
      font-weight: {{ pagination_font.weight }};
      font-style: {{ pagination_font.style }};
    }
  </style>
{% endif %}

{% if arrow_hover_effect == 'color' %}
  <style>
    .featured-btn-prev-{{ section.id }}:hover,
    .featured-btn-next-{{ section.id }}:hover {
      transition: all 0.25s ease 0s;
      border: {{ arrow_border_thickness }}px solid {{ arrow_border_hover_color }};
      background: {{ arrow_bg_hover_color }};
    }

    .featured-btn-prev-{{ section.id }}:hover .animate-icon,
    .featured-btn-next-{{ section.id }}:hover .animate-icon {
      color: {{ arrow_hover_color }};
    }
  </style>
{% elsif arrow_hover_effect == 'scale' %}
  <style>
    .featured-btn-prev-{{ section.id }}:hover,
    .featured-btn-next-{{ section.id }}:hover {
      transform: scale(0.9);
    }

    @media(min-width: 1024px) {
      .featured-btn-prev-{{ section.id }}:hover,
      .featured-btn-next-{{ section.id }}:hover {
        transform: scale(0.9);
      }
    }
  </style>
{% elsif arrow_hover_effect == 'arrow' %}
  <style>
    .featured-btn-next-{{ section.id }}:hover .animate-icon:before {
      transform: translate(calc(1 * 0.125rem)) rotate(calc(1 * 45deg));
    }

    .featured-btn-prev-{{ section.id }}:hover .animate-icon:before {
      transform: translate(calc(-1 * 0.125rem)) rotate(calc(1 * 45deg));
    }

    .featured-btn-prev-{{ section.id }}:hover .animate-icon:after,
    .featured-btn-next-{{ section.id }}:hover .animate-icon:after {
      opacity: 1;
      transform: scaleX(1);
    }
  </style>
{% endif %}

{% if arrow_show_mobile %}
  <style>
    .featured-btn-prev-{{ section.id }},
    .featured-btn-next-{{ section.id }} {
      display: flex;
    }
  </style>
{% else %}
  <style>
    .featured-btn-prev-{{ section.id }},
    .featured-btn-next-{{ section.id }} {
      display: none;
    }
  </style>
{% endif %}

{% if arrow_show_desktop %}
  <style>
    @media(min-width: 1024px) {
      .featured-btn-prev-{{ section.id }},
      .featured-btn-next-{{ section.id }} {
        display: flex;
      }
    }
  </style>
{% else %}
  <style>
    @media(min-width: 1024px) {
      .featured-btn-prev-{{ section.id }},
      .featured-btn-next-{{ section.id }} {
        display: none;
      }
    }
  </style>
{% endif %}

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'text' %}
      {% if block.settings.text_custom %}
        <style>
          {{ block.settings.text_font | font_face: font_display: 'swap' }}

          .featured-text-{{ block.id }} * {
            font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
            font-weight: {{ block.settings.text_font.weight }};
            font-style: {{ block.settings.text_font.style }};
          }
        </style>
      {% endif %}

      <style>
        .featured-text-{{ block.id }} {
          position: relative;
          z-index: 1;
        }

        .featured-text-{{ block.id }} * {
          margin: 0;
          font-size: {{ block.settings.text_size_mobile }}px;
          color: {{ block.settings.text_color }};
          line-height: {{ block.settings.text_height }}%;
          text-transform: unset;
        }

        @media(min-width: 1024px) {
          .featured-text-{{ block.id }} * {
            font-size: {{ block.settings.text_size }}px;
            margin-bottom: 16px;
          }
        }
      </style>

    {% when 'button' %}
      <style>
        .featured-button-mobile-{{ block.id }} {
          display: flex;
        }

        .featured-button-desktop-{{ block.id }} {
          display: none;
        }

        .featured-button-{{ block.id }} {
          align-items: center;
          justify-content: center;
          gap: 10px;
          width: 100%;
          margin: 0;
          {% if block.settings.button_full_width_mobile %}
            max-width: 100%;
          {% else %}
            max-width: fit-content;
          {% endif %}
          font-size: {{ block.settings.button_size_mobile }}px;
          color: {{ block.settings.button_color }};
          line-height: {{ block.settings.button_height }}%;
          text-align: center;
          text-transform: unset;
          text-decoration: none;
          padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
          border-radius: {{ block.settings.button_radius }}px;
          transition: all 0.25s ease 0s;
          background-color: transparent;
          border: 0px;
          word-break: break-word;
          cursor: pointer;
          font-weight: 700;
          position: relative;
          z-index: 1;
        }

        {% if content_align_mobile == 'center' %}
