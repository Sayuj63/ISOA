      {% if block.settings.button_style == 'non_outline' or block.settings.button_style == 'non_outline_arrow' %}
        <style>
          .featured-button-{{ block.id }} {
            transition: all 0.25s ease 0s;
            background-color: {{ block.settings.button_bg_color }};
          }

          .featured-button-{{ block.id }}:hover {
            transition: all 0.25s ease 0s;
            background-color: {{ block.settings.button_bg_hover_color }};
          }
        </style>
      {% elsif block.settings.button_style == 'outline' or block.settings.button_style == 'outline_arrow' %}
        <style>
          .featured-button-{{ block.id }} {
            transition: all 0.25s ease 0s;
            background-color: {{ block.settings.button_bg_color }};
            border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
          }

          .featured-button-{{ block.id }}:hover {
            transition: all 0.25s ease 0s;
            background-color: {{ block.settings.button_bg_hover_color }};
            border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_hover_color }};
          }
        </style>
      {% elsif block.settings.button_style == 'link' %}
        <style>
          .featured-button-{{ block.id }} {
            padding: 0px !important;
          }
        </style>
      {% endif %}
  {% endcase %}
{% endfor %}

<div
  class="section-{{ section.id }} featured-{{ section.id }}"
  {% if background_style == 'solid' %}
    style="background-color:{{ background_color }};"
  {% else %}
    style="background-image: {{ background_gradient }};"
  {% endif %}
>
  <div class="section-{{ section.id }}-settings">
    <div class="featured-body-{{ section.id }}">
      {% assign slide_blocks = section.blocks | where: 'type', 'slide' %}
      {%- if section.settings.mobile_thumb_1 != blank
          or section.settings.mobile_thumb_2 != blank
          or section.settings.mobile_main != blank
      -%}
        <div class="featured-mobile-static-{{ section.id }}">
          {%- if section.settings.mobile_thumb_1 != blank or section.settings.mobile_thumb_2 != blank -%}
            <div class="featured-mobile-thumbs-{{ section.id }}">
              <div class="featured-mobile-thumb-{{ section.id }}">
                {% if section.settings.mobile_thumb_1 != blank %}
                  {{
                    section.settings.mobile_thumb_1
                    | image_url: width: 750
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 0px, 45vw',
                      widths: '240, 375, 550, 750',
                      alt: section.settings.mobile_thumb_1.alt
                  }}
                {% endif %}
              </div>
              <div class="featured-mobile-thumb-{{ section.id }}">
                {% if section.settings.mobile_thumb_2 != blank %}
                  {{
                    section.settings.mobile_thumb_2
                    | image_url: width: 750
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 0px, 45vw',
                      widths: '240, 375, 550, 750',
                      alt: section.settings.mobile_thumb_2.alt
                  }}
                {% endif %}
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.mobile_main != blank -%}
            <div class="featured-mobile-main-{{ section.id }}">
              {{
                section.settings.mobile_main
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 0px, 92vw',
                  widths: '375, 550, 750, 950, 1200',
                  alt: section.settings.mobile_main.alt
              }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% if slide_blocks.size > 0 %}
        <div class="featured-mobile-steps-{{ section.id }}" data-featured-mobile-steps>
          {% for block in section.blocks %}
            {% if block.type == 'text' %}
              <p class="featured-mobile-eyebrow-{{ section.id }}">{{ block.settings.text | strip_html }}</p>
            {% endif %}
          {% endfor %}

          {% for block in slide_blocks %}
            <article
              class="featured-mobile-step-{{ section.id }}{% if forloop.first %} is-active{% endif %}"
              data-featured-mobile-step="{{ forloop.index0 }}"
              {% unless forloop.first %}hidden{% endunless %}
              aria-label="Application step {{ forloop.index }} of {{ slide_blocks.size }}"
            >
              <p class="featured-mobile-step-title-{{ section.id }}">
                <span class="featured-mobile-step-number-{{ section.id }}">(0{{ forloop.index }})</span>
                {{ block.settings.title }}
              </p>
              <button
                type="button"
                class="featured-mobile-step-next-{{ section.id }}"
                data-featured-mobile-next
                aria-label="Show application step {% if forloop.last %}1{% else %}{{ forloop.index | plus: 1 }}{% endif %}"
              >
                <span aria-hidden="true">→</span>
              </button>
            </article>
          {% endfor %}
        </div>
      {% endif %}

      <div class="featured-content-{{ section.id }}">
        {% if slide_blocks.size > 0 %}
          <div class="featured-thumbnails-{{ section.id }}">
            {% for block in slide_blocks %}
              <div
                class="featured-thumbnail-{{ section.id }} {% if forloop.first %}active{% endif %}"
                data-slide-index="{{ forloop.index0 }}"
                data-id="{{ block.id }}"
              >
                {% if block.settings.thumbnail_image != blank %}
                  {{
                    block.settings.thumbnail_image
                    | image_url: width: 375
                    | image_tag:
                      loading: loading_attribute,
                      sizes: '(min-width: 1024px) 100vw, 100vw',
                      widths: '375, 550, 750',
                      alt: block.settings.thumbnail_image.alt
                    | escape
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <div class="featured-bottom-content-{{ section.id }}">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'text' %}
                <div class="featured-text-{{ block.id }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
            {% endcase %}
          {% endfor %}

          {% if slide_blocks.size > 0 %}
            <div class="featured-titles-{{ section.id }}">
              {% for block in slide_blocks %}
                <div
                  class="featured-title-{{ section.id }} featured-title-desktop-{{ section.id }} {% if forloop.first %}active{% endif %}"
                  data-slide-index="{{ forloop.index0 }}"
                  data-id="{{ block.id }}"
                >
                  {{ block.settings.title }}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          <div class="featured-buttons-{{ section.id }}">
            {% if shop_button != blank %}
              <a
                href="#"
                class="featured-shop-button-{{ section.id }} featured-shop-button-desktop-{{ section.id }}"
                {% if open_in_new_tab %}
                  target="_blank"
                {% endif %}
                id="shop-button-{{ section.id }}"
              >
                {{ shop_button }}
                {% if shop_button_style == 'non_outline_arrow' or shop_button_style == 'outline_arrow' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                    <path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                  </svg>
                {% endif %}
              </a>
            {% endif %}

            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'button' %}
                  {% if block.settings.button != blank %}
                    <a
                      href="{{ block.settings.url | default: '#' }}"
                      class="featured-button-{{ block.id }} featured-button-desktop-{{ block.id }}"
                      {% if block.settings.open_in_new_tab %}
                        target="_blank"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <span class="featured-button-inner-{{ block.id }}">
                        {{ block.settings.button }}
                        {% if block.settings.button_style == 'non_outline_arrow'
                          or block.settings.button_style == 'outline_arrow'
                        %}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                            <path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                          </svg>
                        {% endif %}
                      </span>
                    </a>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="featured-image-wrap-{{ section.id }} ">
        {% if slide_blocks.size > 0 %}
          <div class="featured-slider-{{ section.id }} swiper">
            <div class="swiper-wrapper">
              {% for block in slide_blocks %}
                <div
                  class="swiper-slide featured-slide-{{ section.id }}"
                  data-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="featured-slide-image-{{ section.id }}">
                    {% if block.settings.main_image != blank %}
                      {{
                        block.settings.main_image
                        | image_url: width: 1500
                        | image_tag:
                          loading: loading_attribute,
                          sizes: '(min-width: 1024px) 100vw, 100vw',
                          widths: '375, 550, 750, 950, 1100, 1400',
                          alt: block.settings.main_image.alt
                        | escape
                      }}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag }}
                    {% endif %}
                  </div>
                  <div class="featured-title-{{ section.id }} featured-title-mobile-{{ section.id }}">
                    {{ block.settings.title }}
                  </div>

                  {% if block.settings.description != blank %}
                    <div class="featured-slide-description-{{ section.id }}">
                      {{ block.settings.description }}
                    </div>
                  {% endif %}

                  {% if shop_button != blank %}
                    <a
                      href="{{ block.settings.url }}"
                      {% if open_in_new_tab %}
                        target="_blank"
                      {% endif %}
                      class="featured-shop-button-{{ section.id }} featured-shop-button-mobile-{{ section.id }}"
                    >
                      {{ shop_button }}
                      {% if shop_button_style == 'non_outline_arrow' or shop_button_style == 'outline_arrow' %}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                          <path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                        </svg>
                      {% endif %}
                    </a>
                  {% endif %}
                </div>
              {% endfor %}
            </div>

            <div class="featured-slider-controls-{{ section.id }}">
              <div class="featured-btn-prev-{{ section.id }}">
                <span class="animate-icon"></span>
              </div>

              <div class="featured-pagination-{{ section.id }}">
                <span class="swiper-pagination-current">1</span>/<span class="swiper-pagination-total">
                  {{- slide_blocks.size -}}
                </span>
              </div>

              <div class="featured-btn-next-{{ section.id }}">
                <span class="animate-icon"></span>
              </div>
            </div>
          </div>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'button' %}
            {% if block.settings.button != blank %}
              <a
                href="{{ block.settings.url | default: '#' }}"
                class="featured-button-{{ block.id }} featured-button-mobile-{{ block.id }}"
                {% if block.settings.open_in_new_tab %}
                  target="_blank"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <span class="featured-button-inner-{{ block.id }}">
                  {{ block.settings.button }}
                  {% if block.settings.button_style == 'non_outline_arrow'
                    or block.settings.button_style == 'outline_arrow'
                  %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                      <path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
                    </svg>
                  {% endif %}
                </span>
              </a>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  function initFeaturedProducts4() {
    const swiperEl = document.querySelector(`.featured-slider-{{ section.id }}`);
    
    if (!swiperEl) return;

    const slidesData = [
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          {
            id: '{{ block.id }}',
            url: '{{ block.settings.url | default: "#" }}'
          }{% unless forloop.last %},{% endunless %}
        {% endif %}
      {% endfor %}
    ];

    const swiper = new Swiper(swiperEl, {
      slidesPerView: 1,
      spaceBetween: 10,
      autoHeight: true,
      navigation: {
        nextEl: `.featured-slider-{{ section.id }} .featured-btn-next-{{ section.id }}`,
        prevEl: `.featured-slider-{{ section.id }} .featured-btn-prev-{{ section.id }}`,
      },
      on: {
        slideChange: function() {
          updateActiveElements(this.realIndex);
        }
      }
    });

    function updateActiveElements(realIndex) {
      const slideData = slidesData[realIndex];
      
      const thumbnails = document.querySelectorAll(`.featured-thumbnail-{{ section.id }}`);
      thumbnails.forEach((thumb, index) => {
        if (index === realIndex) {
          thumb.classList.add('active');
        } else {
          thumb.classList.remove('active');
        }
      });

      const titles = document.querySelectorAll(`.featured-title-desktop-{{ section.id }}`);
      titles.forEach((title, index) => {
        if (index === realIndex) {
          title.classList.add('active');
        } else {
          title.classList.remove('active');
        }
      });

      const shopButton = document.getElementById(`shop-button-{{ section.id }}`);
      if (shopButton && slideData) {
        shopButton.href = slideData.url;
      }

      const paginationCurrent = document.querySelector(`.featured-slider-{{ section.id }} .swiper-pagination-current`);
      if (paginationCurrent) {
        paginationCurrent.textContent = realIndex + 1;
      }
    }

    const thumbnails = document.querySelectorAll(`.featured-thumbnail-{{ section.id }}`);
    thumbnails.forEach((thumb) => {
      thumb.addEventListener('click', function() {
        const slideIndex = parseInt(this.getAttribute('data-slide-index'));
        if (!isNaN(slideIndex)) {
          swiper.slideTo(slideIndex);
        }
      });
    });

    const titles = document.querySelectorAll(`.featured-title-desktop-{{ section.id }}`);
    titles.forEach((title) => {
      title.addEventListener('click', function() {
        const slideIndex = parseInt(this.getAttribute('data-slide-index'));
        if (!isNaN(slideIndex)) {
          swiper.slideTo(slideIndex);
        }
      });
    });

    const mobileStepsRoot = document.querySelector(`.featured-mobile-steps-{{ section.id }}`);
    if (mobileStepsRoot) {
      const mobileSteps = Array.from(mobileStepsRoot.querySelectorAll('[data-featured-mobile-step]'));
      const mobileNextButtons = mobileStepsRoot.querySelectorAll('[data-featured-mobile-next]');
      let mobileIndex = 0;

      function showMobileStep(index) {
        mobileIndex = (index + mobileSteps.length) % mobileSteps.length;
        mobileSteps.forEach((step, stepIndex) => {
          const active = stepIndex === mobileIndex;
          step.classList.toggle('is-active', active);
          step.hidden = !active;
        });
        mobileNextButtons.forEach((button) => {
          const nextStep = (mobileIndex + 1) % mobileSteps.length + 1;
          button.setAttribute('aria-label', `Show application step ${nextStep}`);
        });
      }

      mobileNextButtons.forEach((button) => {
        button.addEventListener('click', () => showMobileStep(mobileIndex + 1));
      });
    }

    updateActiveElements(0);
  }

  document.addEventListener('DOMContentLoaded', initFeaturedProducts4);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initFeaturedProducts4);
    document.addEventListener('shopify:section:load', initFeaturedProducts4);
  }
</script>

