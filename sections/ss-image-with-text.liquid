<style>
  /* Align this section's inner pill width with SS - Header #1's inner pill.
     The 'page' branch above uses clamp(100px, --page-content-width, 100%) which
     resolves to full viewport width on normal screens — wider than the header pill.
     This override switches to the same min(--page-width - 2*--page-margin,
     calc(100% - 2*--page-margin)) formula ss-header-1.liquid:120-123 uses, so the
     section content lines up flush with the header. Outer horizontal margin is
     zeroed so 100% inside the inner resolves to viewport, matching what the
     fixed-positioned header pill computes. All other editor controls (vertical
     margins, padding, layout, border, shadow, content_width when width='custom')
     are left intact. -vamshi */
  .section-{{ section.id }} {
    margin-left: 0;
    margin-right: 0;
    border-left: 0;
    border-right: 0;
  }

  .section-{{ section.id }}-settings {
    width: 100% !important;
    max-width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    ) !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }
</style>

