{%- liquid 
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
  assign margin_horizontal = section.settings.margin_horizontal
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign outer_background_color = section.settings.outer_background_color
  assign width = section.settings.width
  assign content_width = section.settings.content_width
  assign lazy = section.settings.lazy
  assign section_radius = section.settings.section_radius
  assign background_style = section.settings.background_style
  assign use_shadow = section.settings.use_shadow

  assign layout = section.settings.layout
  assign layout_mobile = section.settings.layout_mobile
  assign layout_gap = section.settings.layout_gap
  assign layout_gap_mobile = section.settings.layout_gap_mobile
  assign layout_border_thickness = section.settings.layout_border_thickness
  assign layout_border_color = section.settings.layout_border_color
  assign layout_radius = section.settings.layout_radius

  assign shadow_color = section.settings.shadow_color

  assign image = section.settings.image
  assign image_ratio = section.settings.image_ratio
  assign image_ratio_mobile = section.settings.image_ratio_mobile
  assign image_radius = section.settings.image_radius
  assign image_border_thickness = section.settings.image_border_thickness
  assign image_border_color = section.settings.image_border_color

  assign content_align = section.settings.content_align
  assign content_align_mobile = section.settings.content_align_mobile
  assign content_vertical_align = section.settings.content_vertical_align

  assign content_horizontal_align = ""
  if content_align == "center"
    assign content_horizontal_align = "center"
  elsif content_align == "right"
    assign content_horizontal_align = "end"
  else
    assign content_horizontal_align = "start"
  endif

  assign content_horizontal_align_mobile = ""
  if content_align_mobile == "center"
    assign content_horizontal_align_mobile = "center"
  elsif content_align_mobile == "right"
    assign content_horizontal_align_mobile = "end"
  else
    assign content_horizontal_align_mobile = "start"
  endif

  assign loading_attribute = 'eager'
  if lazy
    assign loading_attribute = 'lazy'
  endif
-%}

{%- style -%}
  
  .section-{{ section.id }} {
    {% if use_shadow %}
      padding: 0 {{ padding_horizontal_mobile }}rem;
    {% endif %}
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
  }
  
  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
    border: {{ layout_border_thickness }}px solid {{ layout_border_color }};
    border-radius: {{ layout_radius }}px;
    {% if use_shadow %}
      box-shadow: 
        0px 4.5px 2px {{ shadow_color | color_modify: 'alpha', 0.02 }},
        0px 8.1px 4.7px {{ shadow_color | color_modify: 'alpha', 0.02 }},
        0px 10.7px 8.5px {{ shadow_color | color_modify: 'alpha', 0.03 }},
        0px 12.8px 14.1px {{ shadow_color | color_modify: 'alpha', 0.03 }},
        0px 14.8px 23.3px {{ shadow_color | color_modify: 'alpha', 0.04 }},
        0px 17.9px 40.7px {{ shadow_color | color_modify: 'alpha', 0.05 }},
        0px 29px 88px {{ shadow_color | color_modify: 'alpha', 0.06 }};
    {% endif %}
  }

  .image-with-body-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ layout_gap_mobile }}px;
  }

  .image-with-content-{{ section.id }} {
    grid-area: content;
    display: flex;
    flex-direction: column;
    align-items: {{ content_horizontal_align_mobile }};
    justify-content: start;
  }

  .image-with-image-{{ section.id }} {
    grid-area: image;
    border: {{ image_border_thickness }}px solid {{ image_border_color }};
    border-radius: {{ image_radius }}px;
    overflow: hidden;
  }

  .image-with-image-{{ section.id }} img,
  .image-with-image-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-image-{{ section.id }} svg {
    background-color: #AFAFAF;
  }
  
  @media(min-width: 1024px) {

    .section-{{ section.id }} {
      {% if use_shadow %}
        padding: 0 {{ padding_horizontal }}rem;
      {% endif %}
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-left: {{ margin_horizontal }}rem;
      margin-right: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
    }
    
    .section-{{ section.id }}-settings {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .image-with-body-{{ section.id }} {
      grid-template-columns: 1fr 1fr;
      gap: {{ layout_gap }}px;
    }

    .image-with-content-{{ section.id }} {
      align-items: {{ content_horizontal_align }};
      justify-content: {{ content_vertical_align }};
    }
  }
  
{%- endstyle -%}

{% if width == 'custom' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}px;
    }
  </style>
{% elsif width == 'page' %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: clamp(100px, var(--page-content-width, var(--page-width)), 100%);
    }
  </style>
{% endif %}

{% if margin_horizontal_mobile > 0 %}
  <style>
    .section-{{ section.id }} {
      border-left: solid {{ border_color }} {{ border_thickness }}px;
      border-right: solid {{ border_color }} {{ border_thickness }}px;
    }
    
    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: 0px;
        border-right: 0px;
      }
    }
  </style>
{% endif %}

{% if margin_horizontal > 0 %}
  <style>
    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: solid {{ border_color }} {{ border_thickness }}px;
        border-right: solid {{ border_color }} {{ border_thickness }}px;
      }
    }
  </style>
{% endif %}


{% if layout_mobile == 'content_image'%}
  <style>
    .image-with-body-{{ section.id }} {
      grid-template-areas: 
        "content"
        "image";     
    }
  </style>
{% elsif layout_mobile == 'image_content' %}
  <style>
    .image-with-body-{{ section.id }} {
      grid-template-areas: 
        "image"
        "content";     
    }
  </style>
{% endif %}

{% if layout == 'content_image'%}
  <style>
    @media(min-width: 1024px) {
      .image-with-body-{{ section.id }} {
        grid-template-areas: "content image";    
      }
    }    
  </style>
{% elsif layout == 'image_content' %}
  <style>
    @media(min-width: 1024px) {
      .image-with-body-{{ section.id }} {
        grid-template-areas: "image content";   
      }
    }   
  </style>
{% endif %}


{% if image_ratio_mobile == "portrait" %}
  <style>
    .image-with-image-{{ section.id }} {
      aspect-ratio: 12/10;
    }
  </style>
{% elsif image_ratio_mobile == "landscape" %}
  <style>
  .image-with-image-{{ section.id }} {
    aspect-ratio: 12/8;
  }
  </style>
{% elsif image_ratio_mobile == "square" %}
  <style>
    .image-with-image-{{ section.id }} {
      aspect-ratio: 12/9;
    }
  </style>
{% else %}
  <style>
    .image-with-image-{{ section.id }} {
      aspect-ratio: auto;
    }
  </style>
{% endif %}

{% if image_ratio == "portrait" %}
  <style>
    @media(min-width: 1024px) {
      .image-with-image-{{ section.id }} {
        aspect-ratio: 12/10;
      }
    }
    
  </style>
{% elsif image_ratio == "landscape" %}
  <style>
    @media(min-width: 1024px) {
      .image-with-image-{{ section.id }} {
        aspect-ratio: 12/8;
      }
    }  
  </style>
{% elsif image_ratio == "square" %}
  <style>
    @media(min-width: 1024px) {
      .image-with-image-{{ section.id }} {
        aspect-ratio: 12/9;
      }
    }    
  </style>
{% else %}
  <style>
     @media(min-width: 1024px) {
      .image-with-image-{{ section.id }} {
        aspect-ratio: auto;
      }
    }
  </style>
{% endif %}

<style>
  /* Structure mirrors the announcement bar: outer = full viewport width (its bg is driven by the "Outer section background" picker in the theme editor), inner pill width = same min() formula the .section grid uses for the announcement bar — so they line up. -vamshi */
  .section-{{ section.id }} {
    background-image: none !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    border-left: 0 !important;
    border-right: 0 !important;
    border-radius: 0 !important;
  }

  .section-{{ section.id }}-settings {
    max-width: min(var(--page-width) - var(--page-margin) * 2, calc(100% - var(--page-margin) * 2)) !important;
    margin-inline: auto !important;
    padding: 0 !important;
    {%- unless template == 'product.rhode-product-page' -%}
    overflow: hidden !important;
    /* Grey pill box — same #f1f0ed as header inner pill; border-radius matches the 10px used across other sections. overflow:hidden above clips the image's outer corners so no per-element radius tricks are needed. Off on the PDP because that template shows image + text as two separate cards with a gap. -vamshi */
    background-color: #f1f0ed !important;
    border-radius: 10px !important;
    {%- endunless -%}
  }

  .image-with-body-{{ section.id }} {
    {%- if template == 'product.rhode-product-page' -%}
    /* PDP: two separate cards with a 16px column gap (matches the site-wide split gap). */
    gap: 16px !important;
    {%- else -%}
    /* Everywhere else: image + content abut cleanly at the column boundary. -vamshi */
    gap: 0 !important;
    {%- endif -%}
  }

  /* Reverted to the previous (pre-2026-06-02-late) alignment per client: bottom-pinned
     cluster via `justify-content: flex-end`. Mobile horizontal padding tightened from
     32/48 → 16/24 so the heading sits closer to the card edges (client ask: "reduce
     the padding and close to the edges"). Asymmetric L>R kept from the earlier
     image-8 fix. Desktop padding (64px) unchanged. -vamshi */
  .image-with-content-{{ section.id }} {
    align-items: flex-start !important;
    justify-content: flex-end !important;
    padding: 16px 16px 16px 24px !important;
  }

  @media(min-width: 1024px) {
    .image-with-content-{{ section.id }} {
      padding: 64px !important;
    }
  }

  {%- unless template == 'product.rhode-product-page' -%}
  /* Image: no radius — the parent grey box (overflow:hidden + border-radius:10px) clips
     all outer corners. Inner edge is sharp (gap:0 between columns). Off on the PDP so
     image + content each render as their own rounded card. -vamshi */
  .image-with-image-{{ section.id }} {
    border-radius: 0 !important;
    border: 0 !important;
    overflow: hidden !important;
  }

  /* Content card: no radius — parent grey box handles all corner clipping. -vamshi */
  .image-with-content-{{ section.id }} {
    border-radius: 0 !important;
  }

  @media (min-width: 1024px) {
    .image-with-content-{{ section.id }} {
      border-radius: 0 !important;
    }
  }
  {%- endunless -%}

  {%- if template == 'product.rhode-product-page' -%}
  /* PDP: image + content are separate rounded cards. Both use 10px radius,
     matching the rest of the PDP section cards. -vamshi */
  .image-with-image-{{ section.id }} {
    border-radius: 10px;
    overflow: hidden;
  }
  .image-with-content-{{ section.id }} {
    border-radius: 10px;
  }
  {%- endif -%}

  /* Button — exact OUR VALUES pill style (ss-image-with-text-15.liquid:293-327).
     The button block at index.json `button_9pVLiq` is configured `button_style:
     non_outline` with bg #121212 / text #ffffff — schema-driven CSS at this file's
     lines 482-541 / 554-565 paints a SOLID DARK button, which is NOT what the
     client wants. We override every property the schema sets, with `!important`
     and a specificity of (0,0,3,0) via `.shopify-section .image-with-content-{id}
     a[class*="image-with-button-"]` so we win against:
       - per-block .image-with-button-{block.id} (0,0,1,0)
       - non_outline conditional `.image-with-button-{block.id} { background-color }`
         (0,0,1,0)
       - site-wide isoua-button-overrides.css (0,0,2,0) — we just match its result.
     The button markup ALSO carries `.isoua-pill-button` (added above) — redundant
     with this rule but ensures the global .isoua-pill-button styling (defined in
     ss-image-with-text-15) applies even without the override. -vamshi */
  .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"],
  .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"] {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 14px 32px !important;
    border: 1px solid #67645e !important;
    border-radius: 999px !important;
    background-color: #ffffff !important;
    background-image: none !important;
    color: #67645e !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    letter-spacing: 1px !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    transition: all 0.3s ease !important;
    width: fit-content !important;
    max-width: fit-content !important;
    box-shadow: none !important;
  }

  /* Hover: white text + border; ::before fill (added below) handles the visual background. */
  .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"]:hover,
  .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"]:hover {
    background-color: transparent !important;
    color: #ffffff !important;
    border-color: #67645e !important;
  }

  /* Inner <p class="image-with-button-inner-{id}"> — schema CSS sets fonts/sizes
     here. Force inherit so the parent <a>'s OUR VALUES typography wins. */
  .shopify-section .image-with-content-{{ section.id }} [class*="image-with-button-inner-"] {
    color: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    letter-spacing: inherit !important;
    text-transform: inherit !important;
    background: transparent !important;
    margin: 0 !important;
    position: relative !important;
    z-index: 1 !important;
  }

  /* Mobile sizing — Rhode-parity thin pill (2026-08-12).
     Old value (12x24 / 13px) was reading oversized against Rhode's mobile
     reference; new value matches the site-wide standard in
     assets/isoua-button-overrides.css @media (max-width:768px). */
  @media screen and (max-width: 768px) {
    .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"],
    .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"] {
      padding: 7px 22px !important;
      font-size: 11px !important;
      font-weight: 500 !important;
      letter-spacing: 0.04em !important;
      line-height: 1.2 !important;
    }
  }

  /* Direction-based fill hover */
  .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"],
  .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"] {
    position: relative !important;
    overflow: hidden !important;
    transition: color 0.15s ease 0.2s, border-color 0.3s ease !important;
  }

  .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"]::before,
  .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"]::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #67645e;
    border-radius: inherit;
    transform: translateY(101%);
    transition: transform 0.45s cubic-bezier(.76, 0, .24, 1);
    z-index: 0;
    will-change: transform;
    pointer-events: none;
  }

  .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"][data-dir="top"]::before,
  .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"][data-dir="top"]::before    { transform: translateY(-101%); }
  .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"][data-dir="bottom"]::before,
  .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"][data-dir="bottom"]::before { transform: translateY(101%);  }
  .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"][data-dir="left"]::before,
  .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"][data-dir="left"]::before   { transform: translateX(-101%); }
  .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"][data-dir="right"]::before,
  .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"][data-dir="right"]::before  { transform: translateX(101%);  }

  .shopify-section .image-with-content-{{ section.id }} a[class*="image-with-button-"]:hover::before,
  .shopify-section .image-with-content-{{ section.id }} div[class*="image-with-button-"]:hover::before {
    transform: translate(0, 0);
  }
</style>

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'heading' %}  
      <style>
        {{  block.settings.heading_font | font_face: font_display: 'swap' }}

        .image-with-heading-{{ block.id }} {
          margin-top: {{ block.settings.heading_mt_mobile }}px;
          text-align: {{ content_align_mobile }};
          position: relative;
          z-index: 2;
        }
      
        .image-with-heading-{{ block.id }} * {
          margin: 0;
          font-size: {{ block.settings.heading_size_mobile }}px;
          color: {{ block.settings.heading_color }};
          line-height: {{ block.settings.heading_height }}%;
          text-transform: unset;
          word-break: break-word;
          font-weight: 700;
        }

        @media(min-width: 1024px) {
          
          .image-with-heading-{{ block.id }} {
            margin-top: {{ block.settings.heading_mt }}px;
            text-align: {{ content_align }};
          }
        
          .image-with-heading-{{ block.id }} * {
            font-size: {{ block.settings.heading_size }}px;
          }
        }          
      </style>
        
      {% if block.settings.heading_custom %}
        <style>
          .image-with-heading-{{ block.id }} * {
            font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
            font-weight: {{ block.settings.heading_font.weight }};
            font-style: {{ block.settings.heading_font.style }};
          }
        </style>
      {% endif %}
    


    {% when 'text' %}
      <style>        
        {{  block.settings.text_font | font_face: font_display: 'swap' }}

        .image-with-text-{{ block.id }} {
          margin-top: {{ block.settings.text_mt_mobile }}px;
          text-align: {{ content_align_mobile }};
        }

        .image-with-text-{{ block.id }} * {
          margin: 0;          
          font-size: {{ block.settings.text_size_mobile }}px;
          color: {{ block.settings.text_color }};
          line-height: {{ block.settings.text_height }}%;
          text-transform: unset;
        }

        @media(min-width: 1024px) {
          
          .image-with-text-{{ block.id }} {
            margin-top: {{ block.settings.text_mt }}px;
            text-align: {{  content_align }};
          }         
          
          .image-with-text-{{ block.id }} * {       
            font-size: {{ block.settings.text_size }}px;
          }
        }
      </style>

      {% if block.settings.text_custom %}
        <style>
          .image-with-text-{{ block.id }} * {
            font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
            font-weight: {{ block.settings.text_font.weight }};
            font-style: {{ block.settings.text_font.style }};
          }
        </style>          
      {% endif %}  
    {% when 'button' %}
      <style>
        {{  block.settings.button_font | font_face: font_display: 'swap' }}

        .image-with-button-{{ block.id }} {
          display: flex;
          align-items: center;
          justify-content: center;
          max-width: fit-content;
          gap: 10px;
          width: 100%;
          margin: 0;
          margin-top: {{ block.settings.button_mt_mobile }}px;
          font-size: {{ block.settings.button_size_mobile }}px;
          color: {{ block.settings.button_color }};
          line-height: {{ block.settings.button_height }}%;
          text-align: center;
          text-transform: unset;
          text-decoration: none;
          padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
          border-radius: {{ block.settings.button_radius }}px;
          transition: all 0.3s ease 0s;
          background-color: transparent;
          border: 0px;
          cursor: pointer;
          font-weight: 700;
        }

        .image-with-button-inner-{{ block.id }} {
          margin: 0px;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          text-decoration: none;
        }

        .image-with-button-{{ block.id }}:hover {
          color: {{ block.settings.button_hover_color }};
          transition: all 0.25s ease 0s;
        }

        .image-with-button-{{ block.id }} svg {
          width: 14px;
          height: 14px;
        }

        .image-with-button-{{ block.id }} svg path {
          fill: {{ block.settings.button_color }};
          transition: all 0.25s ease 0s;
        }

        .image-with-button-{{ block.id }}:hover svg path {
          fill: {{ block.settings.button_hover_color }};
          transition: all 0.25s ease 0s;
        }

        @media (min-width: 1024px) {
          .image-with-button-{{ block.id }} {
            margin-top: {{ block.settings.button_mt }}px;
            padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
            font-size: {{ block.settings.button_size }}px;
          }
        }
      </style>

      {% if block.settings.button_custom %}
        <style>
          .image-with-button-{{ block.id }} {
            font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
            font-weight: {{ block.settings.button_font.weight }};
