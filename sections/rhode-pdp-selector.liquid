{% comment %}Rhode PDP — Product selector: 2-col pill, numbered circles, swap product card{% endcomment %}
{%- assign sid = section.id -%}
<style>
.rhode-sel-{{ sid }} {
  padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
}
.rhode-sel-{{ sid }} .rsel-inner {
  max-width: min(
    calc(var(--page-width, 1200px) - var(--page-margin, 40px) * 2),
    calc(100% - var(--page-margin, 40px) * 2)
  );
  margin-inline: auto;
  border-radius: 10px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 540px;
}
/* ── LEFT column ── */
.rhode-sel-{{ sid }} .rsel-left {
  background-color: {{ section.settings.left_bg }};
  display: flex;
  flex-direction: column;
  padding: 36px 44px;
}
/* Editorial text at top */
.rhode-sel-{{ sid }} .rsel-editorial {
  font-family: josefin_sans_n4, 'Josefin Sans', sans-serif;
  font-size: clamp(13px, 1.3vw, 16px);
  font-style: italic;
  color: {{ section.settings.label_color }};
  max-width: 340px;
  line-height: 1.6;
  margin: 0 0 0 0;
  flex-shrink: 0;
}
/* Middle: product card (flex:1, centered) */
.rhode-sel-{{ sid }} .rsel-card-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-block: 24px;
  position: relative;
  min-height: 280px;
}
.rhode-sel-{{ sid }} .rsel-card {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.35s ease, transform 0.35s ease;
  pointer-events: none;
}
.rhode-sel-{{ sid }} .rsel-card.is-active {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
  position: relative;
}
.rhode-sel-{{ sid }} .rsel-swatch {
  width: 180px;
  height: 180px;
  object-fit: contain;
  display: block;
  margin-bottom: 20px;
}
.rhode-sel-{{ sid }} .rsel-name {
  font-family: josefin_sans_n4, 'Josefin Sans', sans-serif;
  font-size: clamp(16px, 1.8vw, 22px);
  font-weight: 600;
  color: {{ section.settings.name_color }};
  margin: 0 0 10px;
}
.rhode-sel-{{ sid }} .rsel-desc {
  font-family: josefin_sans_n4, 'Josefin Sans', sans-serif;
  font-size: var(--isoa-body-md);
  font-weight: 400;
  line-height: 1.65;
  color: {{ section.settings.desc_color }};
  max-width: 280px;
  margin: 0;
}
/* Bottom: numbered circles */
.rhode-sel-{{ sid }} .rsel-circles {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  flex-shrink: 0;
}
.rhode-sel-{{ sid }} .rsel-circle-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.rhode-sel-{{ sid }} .rsel-circle {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 1.5px solid {{ section.settings.label_color }};
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: josefin_sans_n4, 'Josefin Sans', sans-serif;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: {{ section.settings.label_color }};
  transition: background 0.22s ease, color 0.22s ease;
  padding: 0;
}
.rhode-sel-{{ sid }} .rsel-circle.is-active {
  background: {{ section.settings.active_circle_color }};
  border-color: {{ section.settings.active_circle_color }};
  color: #fff;
}
.rhode-sel-{{ sid }} .rsel-circle-label {
  font-family: josefin_sans_n4, 'Josefin Sans', sans-serif;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: {{ section.settings.label_color }};
  text-align: center;
  opacity: 0;
  transition: opacity 0.22s ease;
  white-space: nowrap;
}
.rhode-sel-{{ sid }} .rsel-circle-wrap.is-active .rsel-circle-label {
  opacity: 1;
}
/* ── RIGHT column ── */
.rhode-sel-{{ sid }} .rsel-right {
  position: relative;
  overflow: hidden;
  min-height: 400px;
}
.rhode-sel-{{ sid }} .rsel-right img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
/* ── Mobile ── */
@media (max-width: 749px) {
  .rhode-sel-{{ sid }} .rsel-inner {
    grid-template-columns: 1fr;
  }
  .rhode-sel-{{ sid }} .rsel-right {
    min-height: 280px;
    order: -1;
  }
  .rhode-sel-{{ sid }} .rsel-left {
    padding: 28px 24px;
  }
  .rhode-sel-{{ sid }} .rsel-swatch {
    width: 120px;
    height: 120px;
  }
  .rhode-sel-{{ sid }} .rsel-circle {
    width: 44px;
    height: 44px;
    font-size: 11px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .rhode-sel-{{ sid }} .rsel-card,
  .rhode-sel-{{ sid }} .rsel-circle,
  .rhode-sel-{{ sid }} .rsel-circle-label { transition: none; }
}
</style>

<div class="rhode-sel-{{ sid }}">
  <div class="rsel-inner">

    <!-- LEFT -->
    <div class="rsel-left">
      {%- if section.settings.editorial_text != blank -%}
        <p class="rsel-editorial">{{ section.settings.editorial_text }}</p>
      {%- endif -%}

      <!-- Product card area -->
      <div class="rsel-card-area">
        {%- for block in section.blocks -%}
          <div class="rsel-card{% if forloop.first %} is-active{% endif %}" data-rsel-card="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.swatch_image != blank -%}
              <img class="rsel-swatch" src="{{ block.settings.swatch_image | image_url: width: 400 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- elsif block.settings.swatch_url != blank -%}
              <img class="rsel-swatch" src="{{ block.settings.swatch_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- endif -%}
            {%- if block.settings.name != blank -%}
              <p class="rsel-name">{{ block.settings.name }}</p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="rsel-desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <!-- Numbered circles -->
      <div class="rsel-circles" role="tablist" aria-label="Select product">
        {%- for block in section.blocks -%}
          {%- assign num = forloop.index | prepend: '0' | slice: -2, 2 -%}
          <div class="rsel-circle-wrap{% if forloop.first %} is-active{% endif %}" data-rsel-wrap="{{ forloop.index0 }}">
            <button
              class="rsel-circle{% if forloop.first %} is-active{% endif %}"
              data-rsel-btn="{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ block.settings.name | escape }}"
            >{{ num }}</button>
            <span class="rsel-circle-label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- RIGHT: static hero image -->
    <div class="rsel-right">
      {%- if section.settings.hero_image != blank -%}
        <img
          src="{{ section.settings.hero_image | image_url: width: 900 }}"
          alt="{{ section.settings.hero_image.alt | default: 'Product hero' | escape }}"
          loading="lazy"
          width="{{ section.settings.hero_image.width }}"
          height="{{ section.settings.hero_image.height }}"
        >
      {%- elsif section.settings.hero_image_url != blank -%}
        <img src="{{ section.settings.hero_image_url }}" alt="Product hero" loading="lazy">
      {%- else -%}
        <div style="background:#e8e6e1;position:absolute;inset:0;"></div>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
(function(){
  var root = document.querySelector('.rhode-sel-{{ sid }}');
  if (!root) return;

  var cards = Array.from(root.querySelectorAll('[data-rsel-card]'));
  var btns  = Array.from(root.querySelectorAll('[data-rsel-btn]'));
  var wraps = Array.from(root.querySelectorAll('[data-rsel-wrap]'));
  var current = 0;

  function goTo(idx) {
    cards[current].classList.remove('is-active');
    btns[current].classList.remove('is-active');
    btns[current].setAttribute('aria-selected','false');
    wraps[current].classList.remove('is-active');

    current = idx;
    cards[current].classList.add('is-active');
    btns[current].classList.add('is-active');
    btns[current].setAttribute('aria-selected','true');
    wraps[current].classList.add('is-active');
  }

  btns.forEach(function(btn, i) {
    btn.addEventListener('click', function(){ goTo(i); });
  });
})();
</script>

{% schema %}
{
  "name": "Rhode — Product Selector",
  "max_blocks": 8,
  "settings": [
    { "type": "textarea",     "id": "editorial_text",    "label": "Editorial text",       "default": "Our must-haves for a sun-kissed and luminous look." },
    { "type": "image_picker", "id": "hero_image",         "label": "Hero image (right)" },
    { "type": "text",         "id": "hero_image_url",    "label": "Hero image URL (fallback)" },
    { "type": "color",        "id": "left_bg",           "label": "Left BG",              "default": "#f1f0ed" },
    { "type": "color",        "id": "label_color",       "label": "Label / circle colour","default": "#67645e" },
    { "type": "color",        "id": "name_color",        "label": "Product name colour",  "default": "#121212" },
    { "type": "color",        "id": "desc_color",        "label": "Description colour",   "default": "#67645e" },
    { "type": "color",        "id": "active_circle_color","label": "Active circle fill",  "default": "#67645e" },
    {
      "type": "range", "id": "padding_top",
      "min": 0, "max": 160, "step": 8,
      "label": "Padding top", "default": 0
    },
    {
      "type": "range", "id": "padding_bottom",
      "min": 0, "max": 160, "step": 8,
      "label": "Padding bottom", "default": 0
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "swatch_image", "label": "Swatch / product image" },
        { "type": "text",         "id": "swatch_url",   "label": "Swatch image URL (fallback)" },
        { "type": "text",         "id": "name",         "label": "Product name",    "default": "pocket bronze" },
        { "type": "textarea",     "id": "description",  "label": "Description",     "default": "A buildable cream bronzer for a natural, long-wearing glow." },
        { "type": "text",         "id": "label",        "label": "Circle label",    "default": "BRONZE" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rhode — Product Selector",
      "blocks": [
        { "type": "product", "settings": { "name": "Pocket Bronze", "description": "A buildable cream bronzer for a natural, long-wearing glow.", "label": "BRONZE" } },
        { "type": "product", "settings": { "name": "Highlight Milk", "description": "A sheer illuminating body lotion for a radiant finish.", "label": "HIGHLIGHT" } }
      ]
    }
  ]
}
{% endschema %}
