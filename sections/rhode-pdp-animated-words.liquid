{% comment %}
  Rhode PDP — Animated Words
  Left half: full-bleed image that changes on hover.
  Right half: label + 3 large words.
  Hover fills the word colour left→right via clip-path; exit shrinks right→left.
  Image transitions with opacity + subtle scale.
{% endcomment %}
{%- assign sid = section.id -%}
<style>
.rpa-{{ sid }} {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: {{ section.settings.bg_color }};
  min-height: clamp(460px, 72vh, 840px);
  overflow: hidden;
}

/* ── Image panel ── */
.rpa-images-{{ sid }} {
  position: relative;
  overflow: hidden;
}
.rpa-img-{{ sid }} {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: scale(1.04);
  transition: opacity 0.55s ease, transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  pointer-events: none;
}
.rpa-img-{{ sid }}.rpa-active {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}
.rpa-img-{{ sid }} img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── Words panel ── */
.rpa-words-panel-{{ sid }} {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 56px clamp(36px, 5vw, 80px);
}
.rpa-section-label-{{ sid }} {
  font-family: josefin_sans_n4, 'Josefin Sans', sans-serif;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: {{ section.settings.label_color }};
  display: block;
  margin-bottom: 36px;
}
.rpa-word-{{ sid }} {
  position: relative;
  line-height: 1;
  margin-bottom: 8px;
  cursor: default;
  user-select: none;
}
.rpa-word-base-{{ sid }},
.rpa-word-fill-{{ sid }} {
  font-family: archivo_black_n4, 'Archivo Black', sans-serif;
  font-size: clamp(48px, 5.2vw, 78px);
  font-weight: 900;
  letter-spacing: -0.01em;
  line-height: 1.15;
  display: block;
}
.rpa-word-base-{{ sid }} {
  color: {{ section.settings.word_color_inactive }};
}
.rpa-word-fill-{{ sid }} {
  position: absolute;
  top: 0;
  left: 0;
  width: max-content;
  color: {{ section.settings.word_color_active }};
  clip-path: inset(0 100% 0 0);
  transition: clip-path 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  pointer-events: none;
}
.rpa-word-{{ sid }}.rpa-active .rpa-word-fill-{{ sid }} {
  clip-path: inset(0 0% 0 0);
}

@media (max-width: 749px) {
  .rpa-{{ sid }} {
    grid-template-columns: 1fr;
    min-height: 0;
  }
  .rpa-images-{{ sid }} {
    min-height: 280px;
  }
  .rpa-words-panel-{{ sid }} {
    padding: 36px 24px 40px;
  }
  .rpa-word-base-{{ sid }},
  .rpa-word-fill-{{ sid }} {
    font-size: clamp(38px, 9vw, 58px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .rpa-img-{{ sid }} { transition: none; }
  .rpa-word-fill-{{ sid }} { transition: none; }
}
</style>

<div class="rpa-{{ sid }}">
  <div class="rpa-images-{{ sid }}">
    {%- for i in (1..3) -%}
      {%- liquid
        assign img_key = 'image_' | append: i
        assign url_key = 'image_' | append: i | append: '_url'
        assign alt_key = 'word_' | append: i
        if i == 1
          assign active_cls = ' rpa-active'
        else
          assign active_cls = ''
        endif
      -%}
      <div class="rpa-img-{{ sid }}{{ active_cls }}" data-idx="{{ forloop.index0 }}">
        {%- if section.settings[img_key] != blank -%}
          <img
            src="{{ section.settings[img_key] | image_url: width: 1000 }}"
            alt="{{ section.settings[alt_key] | escape }}"
            loading="lazy"
            width="{{ section.settings[img_key].width }}"
            height="{{ section.settings[img_key].height }}"
          >
        {%- elsif section.settings[url_key] != blank -%}
          <img src="{{ section.settings[url_key] }}" alt="{{ section.settings[alt_key] | escape }}" loading="lazy">
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="rpa-words-panel-{{ sid }}">
    {%- if section.settings.label_text != blank -%}
      <span class="rpa-section-label-{{ sid }}">{{ section.settings.label_text }}</span>
    {%- endif -%}

    {%- for i in (1..3) -%}
      {%- liquid
        assign word_key = 'word_' | append: i
        if i == 1
          assign active_cls = ' rpa-active'
        else
          assign active_cls = ''
        endif
      -%}
      {%- if section.settings[word_key] != blank -%}
        <div class="rpa-word-{{ sid }}{{ active_cls }}" data-idx="{{ forloop.index0 }}">
          <span class="rpa-word-base-{{ sid }}">{{ section.settings[word_key] }}</span>
          <span class="rpa-word-fill-{{ sid }}" aria-hidden="true">{{ section.settings[word_key] }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
(function(){
  var sid   = '{{ sid }}';
  var words = Array.from(document.querySelectorAll('.rpa-word-' + sid));
  var imgs  = Array.from(document.querySelectorAll('.rpa-img-'  + sid));
  var cur   = 0;

  function activate(idx) {
    if (idx === cur) return;
    words[cur].classList.remove('rpa-active');
    imgs[cur].classList.remove('rpa-active');
    cur = idx;
    words[cur].classList.add('rpa-active');
    imgs[cur].classList.add('rpa-active');
  }

  words.forEach(function(el, i) {
    el.addEventListener('mouseenter', function() { activate(i); });
    el.addEventListener('click',      function() { activate(i); });
  });
})();
</script>

{% schema %}
{
  "name": "Rhode — Animated Words",
  "settings": [
    { "type": "text", "id": "label_text",  "label": "Section label", "default": "LEAVES SPOTS LOOKING" },
    { "type": "text", "id": "word_1",      "label": "Word 1",        "default": "smaller" },
    { "type": "text", "id": "word_2",      "label": "Word 2",        "default": "flatter" },
    { "type": "text", "id": "word_3",      "label": "Word 3",        "default": "less red" },
    { "type": "image_picker", "id": "image_1", "label": "Image — word 1" },
    { "type": "text",         "id": "image_1_url", "label": "Image 1 URL (fallback)" },
    { "type": "image_picker", "id": "image_2", "label": "Image — word 2" },
    { "type": "text",         "id": "image_2_url", "label": "Image 2 URL (fallback)" },
    { "type": "image_picker", "id": "image_3", "label": "Image — word 3" },
    { "type": "text",         "id": "image_3_url", "label": "Image 3 URL (fallback)" },
    { "type": "color", "id": "bg_color",            "label": "Background",           "default": "#f1f0ed" },
    { "type": "color", "id": "word_color_inactive", "label": "Inactive word colour", "default": "#8f8a85" },
    { "type": "color", "id": "word_color_active",   "label": "Active word fill colour","default": "#e8b4c8" },
    { "type": "color", "id": "label_color",         "label": "Label colour",         "default": "#67645e" }
  ],
  "presets": [
    {
      "name": "Rhode — Animated Words",
      "settings": {
        "label_text": "LEAVES SPOTS LOOKING",
        "word_1": "smaller",
        "word_2": "flatter",
        "word_3": "less red"
      }
    }
  ]
}
{% endschema %}
