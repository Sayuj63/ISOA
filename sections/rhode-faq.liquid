{{ 'rhode-faq.css' | asset_url | stylesheet_tag }}

<section
  class="rhode-faq"
  data-rhode-faq
  aria-labelledby="rhode-faq-title-{{ section.id }}"
>
  <div class="rhode-faq__inner">
    <aside class="rhode-faq__nav" data-rhode-faq-nav>
      <h2 class="rhode-faq__title" id="rhode-faq-title-{{ section.id }}">
        {{ section.settings.heading | default: 'FAQ' }}
      </h2>

      <ul class="rhode-faq__cat-list" role="tablist" aria-orientation="vertical">
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            {%- assign slug = block.settings.name | handleize -%}
            {%- if slug == blank -%}{%- assign slug = 'cat-' | append: forloop.index -%}{%- endif -%}
            <li>
              <button
                type="button"
                class="rhode-faq__cat-btn{% if forloop.first %} is-active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="rhode-faq-panel-{{ section.id }}-{{ slug }}"
                id="rhode-faq-tab-{{ section.id }}-{{ slug }}"
                data-cat="{{ slug }}"
              >
                {{ block.settings.name }}
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </aside>

    <div class="rhode-faq__content">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- assign slug = block.settings.name | handleize -%}
          {%- if slug == blank -%}{%- assign slug = 'cat-' | append: forloop.index -%}{%- endif -%}
          <div
            class="rhode-faq__panel{% if forloop.first %} is-active{% endif %}"
            id="rhode-faq-panel-{{ section.id }}-{{ slug }}"
            data-panel="{{ slug }}"
            role="tabpanel"
            aria-labelledby="rhode-faq-tab-{{ section.id }}-{{ slug }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <h3 class="rhode-faq__panel-title">{{ block.settings.name }}</h3>

            <div class="rhode-faq__qa-list">
              {%- for i in (1..10) -%}
                {%- assign q_key = 'q' | append: i -%}
                {%- assign a_key = 'a' | append: i -%}
                {%- assign q = block.settings[q_key] -%}
                {%- assign a = block.settings[a_key] -%}
                {%- if q != blank and a != blank -%}
                  <details class="rhode-faq__item">
                    <summary class="rhode-faq__q">
                      <span class="rhode-faq__q-text">{{ q }}</span>
                      <span class="rhode-faq__q-icon" aria-hidden="true"></span>
                    </summary>
                    <div class="rhode-faq__a">{{ a | newline_to_br }}</div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    while (root && !root.matches('[data-rhode-faq]')) {
      root = root.previousElementSibling;
    }
    if (!root) return;

    var buttons = root.querySelectorAll('.rhode-faq__cat-btn');
    var panels = root.querySelectorAll('.rhode-faq__panel');

    function activate(slug, pushHash) {
      var matched = false;
      buttons.forEach(function (b) {
        var m = b.dataset.cat === slug;
        b.classList.toggle('is-active', m);
        b.setAttribute('aria-selected', m ? 'true' : 'false');
        if (m) matched = true;
      });
      if (!matched) return;
      panels.forEach(function (p) {
        var m = p.dataset.panel === slug;
        p.classList.toggle('is-active', m);
        if (m) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
      if (pushHash) {
        history.replaceState(null, '', '#' + slug);
      }
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        activate(btn.dataset.cat, true);
      });
    });

    var hash = (window.location.hash || '').replace('#', '');
    if (hash) activate(hash, false);
  })();
</script>

{% schema %}
{
  "name": "Rhode FAQ",
  "tag": "section",
  "class": "rhode-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "name", "label": "Category name", "default": "Category" },
        { "type": "text", "id": "q1", "label": "Q1" },
        { "type": "textarea", "id": "a1", "label": "A1" },
        { "type": "text", "id": "q2", "label": "Q2" },
        { "type": "textarea", "id": "a2", "label": "A2" },
        { "type": "text", "id": "q3", "label": "Q3" },
        { "type": "textarea", "id": "a3", "label": "A3" },
        { "type": "text", "id": "q4", "label": "Q4" },
        { "type": "textarea", "id": "a4", "label": "A4" },
        { "type": "text", "id": "q5", "label": "Q5" },
        { "type": "textarea", "id": "a5", "label": "A5" },
        { "type": "text", "id": "q6", "label": "Q6" },
        { "type": "textarea", "id": "a6", "label": "A6" },
        { "type": "text", "id": "q7", "label": "Q7" },
        { "type": "textarea", "id": "a7", "label": "A7" },
        { "type": "text", "id": "q8", "label": "Q8" },
        { "type": "textarea", "id": "a8", "label": "A8" },
        { "type": "text", "id": "q9", "label": "Q9" },
        { "type": "textarea", "id": "a9", "label": "A9" },
        { "type": "text", "id": "q10", "label": "Q10" },
        { "type": "textarea", "id": "a10", "label": "A10" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Rhode FAQ",
      "blocks": [
        { "type": "category", "settings": { "name": "PRODUCTS" } },
        { "type": "category", "settings": { "name": "SHIPPING" } },
        { "type": "category", "settings": { "name": "ORDERS & PAYMENT" } },
        { "type": "category", "settings": { "name": "RETURNS & REFUNDS" } },
        { "type": "category", "settings": { "name": "CONTACT US" } }
      ]
    }
  ]
}
{% endschema %}
