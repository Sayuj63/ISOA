            </div>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  function initSlider5() {
    document.querySelector('.slider-slider-{{ section.id }}').classList.remove('preview');
    const slider = new Swiper(".slider-slider-{{ section.id }}", {
      speed: 300,
      spaceBetween: 20,
      navigation: {
        nextEl: '.slider-btn-next-{{ section.id }}',
        prevEl: '.slider-btn-prev-{{ section.id }}',
      },
      pagination: {
        el: '.slider-pagination-{{ section.id }}',
        type: 'progressbar',
      },
      breakpoints: {
        320: {
          spaceBetween: {{ slider_gap_mobile }},
          slidesPerView: {{ slider_view_mobile }}
        },
        768: {
          spaceBetween: {{ slider_gap_mobile }},
          slidesPerView: {{ slider_view | times: 0.5 | round: 0 }}
        },
        1024: {
          spaceBetween: {{ slider_gap }},
          slidesPerView: {{ slider_view }}
        }
      }
    });

    document.querySelectorAll('.slider-button-{{ section.id }}').forEach(function(btn) {
      function getDir(e) {
        var r = btn.getBoundingClientRect();
        var x = e.clientX - r.left, y = e.clientY - r.top;
        var d = [['top', y], ['bottom', r.height - y], ['left', x], ['right', r.width - x]];
        return d.reduce(function(a, b) { return a[1] < b[1] ? a : b; })[0];
      }
      btn.addEventListener('mouseenter', function(e) { btn.setAttribute('data-dir', getDir(e)); });
      btn.addEventListener('mouseleave', function(e) { btn.setAttribute('data-dir', getDir(e)); });
    });
  }

  document.addEventListener('DOMContentLoaded', initSlider5);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initSlider5);
     document.addEventListener('shopify:section:load', initSlider5);
  }
</script>

