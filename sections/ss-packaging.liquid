{% schema %}
{
  "name": "Packaging",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },

    {
      "type": "range",
      "id": "section_width",
      "min": 80,
      "max": 160,
      "step": 2,
      "unit": "rem",
      "label": "Section Width",
      "default": 120
    },

    {
      "type": "range",
      "id": "section_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Section Radius",
      "default": 16
    },

    {
      "type": "range",
      "id": "section_border",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Section Border",
      "default": 0
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    },

    {
      "type": "range",
      "id": "padding_side",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Side",
      "default": 24
    },

    {
      "type": "range",
      "id": "padding_side_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding Side Mobile",
      "default": 16
    },

    {
      "type": "range",
      "id": "content_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Content Gap",
      "default": 40
    },

    {
      "type": "range",
      "id": "content_gap_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Content Gap Mobile",
      "default": 20
    },

    {
      "type": "range",
      "id": "side_width",
      "min": 60,
      "max": 180,
      "step": 2,
      "unit": "px",
      "label": "Vertical Label Width",
      "default": 88
    },

    {
      "type": "range",
      "id": "side_width_mobile",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Vertical Label Width Mobile",
      "default": 64
    },

    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Radius",
      "default": 14
    },

    {
      "type": "range",
      "id": "image_height",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Image Height Desktop",
      "default": 680
    },

    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Image Height Mobile",
      "default": 320
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ready-to-wear skincare"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Learn more about the materials of Spotwear."
    },

    {
      "type": "text",
      "id": "material_1_title",
      "label": "Material 1 Title",
      "default": "Spot Stickers"
    },

    {
      "type": "text",
      "id": "material_1_text",
      "label": "Material 1 Text",
      "default": "Made of 100% Hydrocolloid"
    },

    {
      "type": "text",
      "id": "material_2_title",
      "label": "Material 2 Title",
      "default": "Pouch"
    },

    {
      "type": "text",
      "id": "material_2_text",
      "label": "Material 2 Text",
      "default": "Aluminum"
    },

    {
      "type": "text",
      "id": "vertical_text",
      "label": "Vertical Text",
      "default": "packaging"
    },

    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },

    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Heading Size Mobile",
      "default": 28
    },

    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },

    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size Mobile",
      "default": 14
    },

    {
      "type": "range",
      "id": "vertical_text_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Vertical Text Size",
      "default": 30
    },

    {
      "type": "range",
      "id": "vertical_text_size_mobile",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical Text Size Mobile",
      "default": 20
    },

    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#ECEAE7"
    },

    {
      "type": "color",
      "id": "side_bg",
      "label": "Vertical Label Background",
      "default": "#918D87"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#67645E"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    }
  ],

  "presets": [
    {
      "name": "Packaging"
    }
  ]
}
{% endschema %}

<section class="packaging-{{ section.id }}">
  <div class="packaging-wrapper">

    <div class="packaging-content">

      <div class="packaging-left">
        <h2>{{ section.settings.heading }}</h2>

        <div class="packaging-description">
          {{ section.settings.description }}
        </div>

        <div class="packaging-material">
          <h4>{{ section.settings.material_1_title }}</h4>
          <p>{{ section.settings.material_1_text }}</p>
        </div>

        <div class="packaging-material">
          <h4>{{ section.settings.material_2_title }}</h4>
          <p>{{ section.settings.material_2_text }}</p>
        </div>
      </div>

      <div class="packaging-right">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1600 }}"
            alt=""
            loading="lazy"
          >
        {% endif %}
      </div>

    </div>

    <div class="packaging-side-text">
      <span>{{ section.settings.vertical_text }}</span>
    </div>

  </div>
</section>

<style>
.packaging-{{ section.id }}{
  width:100%;
  padding-top:{{ section.settings.padding_top }}px;
  padding-bottom:{{ section.settings.padding_bottom }}px;
  padding-left:{{ section.settings.padding_side }}px;
  padding-right:{{ section.settings.padding_side }}px;
  background:#fff;
  box-sizing:border-box;
}

.packaging-{{ section.id }} *{
  box-sizing:border-box;
}

.packaging-{{ section.id }} .packaging-wrapper{
  width:100%;
  max-width:{{ section.settings.section_width }}rem;
  margin:0 auto;
  background:{{ section.settings.section_bg }};
  border-radius:{{ section.settings.section_radius }}px;
  border:{{ section.settings.section_border }}px solid {{ section.settings.border_color }};
  overflow:hidden;
  display:flex;
}

.packaging-{{ section.id }} .packaging-content{
  flex:1;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:{{ section.settings.content_gap }}px;
  align-items:center;
  padding:48px;
}

.packaging-{{ section.id }} .packaging-left{
  width:100%;
}

.packaging-{{ section.id }} h2{
  margin:0;
  color:{{ section.settings.text_color }};
  font-size:{{ section.settings.heading_size }}px;
  line-height:1;
  font-weight:700;
}

.packaging-{{ section.id }} .packaging-description{
  margin-top:28px;
  color:{{ section.settings.text_color }};
  font-size:{{ section.settings.text_size }}px;
  line-height:1.6;
  max-width:520px;
}

.packaging-{{ section.id }} .packaging-material{
  margin-top:34px;
}

.packaging-{{ section.id }} .packaging-material h4{
  margin:0 0 10px;
  color:{{ section.settings.text_color }};
  font-size:{{ section.settings.text_size }}px;
  line-height:1.3;
  font-weight:700;
}

.packaging-{{ section.id }} .packaging-material p{
  margin:0;
  color:{{ section.settings.text_color }};
  font-size:{{ section.settings.text_size }}px;
  line-height:1.5;
}

.packaging-{{ section.id }} .packaging-right{
  width:100%;
  height:{{ section.settings.image_height }}px;
  background:#F7F7F7;
  border-radius:{{ section.settings.image_radius }}px;
  overflow:hidden;
  display:flex;
  align-items:center;
  justify-content:center;
}

.packaging-{{ section.id }} .packaging-right img{
  width:100%;
  height:100%;
  object-fit:contain;
  display:block;
}

.packaging-{{ section.id }} .packaging-side-text{
  width:{{ section.settings.side_width }}px;
  background:{{ section.settings.side_bg }};
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}

.packaging-{{ section.id }} .packaging-side-text span{
  writing-mode:vertical-rl;
  transform:rotate(180deg);
  color:#fff;
  font-size:{{ section.settings.vertical_text_size }}px;
  line-height:1;
  font-weight:700;
  text-transform:lowercase;
}

@media screen and (max-width: 989px){

  .packaging-{{ section.id }}{
    padding-left:{{ section.settings.padding_side_mobile }}px;
    padding-right:{{ section.settings.padding_side_mobile }}px;
  }

  .packaging-{{ section.id }} .packaging-wrapper{
    flex-direction:column;
  }

  .packaging-{{ section.id }} .packaging-content{
    grid-template-columns:1fr;
    gap:{{ section.settings.content_gap_mobile }}px;
    padding:24px;
  }

  .packaging-{{ section.id }} h2{
    font-size:{{ section.settings.heading_size_mobile }}px;
  }

  .packaging-{{ section.id }} .packaging-description,
  .packaging-{{ section.id }} .packaging-material h4,
  .packaging-{{ section.id }} .packaging-material p{
    font-size:{{ section.settings.text_size_mobile }}px;
  }

  .packaging-{{ section.id }} .packaging-description{
    margin-top:18px;
  }

  .packaging-{{ section.id }} .packaging-material{
    margin-top:24px;
  }

  .packaging-{{ section.id }} .packaging-right{
    height:{{ section.settings.image_height_mobile }}px;
  }

  .packaging-{{ section.id }} .packaging-side-text{
    width:100%;
    height:{{ section.settings.side_width_mobile }}px;
  }

  .packaging-{{ section.id }} .packaging-side-text span{
    writing-mode:initial;
    transform:none;
    font-size:{{ section.settings.vertical_text_size_mobile }}px;
  }
}
</style>