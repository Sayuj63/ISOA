{% doc %}
  Rhode-style right-side cart drawer.

  The header's cart icon opens this instead of navigating to /cart, on every
  template except the cart page itself (where the page is the cart).

  Rows are rendered here rather than through `snippets/cart-products.liquid`
  because that snippet emits `id="cart-form"` / `id="checkout"`, which would
  collide with the cart page's own copy on /cart. The row hooks the JS needs
  (`cart-items-component[data-section-id]`, `ref="cartItemRows[]"`,
  `ref="quantitySelectors[]"`) are mirrored from it, so quantity changes behave
  the same.

  There is deliberately no remove button — the reference drawer has none; its
  minus control deletes the line once quantity is 1. See the `data-drawer`
  branch in assets/component-cart-quantity-selector.js.

  Reference: rhodeskin.com `.Offcanvas--right .CartDrawer`, measured 2026-09-17.

  The <dialog> carries `dialog-drawer` but NOT `dialog-modal` — see the note in
  isoa-search-drawer.liquid for why.
{% enddoc %}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  <script
    src="{{ 'dialog.js' | asset_url }}"
    type="module"
  ></script>
  <script
    src="{{ 'cart-drawer.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'component-cart-items.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'component-cart-quantity-selector.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  {%- liquid
    # cart.total_price is in subunits (paise), so the threshold converts up.
    assign fs_threshold = settings.cart_free_shipping_threshold | times: 100
    assign fs_enabled = false
    if settings.cart_free_shipping_enabled and fs_threshold > 0
      assign fs_enabled = true
      assign fs_remaining = fs_threshold | minus: cart.total_price
      assign fs_percent = cart.total_price | times: 100 | divided_by: fs_threshold
      if fs_percent > 100
        assign fs_percent = 100
      endif
      if fs_percent < 3
        assign fs_percent = 3
      endif
    endif

    # With no product picked in the editor, fall back to the first available
    # product that is not already in the cart so the card still renders.
    assign upsell = section.settings.upsell_product
    if upsell == blank
      assign cart_variant_ids = cart.items | map: 'variant_id'
      for candidate in collections.all.products
        assign candidate_variant = candidate.selected_or_first_available_variant
        if candidate_variant != blank and cart_variant_ids contains candidate_variant.id
          continue
        endif
        assign upsell = candidate
        break
      endfor
    endif
    if upsell != blank
      assign upsell_variant = upsell.selected_or_first_available_variant
      assign upsell_variants = upsell.variants | where: 'available'
    endif
  -%}

  <cart-drawer-component
    id="isoa-cart-drawer"
    class="isoa-cd"
    {{ section.shopify_attributes }}
    {% if section.settings.auto_open %}
      auto-open
    {% endif %}
  >
    <dialog
      ref="dialog"
      class="isoa-cd__panel isoa-drawer dialog-drawer"
      scroll-lock
      aria-labelledby="isoa-cart-drawer-title"
      on:click="/closeDialogOnClickOutside"
      on:keydown="/closeDialogOnEscapePress"
    >
      <span ref="liveRegion" class="visually-hidden" role="status"></span>

      <div class="isoa-cd__inner" data-hydration-key="isoa-cd">
        <cart-items-component
          class="isoa-cd__items-component cart-items-component"
          data-drawer
          data-section-id="{{ section.id }}"
        >
          <div class="isoa-cd__head">
            <p id="isoa-cart-drawer-title" class="isoa-cd__title">
              {%- if cart.empty? -%}
                Your cart is currently empty
              {%- else -%}
                {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}
              {%- endif -%}
            </p>
            <button
              type="button"
              class="isoa-cd__close"
              aria-label="{{ 'accessibility.close' | t }}"
              on:click="/closeDialog"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>

          {%- if cart.empty? -%}
            <div class="isoa-cd__empty">
              <a class="isoa-cd__checkout" href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}">
                {{ 'actions.continue_shopping' | t }}
              </a>
            </div>
          {%- else -%}
            {%- if fs_enabled -%}
              <div class="isoa-cd__progress">
                {%- if fs_remaining > 0 -%}
                  <p class="isoa-cd__label isoa-cd__label--above">
                    add {{ fs_remaining | money }} more for {{ settings.cart_free_shipping_label | default: 'FREE shipping' }}
                  </p>
                {%- else -%}
                  <p class="isoa-cd__label isoa-cd__label--above">
                    Free standard shipping unlocked
                  </p>
                {%- endif -%}

                <div
                  class="isoa-cd__track"
                  role="progressbar"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="{{ fs_percent }}"
                >
                  <div class="isoa-cd__fill" style="width: {{ fs_percent }}%;"></div>
                </div>

                {%- if fs_remaining > 0 -%}
                  <p class="isoa-cd__label isoa-cd__label--below">
                    add {{ fs_remaining | money }} more for {{ settings.cart_free_shipping_label | default: 'FREE shipping' }}
                  </p>
                {%- else -%}
                  <p class="isoa-cd__label isoa-cd__label--below">
                    Free standard shipping unlocked
                  </p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <ul class="isoa-cd__items" role="list">
              {%- for item in cart.items -%}
                {%- liquid
                  assign can_update_quantity = item.instructions.can_update_quantity | default: true, allow_false: true
                -%}
                <li
                  class="isoa-cd__item"
                  ref="cartItemRows[]"
                  data-parent-key="{{ item.parent_relationship.parent.key }}"
                  data-key="{{ item.key }}"
                >
                  <div class="isoa-cd__item-image">
                    <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                      {%- if item.image != blank -%}
                        {{
                          item.image
                          | image_url: width: 224
                          | image_tag: loading: 'lazy', widths: '148, 224'
                        }}
                      {%- endif -%}
                    </a>
                  </div>

                  <div class="isoa-cd__item-info">
                    <div class="isoa-cd__item-head">
                      <a class="isoa-cd__item-title" href="{{ item.url }}">{{ item.product.title }}</a>
                      <text-component class="isoa-cd__item-price" value="{{ item.final_line_price | money | strip_html }}">
                        {{- item.final_line_price | money -}}
                      </text-component>
                    </div>

                    {%- unless item.variant.title contains 'Default Title' -%}
                      <div class="isoa-cd__item-variant">{{ item.variant.title }}</div>
                    {%- endunless -%}

                    <div class="isoa-cd__item-actions">
                      <div class="isoa-cd__qty">
                        {% render 'quantity-selector',
                          product: item.product,
                          variant: item.variant,
                          in_cart_quantity: item.quantity,
                          line_index: item.index,
                          can_update_quantity: can_update_quantity
                        %}
                      </div>
                    </div>

                    <div
                      class="isoa-cd__error hidden"
                      ref="cartItemErrorContainer-{{ item.index | plus: 1 }}"
                    >
                      <small ref="cartItemError-{{ item.index | plus: 1 }}"></small>
                    </div>
                  </div>
                </li>
              {%- endfor -%}
            </ul>

            <div class="isoa-cd__foot">
              {%- if upsell != blank -%}
                <p class="isoa-cd__upsell-title">
                  {{ section.settings.upsell_title | default: 'Complete your rhode' }}
                  <strong>{{ section.settings.upsell_emphasis | default: 'ROUTINE' }}</strong>
                </p>

                <form class="isoa-cd__upsell" action="{{ routes.cart_add_url }}" method="post">
                  <input type="hidden" name="form_type" value="product">
                  <input type="hidden" name="utf8" value="✓">
                  <a class="isoa-cd__upsell-image" href="{{ upsell.url }}" tabindex="-1" aria-hidden="true">
                    {%- if upsell.featured_image != blank -%}
                      {{
                        upsell.featured_image
                        | image_url: width: 224
                        | image_tag: loading: 'lazy', widths: '148, 224'
                      }}
                    {%- endif -%}
                  </a>
                  <div class="isoa-cd__upsell-info">
                    <div class="isoa-cd__upsell-detail">
                      <div class="isoa-cd__upsell-name">{{ upsell.title }}</div>
                      {%- if upsell_variants.size > 1 -%}
                        <label class="visually-hidden" for="isoa-cd-upsell-variant">
                          {{ 'content.variant' | t | default: 'Variant' }}
                        </label>
                        <select id="isoa-cd-upsell-variant" name="id" class="isoa-cd__upsell-select">
                          {%- for variant in upsell_variants -%}
                            <option value="{{ variant.id }}" {% if variant.id == upsell_variant.id %}selected{% endif %}>
                              {{ variant.title }}
                            </option>
                          {%- endfor -%}
                        </select>
                      {%- else -%}
                        <input type="hidden" name="id" value="{{ upsell_variant.id }}">
                      {%- endif -%}
                    </div>
                    <button
                      type="submit"
                      class="isoa-cd__add"
                      {% unless upsell_variant.available %}disabled{% endunless %}
                    >
                      Add - {{ upsell_variant.price | money }}
                    </button>
                  </div>
                </form>
              {%- endif -%}

              <div class="isoa-cd__summary">
                <span class="isoa-cd__summary-label">{{ 'content.cart_subtotal' | t }}</span>
                <span class="isoa-cd__summary-value">{{ cart.total_price | money }}</span>
              </div>
              <p class="isoa-cd__tax-note">
                *shipping, taxes, and discounts calculated at checkout.
              </p>

              <form action="{{ routes.cart_url }}" method="post">
                <button type="submit" name="checkout" class="isoa-cd__checkout">
                  Checkout
                </button>
              </form>
            </div>
          {%- endif -%}
        </cart-items-component>
      </div>
    </dialog>
  </cart-drawer-component>
{%- endif -%}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_open",
      "label": "Open when a product is added",
      "default": true
    },
    {
      "type": "header",
      "content": "Upsell"
    },
    {
      "type": "product",
      "id": "upsell_product",
      "label": "Upsell product"
    },
    {
      "type": "text",
      "id": "upsell_title",
      "label": "Upsell heading",
      "default": "Complete your rhode"
    },
    {
      "type": "text",
      "id": "upsell_emphasis",
      "label": "Upsell heading emphasis",
      "default": "ROUTINE"
    }
  ],
  "presets": []
}
{% endschema %}
